---
import { t } from "@lib/i18n";
import { FEATURED_SPEAKERS } from "@config/speakers.config";

interface Props {
  speakers: typeof FEATURED_SPEAKERS;
  viewAllHref?: string;
}

const { speakers: featuredSpeakers, viewAllHref = "#" } = Astro.props;

const accentStyles: Record<string, { blob: string; badge: string; ring: string }> = {
  blue: {
    blob: "bg-blue-600",
    badge: "bg-blue-600",
    ring: "group-hover:ring-blue-600/40",
  },
  green: {
    blob: "bg-green-600",
    badge: "bg-green-600",
    ring: "group-hover:ring-green-600/40",
  },
  red: {
    blob: "bg-red-600",
    badge: "bg-red-600",
    ring: "group-hover:ring-red-600/40",
  },
  gold: {
    blob: "bg-amber-500",
    badge: "bg-amber-500",
    ring: "group-hover:ring-amber-500/40",
  },
};
---

<section
  id="speakers"
  class="relative py-20 sm:py-24 bg-white overflow-hidden"
  aria-label="Featured speakers"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div
      class="animate-fade-in-up flex flex-col gap-6 mb-16"
    >
      <div class="max-w-xl">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">
          SPEAKERS
        </span>
        <div class="flex items-center gap-6 flex-wrap sm:flex-nowrap">
          <h2 class="mt-2 text-4xl sm:text-5xl font-bold text-slate-900 whitespace-nowrap" data-i18n="speakers.title">
            {t('en', 'speakers.title')}
          </h2>
          <div id="speakersAnimation" class="w-24 h-24 sm:w-40 sm:h-40 flex-shrink-0"></div>
        </div>
        <p class="text-slate-600 leading-relaxed" data-i18n="speakers.subtitle">
          {t('en', 'speakers.subtitle')}
        </p>
      </div>
    </div>

    <!-- Featured Speakers Grid (First 4) -->
    <div id="speakersGrid" class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-14 animate-stagger">
      {
        featuredSpeakers.slice(0, 4).map((speaker, index) => {
          const accent = accentStyles[speaker.accentColor];
          return (
            <div
              class="group flex flex-col items-center text-center animate-fade-in-up"
              style={`animation-delay: ${index * 0.1}s;`}
              data-speaker-name={speaker.name}
              data-speaker-role={speaker.role}
              data-speaker-company={speaker.company}
              data-speaker-bio={speaker.bio || ''}
              data-speaker-linkedin={speaker.linkedinUrl || ''}
              data-speaker-image={speaker.imageUrl}
              data-speaker-alt={speaker.imageAlt}
            >
              <!-- Avatar with decorative color blob -->
              <div class="relative w-32 h-32 sm:w-40 sm:h-40 mb-5">
                <div
                  class:list={[
                    "blob-shape absolute inset-0 scale-105 transition-transform duration-300 group-hover:scale-110",
                    accent.blob,
                  ]}
                  style={`animation-delay: ${index * 700}ms;`}
                  aria-hidden="true"
                />
                <img
                  src={speaker.imageUrl}
                  alt={speaker.imageAlt}
                  class:list={[
                    "speaker-image relative w-full h-full rounded-full object-cover ring-4 ring-white shadow-lg hover:shadow-xl transition-all duration-300 group-hover:scale-110 cursor-pointer",
                    accent.ring,
                  ]}
                  loading="lazy"
                  data-speaker-name={speaker.name}
                  data-speaker-role={speaker.role}
                  data-speaker-company={speaker.company}
                  data-speaker-bio={speaker.bio || ''}
                  data-speaker-linkedin={speaker.linkedinUrl || ''}
                  data-speaker-image={speaker.imageUrl}
                  data-speaker-alt={speaker.imageAlt}
                />
                
                <!-- LinkedIn Icon Badge (if LinkedIn URL exists) -->
                {speaker.linkedinUrl && (
                  <a
                    href={speaker.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute -bottom-2 -right-2 w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-700 transition-colors flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110"
                    title="Visit LinkedIn profile"
                  >
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.438-.103.249-.129.597-.129.946v5.421h-3.554s.045-8.789 0-9.514h3.554v1.348c.421-.649 1.175-1.573 2.853-1.573 2.08 0 3.641 1.36 3.641 4.28v5.459zM5.337 9.433c-1.144 0-1.915-.759-1.915-1.708 0-.955.77-1.708 1.963-1.708 1.192 0 1.914.753 1.939 1.708 0 .949-.747 1.708-1.987 1.708zm1.582 10.019H3.755V9.938h3.164v9.514zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
                    </svg>
                  </a>
                )}
              </div>

              <!-- Speaker Info -->
              <h3
                class="text-base sm:text-lg font-semibold text-slate-900"
                data-i18n="speakers.speakerName"
              >
                {speaker.name}
              </h3>
              <p class="text-sm text-slate-600 mt-1">
                {speaker.company}
              </p>
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">
                {speaker.role}
              </p>
              
              <!-- BIO Button -->
              <div class="flex gap-2 mt-3">
                <button
                  class="speaker-bio-btn inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors"
                  data-speaker-name={speaker.name}
                  data-speaker-role={speaker.role}
                  data-speaker-company={speaker.company}
                  data-speaker-bio={speaker.bio || ''}
                  data-speaker-linkedin={speaker.linkedinUrl || ''}
                  data-speaker-image={speaker.imageUrl}
                  data-speaker-alt={speaker.imageAlt}
                >
                  BIO
                </button>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- View All Speakers Button -->
    <div class="flex justify-center mt-12 mb-12">
      <button
        id="viewAllSpeakersBtn"
        class="group/link inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors whitespace-nowrap"
        data-i18n="speakers.viewAll"
      >
        {t('en', 'speakers.viewAll')}
        <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:translate-x-1.5">→</span>
      </button>
    </div>

    <!-- Additional Speakers Grid (Hidden by default, shows after View All clicked) -->
    <div id="additionalSpeakersContainer" class="hidden">
      <div id="additionalSpeakersGrid" class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-14 animate-stagger mb-12">
        {
          featuredSpeakers.slice(4).map((speaker, index) => {
            const accent = accentStyles[speaker.accentColor];
            return (
              <div
                class="group flex flex-col items-center text-center animate-fade-in-up"
                style={`animation-delay: ${index * 0.1}s;`}
                data-speaker-name={speaker.name}
                data-speaker-role={speaker.role}
                data-speaker-company={speaker.company}
                data-speaker-bio={speaker.bio || ''}
                data-speaker-linkedin={speaker.linkedinUrl || ''}
                data-speaker-image={speaker.imageUrl}
                data-speaker-alt={speaker.imageAlt}
              >
                <!-- Avatar with decorative color blob -->
                <div class="relative w-32 h-32 sm:w-40 sm:h-40 mb-5">
                  <div
                    class:list={[
                      "blob-shape absolute inset-0 scale-105 transition-transform duration-300 group-hover:scale-110",
                      accent.blob,
                    ]}
                    style={`animation-delay: ${index * 700}ms;`}
                    aria-hidden="true"
                  />
                  <img
                    src={speaker.imageUrl}
                    alt={speaker.imageAlt}
                    class:list={[
                      "speaker-image relative w-full h-full rounded-full object-cover ring-4 ring-white shadow-lg hover:shadow-xl transition-all duration-300 group-hover:scale-110 cursor-pointer",
                      accent.ring,
                    ]}
                    loading="eager"
                    data-speaker-name={speaker.name}
                    data-speaker-role={speaker.role}
                    data-speaker-company={speaker.company}
                    data-speaker-bio={speaker.bio || ''}
                    data-speaker-linkedin={speaker.linkedinUrl || ''}
                    data-speaker-image={speaker.imageUrl}
                    data-speaker-alt={speaker.imageAlt}
                  />

                  <!-- LinkedIn Icon Badge (if LinkedIn URL exists) -->
                  {speaker.linkedinUrl && (
                    <a
                      href={speaker.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="absolute -bottom-2 -right-2 w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-700 transition-colors flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110"
                      title="Visit LinkedIn profile"
                    >
                      <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.438-.103.249-.129.597-.129.946v5.421h-3.554s.045-8.789 0-9.514h3.554v1.348c.421-.649 1.175-1.573 2.853-1.573 2.08 0 3.641 1.36 3.641 4.28v5.459zM5.337 9.433c-1.144 0-1.915-.759-1.915-1.708 0-.955.77-1.708 1.963-1.708 1.192 0 1.914.753 1.939 1.708 0 .949-.747 1.708-1.987 1.708zm1.582 10.019H3.755V9.938h3.164v9.514zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
                      </svg>
                    </a>
                  )}
                </div>

                <!-- Speaker Info -->
                <h3
                  class="text-base sm:text-lg font-semibold text-slate-900"
                  data-i18n="speakers.speakerName"
                >
                  {speaker.name}
                </h3>
                <p class="text-sm text-slate-600 mt-1">
                  {speaker.company}
                </p>
                <p class="text-xs text-slate-500 mt-1 line-clamp-1">
                  {speaker.role}
                </p>

                <!-- BIO Button -->
                <div class="flex gap-2 mt-3">
                  <button
                    class="speaker-bio-btn inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors"
                    data-speaker-name={speaker.name}
                    data-speaker-role={speaker.role}
                    data-speaker-company={speaker.company}
                    data-speaker-bio={speaker.bio || ''}
                    data-speaker-linkedin={speaker.linkedinUrl || ''}
                    data-speaker-image={speaker.imageUrl}
                    data-speaker-alt={speaker.imageAlt}
                  >
                    BIO
                  </button>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Show Less button -->
      <div class="flex justify-center mt-12">
        <button
          id="collapseBtn"
          class="group/link inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors whitespace-nowrap"
        >
          Show Less
          <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:-translate-x-1.5">←</span>
        </button>
      </div>
    </div>

  </div>
</section>

<!-- Speaker Bio Modal -->
<div id="speakerModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-lg max-w-2xl w-full max-h-96 overflow-y-auto">
    <div class="p-6">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h2 id="modalSpeakerName" class="text-2xl font-bold text-slate-900"></h2>
          <p id="modalSpeakerRole" class="text-sm text-slate-600"></p>
          <p id="modalSpeakerCompany" class="text-sm text-slate-600"></p>
        </div>
        <button
          id="closeModalBtn"
          class="text-slate-500 hover:text-slate-700 text-2xl leading-none"
        >
          ×
        </button>
      </div>
      <img id="modalSpeakerImage" src="" alt="" class="w-24 h-24 rounded-full mb-4 object-cover" />
      <p id="modalSpeakerBio" class="text-slate-600 mb-4"></p>
      <a id="modalLinkedinLink" href="" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-semibold">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.438-.103.249-.129.597-.129.946v5.421h-3.554s.045-8.789 0-9.514h3.554v1.348c.421-.649 1.175-1.573 2.853-1.573 2.08 0 3.641 1.36 3.641 4.28v5.459zM5.337 9.433c-1.144 0-1.915-.759-1.915-1.708 0-.955.77-1.708 1.963-1.708 1.192 0 1.914.753 1.939 1.708 0 .949-.747 1.708-1.987 1.708zm1.582 10.019H3.755V9.938h3.164v9.514zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>
</div>

<style>
  .blob-shape {
    border-radius: 30% 70% 70% 30%;
  }

  @keyframes blob {
    0%, 100% {
      border-radius: 30% 70% 70% 30%;
    }
    25% {
      border-radius: 40% 60% 60% 40%;
    }
    50% {
      border-radius: 50% 50% 50% 50%;
    }
    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }

  .blob-shape {
    animation: blob 8s ease-in-out infinite;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes stagger {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  .animate-stagger > * {
    animation: stagger 0.6s ease-out forwards;
  }
</style>

<script>
  const modal = document.getElementById("speakerModal");
  const closeModalBtn = document.getElementById("closeModalBtn");
  const speakerImages = document.querySelectorAll(".speaker-image");
  const bioBtns = document.querySelectorAll(".speaker-bio-btn");
  const viewAllBtn = document.getElementById("viewAllSpeakersBtn");
  const collapseBtn = document.getElementById("collapseBtn");
  const additionalSpeakersContainer = document.getElementById("additionalSpeakersContainer");

  // Open modal when clicking on speaker image
  speakerImages.forEach((img) => {
    img.addEventListener("click", () => {
      const speakerName = img.getAttribute("data-speaker-name");
      const speakerRole = img.getAttribute("data-speaker-role");
      const speakerCompany = img.getAttribute("data-speaker-company");
      const speakerBio = img.getAttribute("data-speaker-bio");
      const speakerLinkedin = img.getAttribute("data-speaker-linkedin");
      const speakerImage = img.getAttribute("data-speaker-image");

      document.getElementById("modalSpeakerName")!.textContent = speakerName;
      document.getElementById("modalSpeakerRole")!.textContent = speakerRole;
      document.getElementById("modalSpeakerCompany")!.textContent = speakerCompany;
      document.getElementById("modalSpeakerBio")!.textContent = speakerBio;
      document.getElementById("modalSpeakerImage")!.src = speakerImage;

      const linkedinLink = document.getElementById("modalLinkedinLink");
      if (speakerLinkedin) {
        linkedinLink!.href = speakerLinkedin;
        linkedinLink!.style.display = "inline-flex";
      } else {
        linkedinLink!.style.display = "none";
      }

      modal!.classList.remove("hidden");
    });
  });

  // Open modal when clicking BIO button
  bioBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const speakerName = btn.getAttribute("data-speaker-name");
      const speakerRole = btn.getAttribute("data-speaker-role");
      const speakerCompany = btn.getAttribute("data-speaker-company");
      const speakerBio = btn.getAttribute("data-speaker-bio");
      const speakerLinkedin = btn.getAttribute("data-speaker-linkedin");
      const speakerImage = btn.getAttribute("data-speaker-image");

      document.getElementById("modalSpeakerName")!.textContent = speakerName;
      document.getElementById("modalSpeakerRole")!.textContent = speakerRole;
      document.getElementById("modalSpeakerCompany")!.textContent = speakerCompany;
      document.getElementById("modalSpeakerBio")!.textContent = speakerBio;
      document.getElementById("modalSpeakerImage")!.src = speakerImage;

      const linkedinLink = document.getElementById("modalLinkedinLink");
      if (speakerLinkedin) {
        linkedinLink!.href = speakerLinkedin;
        linkedinLink!.style.display = "inline-flex";
      } else {
        linkedinLink!.style.display = "none";
      }

      modal!.classList.remove("hidden");
    });
  });

  closeModalBtn?.addEventListener("click", () => {
    modal!.classList.add("hidden");
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.classList.add("hidden");
    }
  });

  viewAllBtn?.addEventListener("click", () => {
    additionalSpeakersContainer?.classList.remove("hidden");
    viewAllBtn.classList.add("hidden");
    
    // Re-attach listeners to newly added speaker images
    const newSpeakerImages = additionalSpeakersContainer?.querySelectorAll(".speaker-image");
    newSpeakerImages?.forEach((img) => {
      img.addEventListener("click", () => {
        const speakerName = img.getAttribute("data-speaker-name");
        const speakerRole = img.getAttribute("data-speaker-role");
        const speakerCompany = img.getAttribute("data-speaker-company");
        const speakerBio = img.getAttribute("data-speaker-bio");
        const speakerLinkedin = img.getAttribute("data-speaker-linkedin");
        const speakerImage = img.getAttribute("data-speaker-image");

        document.getElementById("modalSpeakerName")!.textContent = speakerName;
        document.getElementById("modalSpeakerRole")!.textContent = speakerRole;
        document.getElementById("modalSpeakerCompany")!.textContent = speakerCompany;
        document.getElementById("modalSpeakerBio")!.textContent = speakerBio;
        document.getElementById("modalSpeakerImage")!.src = speakerImage;

        const linkedinLink = document.getElementById("modalLinkedinLink");
        if (speakerLinkedin) {
          linkedinLink!.href = speakerLinkedin;
          linkedinLink!.style.display = "inline-flex";
        } else {
          linkedinLink!.style.display = "none";
        }

        modal!.classList.remove("hidden");
      });
    });
    
    // Re-attach listeners to newly added BIO buttons
    const newBioBtns = additionalSpeakersContainer?.querySelectorAll(".speaker-bio-btn");
    newBioBtns?.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const speakerName = btn.getAttribute("data-speaker-name");
        const speakerRole = btn.getAttribute("data-speaker-role");
        const speakerCompany = btn.getAttribute("data-speaker-company");
        const speakerBio = btn.getAttribute("data-speaker-bio");
        const speakerLinkedin = btn.getAttribute("data-speaker-linkedin");
        const speakerImage = btn.getAttribute("data-speaker-image");

        document.getElementById("modalSpeakerName")!.textContent = speakerName;
        document.getElementById("modalSpeakerRole")!.textContent = speakerRole;
        document.getElementById("modalSpeakerCompany")!.textContent = speakerCompany;
        document.getElementById("modalSpeakerBio")!.textContent = speakerBio;
        document.getElementById("modalSpeakerImage")!.src = speakerImage;

        const linkedinLink = document.getElementById("modalLinkedinLink");
        if (speakerLinkedin) {
          linkedinLink!.href = speakerLinkedin;
          linkedinLink!.style.display = "inline-flex";
        } else {
          linkedinLink!.style.display = "none";
        }

        modal!.classList.remove("hidden");
      });
    });
  });

  collapseBtn?.addEventListener("click", () => {
    additionalSpeakersContainer?.classList.add("hidden");
    viewAllBtn?.classList.remove("hidden");
  });

  // Draw circles animation
  const drawCircles = () => {
    const canvas = document.getElementById("speakersDivider") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    canvas.width = width;
    canvas.height = height;

    const colors = ["#3b82f6", "#ef4444", "#f59e0b", "#10b981"];
    let circleIndex = 0;

    setInterval(() => {
      ctx.clearRect(0, 0, width, height);
      const x = width / 2;
      const y = height / 2;
      const radius = 15 + (circleIndex % 3) * 5;
      ctx.fillStyle = colors[circleIndex % colors.length];
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fill();
      circleIndex++;
    }, 300);
  };

  drawCircles();
</script>

<script src="https://unpkg.com/@lottiefiles/lottie-player@latest"></script>
<script>
  // Load Lottie animation next to speakers title
  const animationContainer = document.getElementById('speakersAnimation');
  if (animationContainer) {
    const lottiePlayer = document.createElement('lottie-player');
    lottiePlayer.setAttribute('src', 'https://lottie.host/f66e8fc4-b620-437a-b679-76681e6d4556/fsgOx80vt3.json');
    lottiePlayer.setAttribute('background', 'transparent');
    lottiePlayer.setAttribute('speed', '1');
    lottiePlayer.setAttribute('loop', 'true');
    lottiePlayer.setAttribute('autoplay', 'true');
    lottiePlayer.style.width = '100%';
    lottiePlayer.style.height = '100%';
    animationContainer.appendChild(lottiePlayer);
  }
</script>
