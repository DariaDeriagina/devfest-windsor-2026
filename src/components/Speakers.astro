
---
import { t } from "@lib/i18n";
import { FEATURED_SPEAKERS } from "@config/speakers.config";

interface Props {
  speakers: typeof FEATURED_SPEAKERS;
  viewAllHref?: string;
}

const { speakers: featuredSpeakers } = Astro.props;

const keynoteSpeaker = featuredSpeakers.find(
  (speaker) => speaker.isKeynote
);

const regularSpeakers = featuredSpeakers.filter(
  (speaker) => !speaker.isKeynote
);

const accentStyles: Record<
  string,
  { blob: string; ring: string }
> = {
  blue: {
    blob: "bg-blue-600",
    ring: "group-hover:ring-blue-600/40",
  },
  green: {
    blob: "bg-green-600",
    ring: "group-hover:ring-green-600/40",
  },
  red: {
    blob: "bg-red-600",
    ring: "group-hover:ring-red-600/40",
  },
  gold: {
    blob: "bg-amber-500",
    ring: "group-hover:ring-amber-500/40",
  },
};

const speakerGroups = [
  {
    id: "keynoteSpeakersGrid",
    isKeynote: true,
    isAdditional: false,
    speakers: keynoteSpeaker ? [keynoteSpeaker] : [],
  },
  {
    id: "speakersGrid",
    isKeynote: false,
    isAdditional: false,
    speakers: regularSpeakers.slice(0, 4),
  },
  {
    id: "additionalSpeakersGrid",
    isKeynote: false,
    isAdditional: true,
    speakers: regularSpeakers.slice(4),
  },
];

const linkedinPath =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.438-.103.249-.129.597-.129.946v5.421h-3.554s.045-8.789 0-9.514h3.554v1.348c.421-.649 1.175-1.573 2.853-1.573 2.08 0 3.641 1.36 3.641 4.28v5.459zM5.337 9.433c-1.144 0-1.915-.759-1.915-1.708 0-.955.77-1.708 1.963-1.708 1.192 0 1.914.753 1.939 1.708 0 .949-.747 1.708-1.987 1.708zm1.582 10.019H3.755V9.938h3.164v9.514zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z";
---

<section
  id="speakers"
  class="relative bg-white py-12 sm:py-20 overflow-hidden"
  aria-label="Featured speakers"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- SECTION HEADER -->
    <div class="text-left mb-12 sm:mb-16">
      <span
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
      >
        SPEAKERS
      </span>

      <div
        class="speakers-color-lines"
        aria-hidden="true"
      >
        <span class="bg-blue-600"></span>
        <span class="bg-red-600"></span>
        <span class="bg-yellow-400"></span>
        <span class="bg-green-600"></span>
      </div>

      <div class="speakers-heading-row">
        <h2
          class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight"
          data-i18n="speakers.title"
        >
          {t("en", "speakers.title")}
        </h2>

        <div
          id="speakersAnimation"
          class="speakers-animation"
          aria-hidden="true"
        ></div>
      </div>
    </div>

    <!-- SPEAKER GROUPS -->
    {
      speakerGroups.map((group) => (
        <>
          {!group.isKeynote && !group.isAdditional && (
            <h3 class="text-2xl font-bold text-slate-900 mb-10 sm:mb-12">
              Featured Speakers
            </h3>
          )}

          <div
            id={
              group.isAdditional
                ? "additionalSpeakersContainer"
                : undefined
            }
            class:list={[
              group.isAdditional && "hidden",
              group.isKeynote &&
                group.speakers.length > 0 &&
                "mb-16 sm:mb-20",
            ]}
          >
            <div
              id={group.id}
              class:list={[
                "speaker-grid",
                group.isKeynote
                  ? "speaker-grid-keynote"
                  : "speaker-grid-regular",
                group.isAdditional && "mb-12",
              ]}
            >
              {group.speakers.map((speaker, index) => {
                const accent =
                  accentStyles[speaker.accentColor] ||
                  accentStyles.blue;

                return (
                  <article
                    class:list={[
                      "speaker-card group animate-fade-in-up",
                      group.isKeynote && "speaker-card-keynote",
                    ]}
                    style={`animation-delay: ${index * 0.1}s;`}
                    data-speaker-name={speaker.name}
                    data-speaker-role={speaker.role}
                    data-speaker-company={speaker.company}
                    data-speaker-bio={speaker.bio || ""}
                    data-speaker-image={speaker.imageUrl}
                    data-speaker-alt={speaker.imageAlt}
                  >
                    <!-- SPEAKER PHOTO -->
                    <button
                      type="button"
                      class:list={[
                        "speaker-image",
                        group.isKeynote && "speaker-image-keynote",
                      ]}
                      aria-label={`Read biography of ${speaker.name}`}
                      aria-haspopup="dialog"
                      aria-controls="speakerModal"
                    >
                      <span
                        class:list={[
                          "blob-shape",
                          accent.blob,
                        ]}
                        style={`animation-delay: ${index * 700}ms;`}
                        aria-hidden="true"
                      ></span>

                      <img
                        src={speaker.imageUrl}
                        alt={speaker.imageAlt}
                        class:list={[
                          "speaker-photo",
                          accent.ring,
                        ]}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>

                    <!-- SPEAKER INFORMATION -->
                    <div class="speaker-info">
                      <h3
                        class:list={[
                          "speaker-name",
                          group.isKeynote &&
                            "speaker-name-keynote",
                        ]}
                      >
                        {speaker.name}
                      </h3>

                      <p
                        class:list={[
                          "speaker-company",
                          group.isKeynote &&
                            "speaker-company-keynote",
                        ]}
                      >
                        {speaker.company}
                      </p>

                      <!-- FULL ROLE - NO TRUNCATION -->
                      <p
                        class:list={[
                          "speaker-role",
                          group.isKeynote &&
                            "speaker-role-keynote",
                        ]}
                      >
                        {speaker.role}
                      </p>
                    </div>

                    <!-- CARD ACTIONS -->
                    <div class="speaker-actions">
                      <button
                        type="button"
                        class="speaker-bio-btn"
                        aria-haspopup="dialog"
                        aria-controls="speakerModal"
                        aria-label={`Read biography of ${speaker.name}`}
                      >
                        <span class="speaker-bio-label">
                          Bio
                        </span>
                      </button>

                      {speaker.linkedinUrl && (
                        <a
                          href={speaker.linkedinUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="speaker-linkedin-btn"
                          title="LinkedIn"
                          aria-label={`${speaker.name} on LinkedIn`}
                        >
                          <svg
                            class="speaker-linkedin-icon"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path d={linkedinPath} />
                          </svg>
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>

            <!-- SHOW LESS -->
            {group.isAdditional &&
              group.speakers.length > 0 && (
                <div class="flex justify-center mt-12">
                  <button
                    id="collapseBtn"
                    type="button"
                    class="speakers-toggle inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors"
                    aria-controls="additionalSpeakersContainer"
                    aria-expanded="true"
                  >
                    <span>Show Less</span>

                    <svg
                      class="speakers-arrow speakers-arrow-back"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>
                  </button>
                </div>
              )}
          </div>

          <!-- VIEW ALL SPEAKERS -->
          {!group.isKeynote &&
            !group.isAdditional &&
            regularSpeakers.length > 4 && (
              <div
                id="viewAllSpeakersWrapper"
                class="flex justify-center mt-12 mb-12"
              >
                <button
                  id="viewAllSpeakersBtn"
                  type="button"
                  class="speakers-toggle inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors"
                  aria-controls="additionalSpeakersContainer"
                  aria-expanded="false"
                >
                  <span data-i18n="speakers.viewAll">
                    {t("en", "speakers.viewAll")}
                  </span>

                  <svg
                    class="speakers-arrow speakers-arrow-forward"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            )}
        </>
      ))
    }
  </div>

  <!-- SPEAKER BIO MODAL -->
  <dialog
    id="speakerModal"
    class="speaker-modal bg-white rounded-xl text-slate-900"
    aria-labelledby="modalSpeakerName"
  >
    <div class="speaker-modal-content">
      <div class="flex justify-between items-start gap-4 mb-5">
        <div class="min-w-0">
          <h2
            id="modalSpeakerName"
            class="text-xl sm:text-2xl font-bold text-slate-900 break-words"
          ></h2>

          <p
            id="modalSpeakerRole"
            class="text-sm text-slate-600 mt-2 break-words"
          ></p>

          <p
            id="modalSpeakerCompany"
            class="text-sm text-slate-600 mt-1 break-words"
          ></p>
        </div>

        <button
          id="closeModalBtn"
          type="button"
          class="modal-close-btn"
          aria-label="Close biography"
        >
          ×
        </button>
      </div>

      <img
        id="modalSpeakerImage"
        alt=""
        class="w-24 h-24 rounded-full mb-5 object-cover"
      />

      <p
        id="modalSpeakerBio"
        class="text-slate-600 leading-relaxed whitespace-pre-line"
      ></p>
    </div>
  </dialog>
</section>

<style>
  /* =====================================
     SECTION HEADER
  ===================================== */

  .speakers-color-lines {
    display: flex;
    gap: 0.5rem;
    width: min(100%, 24rem);
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .speakers-color-lines span {
    display: block;
    flex: 1;
    height: 0.375rem;
    border-radius: 9999px;
  }

  .speakers-heading-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .speakers-animation {
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
  }

  /* =====================================
     SPEAKER GRID
  ===================================== */

  /* Separate the first four speakers from the expanded rows. */
  #additionalSpeakersContainer:not(.hidden) {
    margin-top: 4rem;
  }

  .speaker-grid {
    width: 100%;
  }

  .speaker-grid-regular {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
    row-gap: 3.5rem;
    align-items: stretch;
  }

  .speaker-grid-keynote {
    display: flex;
    justify-content: center;
  }

  /* =====================================
     SPEAKER CARD
  ===================================== */

  .speaker-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;

    width: 100%;
    min-width: 0;
    height: 100%;

    padding: 0 0.25rem;
    box-sizing: border-box;
  }

  .speaker-card-keynote {
    max-width: 22rem;
  }

  /* =====================================
     SPEAKER PHOTO
  ===================================== */

  .speaker-image {
    position: relative;
    display: block;

    width: clamp(6.25rem, 24vw, 10rem);
    height: clamp(6.25rem, 24vw, 10rem);

    flex-shrink: 0;
    padding: 0;
    margin: 0 0 1.25rem;

    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .speaker-image-keynote {
    width: clamp(10rem, 20vw, 12rem);
    height: clamp(10rem, 20vw, 12rem);
  }

  .speaker-photo {
    position: relative;
    display: block;

    width: 100%;
    height: 100%;

    border-radius: 50%;
    object-fit: cover;

    border: 4px solid white;

    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .speaker-card:hover .speaker-photo {
    transform: scale(1.06);
    box-shadow: 0 12px 30px rgb(0 0 0 / 16%);
  }

  .blob-shape {
    position: absolute;
    inset: 0;

    transform: scale(1.05);

    border-radius: 30% 70% 70% 30%;

    animation: blob 8s ease-in-out infinite;

    transition: transform 0.3s ease;
  }

  .speaker-card:hover .blob-shape {
    transform: scale(1.1);
  }

  /* =====================================
     SPEAKER INFORMATION
  ===================================== */

  .speaker-info {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: 100%;
    min-width: 0;

    /* Takes available space so buttons align */
    flex: 1 1 auto;
  }

  .speaker-name {
    width: 100%;
    max-width: 100%;

    margin: 0;

    color: #0f172a;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;

    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;

    /* No line clamp */
    height: auto;
  }

  .speaker-name-keynote {
    font-size: 1.5rem;
  }

  .speaker-company {
    width: 100%;
    max-width: 100%;

    margin: 0.4rem 0 0;

    color: #475569;
    font-size: 0.875rem;
    line-height: 1.45;

    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;

    height: auto;
  }

  .speaker-company-keynote {
    font-size: 1rem;
  }

  /* IMPORTANT: FULL JOB TITLE */

  .speaker-role {
    display: block;

    width: 100%;
    max-width: 100%;

    margin: 0.35rem 0 0;

    color: #64748b;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;

    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;

    /* Never truncate */
    overflow: visible;
    text-overflow: clip;
    height: auto;
    max-height: none;
    min-height: 0;

    /* Prevent inherited line clamp */
    -webkit-line-clamp: unset;
    -webkit-box-orient: initial;
  }

  .speaker-role-keynote {
    font-size: 0.9375rem;
  }

  /* =====================================
     ACTION BUTTONS
  ===================================== */

  .speaker-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;

    align-items: center;
    justify-content: center;

    gap: 0.5rem;

    width: 100%;

    /* Always stays at the bottom */
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .speaker-bio-btn,
  .speaker-linkedin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 40px;
    min-height: 40px;

    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;

    background-color: white;
    color: #2563eb;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .speaker-bio-btn {
    min-width: 72px;
    padding: 0 1rem;

    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;

    cursor: pointer;
  }

  .speaker-linkedin-btn {
    width: 40px;
    min-width: 40px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .speaker-linkedin-icon {
    width: 20px;
    height: 20px;
  }

  .speaker-bio-btn:hover,
  .speaker-linkedin-btn:hover {
    background-color: #eff6ff;
    border-color: #2563eb;
  }

  .speaker-bio-btn:active,
  .speaker-linkedin-btn:active {
    background-color: #dbeafe;
  }

  /* =====================================
     TABLET / DESKTOP
  ===================================== */

  @media (min-width: 768px) {
    .speaker-grid-regular {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 3.5rem;
    }

    .speaker-card {
      padding: 0 0.375rem;
    }

    .speaker-image {
      width: clamp(8rem, 12vw, 10rem);
      height: clamp(8rem, 12vw, 10rem);
    }

    .speaker-image-keynote {
      width: 12rem;
      height: 12rem;
    }

    .speaker-actions {
      gap: 0.75rem;
    }
  }

  /* =====================================
     MOBILE
  ===================================== */

  @media (max-width: 767px) {
    #additionalSpeakersContainer:not(.hidden) {
      margin-top: 2.75rem;
    }

    .speaker-grid-regular {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.875rem;
      row-gap: 2.75rem;
    }

    .speaker-card {
      padding: 0 0.125rem;
    }

    .speaker-image {
      width: clamp(6rem, 28vw, 8.5rem);
      height: clamp(6rem, 28vw, 8.5rem);
      margin-bottom: 1rem;
    }

    .speaker-image-keynote {
      width: 10rem;
      height: 10rem;
    }

    .speaker-name {
      font-size: 0.9375rem;
      line-height: 1.35;
    }

    .speaker-name-keynote {
      font-size: 1.25rem;
    }

    .speaker-company {
      font-size: 0.8125rem;
      line-height: 1.4;
      margin-top: 0.375rem;
    }

    .speaker-role {
      font-size: 0.75rem;
      line-height: 1.45;
      margin-top: 0.375rem;
    }

    .speaker-role-keynote {
      font-size: 0.875rem;
    }

    .speaker-actions {
      gap: 0.375rem;
      padding-top: 1rem;
    }

    .speaker-bio-btn {
      min-width: 64px;
      padding: 0 0.75rem;
      font-size: 0.8125rem;
    }

    .speaker-linkedin-btn {
      width: 40px;
      min-width: 40px;
    }
  }

  /* =====================================
     VERY SMALL MOBILE
  ===================================== */

  @media (max-width: 359px) {
    .speaker-grid-regular {
      column-gap: 0.5rem;
      row-gap: 2.5rem;
    }

    .speaker-image {
      width: 5.75rem;
      height: 5.75rem;
    }

    .speaker-image-keynote {
      width: 9rem;
      height: 9rem;
    }

    .speaker-name {
      font-size: 0.875rem;
    }

    .speaker-company {
      font-size: 0.75rem;
    }

    .speaker-role {
      font-size: 0.71875rem;
      line-height: 1.45;
    }

    .speaker-actions {
      gap: 0.25rem;
    }

    .speaker-bio-btn {
      min-width: 58px;
      padding: 0 0.5rem;
    }
  }

  /* =====================================
     HEADER ANIMATION
  ===================================== */

  .speakers-animation {
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .speakers-heading-row {
      gap: 2rem;
    }

    .speakers-animation {
      width: 8rem;
      height: 8rem;
    }
  }

  /* =====================================
     VIEW ALL / SHOW LESS
  ===================================== */

  .speakers-arrow {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .speakers-toggle:hover .speakers-arrow-forward {
    transform: translateX(6px);
  }

  .speakers-toggle:hover .speakers-arrow-back {
    transform: translateX(-6px);
  }

  /* =====================================
     MODAL
  ===================================== */

  .speaker-modal {
    width: min(42rem, calc(100% - 2rem));
    max-height: 85vh;
    max-height: 85dvh;

    margin: auto;
    padding: 0;

    border: 0;
    overflow-y: auto;

    box-shadow: 0 24px 64px rgb(0 0 0 / 20%);
  }

  .speaker-modal::backdrop {
    background: rgb(0 0 0 / 50%);
  }

  .speaker-modal-content {
    padding: 1.5rem;
  }

  .modal-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 36px;
    height: 36px;

    flex-shrink: 0;

    border: 0;
    border-radius: 0.375rem;

    background: transparent;
    color: #64748b;

    font-size: 1.75rem;
    line-height: 1;

    cursor: pointer;
  }

  .modal-close-btn:hover {
    color: #0f172a;
    background: #f1f5f9;
  }

  @media (max-width: 639px) {
    .speaker-modal {
      width: calc(100% - 1.5rem);
      max-height: 88vh;
      max-height: 88dvh;
    }

    .speaker-modal-content {
      padding: 1.125rem;
    }
  }

  /* =====================================
     ANIMATIONS
  ===================================== */

  @keyframes blob {
    0%,
    100% {
      border-radius: 30% 70% 70% 30%;
    }

    25% {
      border-radius: 40% 60% 60% 40%;
    }

    50% {
      border-radius: 50%;
    }

    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out both;
  }

  /* =====================================
     ACCESSIBILITY
  ===================================== */

  button:focus-visible,
  a:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .blob-shape,
    .animate-fade-in-up {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .speakers-arrow,
    .speaker-photo,
    .speaker-bio-btn,
    .speaker-linkedin-btn {
      transition: none;
    }

    .speaker-card:hover .speaker-photo,
    .speaker-card:hover .blob-shape {
      transform: none;
    }
  }
</style>

<script>
  function initializeSpeakers() {
    const section = document.getElementById("speakers");

    if (!section || section.dataset.initialized === "true") {
      return;
    }

    section.dataset.initialized = "true";

    const modal =
      section.querySelector<HTMLDialogElement>("#speakerModal");

    const closeModalBtn =
      section.querySelector<HTMLButtonElement>("#closeModalBtn");

    const viewAllBtn =
      section.querySelector<HTMLButtonElement>(
        "#viewAllSpeakersBtn"
      );

    const viewAllWrapper =
      section.querySelector<HTMLElement>(
        "#viewAllSpeakersWrapper"
      );

    const collapseBtn =
      section.querySelector<HTMLButtonElement>("#collapseBtn");

    const additionalContainer =
      section.querySelector<HTMLElement>(
        "#additionalSpeakersContainer"
      );

    const nameElement =
      section.querySelector<HTMLElement>("#modalSpeakerName");

    const roleElement =
      section.querySelector<HTMLElement>("#modalSpeakerRole");

    const companyElement =
      section.querySelector<HTMLElement>("#modalSpeakerCompany");

    const bioElement =
      section.querySelector<HTMLElement>("#modalSpeakerBio");

    const imageElement =
      section.querySelector<HTMLImageElement>(
        "#modalSpeakerImage"
      );

    /* =====================================
       LANGUAGE SUPPORT
    ===================================== */

    function updateBioLabels() {
      const isFrench =
        document.documentElement.lang
          .toLowerCase()
          .startsWith("fr");

      const labels =
        section?.querySelectorAll<HTMLElement>(
          ".speaker-bio-label"
        );

      labels?.forEach((label) => {
        label.textContent = isFrench ? "La bio" : "Bio";
      });

      section
        ?.querySelectorAll<HTMLButtonElement>(
          ".speaker-bio-btn, .speaker-image"
        )
        .forEach((button) => {
          const card = button.closest<HTMLElement>(
            ".speaker-card"
          );

          const name = card?.dataset.speakerName || "";

          button.setAttribute(
            "aria-label",
            isFrench
              ? `Lire la biographie de ${name}`
              : `Read biography of ${name}`
          );
        });
    }

    updateBioLabels();

    const languageObserver = new MutationObserver(() => {
      updateBioLabels();
    });

    languageObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["lang"],
    });

    document.addEventListener(
      "astro:before-swap",
      () => languageObserver.disconnect(),
      { once: true }
    );

    /* =====================================
       OPEN BIO MODAL
    ===================================== */

    function openBiography(card: HTMLElement) {
      if (
        !modal ||
        !nameElement ||
        !roleElement ||
        !companyElement ||
        !bioElement ||
        !imageElement
      ) {
        return;
      }

      nameElement.textContent =
        card.dataset.speakerName || "";

      roleElement.textContent =
        card.dataset.speakerRole || "";

      companyElement.textContent =
        card.dataset.speakerCompany || "";

      const bio = card.dataset.speakerBio?.trim();

      const isFrench =
        document.documentElement.lang
          .toLowerCase()
          .startsWith("fr");

      bioElement.textContent =
        bio ||
        (isFrench
          ? "Biographie à venir."
          : "Biography coming soon.");

      imageElement.src =
        card.dataset.speakerImage ||
        "/google-person.png";

      imageElement.alt =
        card.dataset.speakerAlt ||
        card.dataset.speakerName ||
        "";

      if (!modal.open) {
        modal.showModal();
      }
    }

    /* =====================================
       SPEAKER CLICK HANDLER
    ===================================== */

    section.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const trigger = target.closest(
        ".speaker-image, .speaker-bio-btn"
      );

      if (!trigger) {
        return;
      }

      const card =
        trigger.closest<HTMLElement>(".speaker-card");

      if (card) {
        openBiography(card);
      }
    });

    /* =====================================
       CLOSE MODAL
    ===================================== */

    closeModalBtn?.addEventListener("click", () => {
      modal?.close();
    });

    modal?.addEventListener("click", (event) => {
      if (event.target !== modal) {
        return;
      }

      const bounds = modal.getBoundingClientRect();

      const clickedOutside =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;

      if (clickedOutside) {
        modal.close();
      }
    });

    /* =====================================
       VIEW ALL SPEAKERS
    ===================================== */

    viewAllBtn?.addEventListener("click", () => {
      if (!additionalContainer) {
        return;
      }

      additionalContainer.classList.remove("hidden");

      viewAllBtn.setAttribute(
        "aria-expanded",
        "true"
      );

      viewAllWrapper?.classList.add("hidden");

      const firstSpeaker =
        additionalContainer.querySelector<HTMLButtonElement>(
          ".speaker-image"
        );

      firstSpeaker?.focus({ preventScroll: true });
    });

    /* =====================================
       SHOW LESS
    ===================================== */

    collapseBtn?.addEventListener("click", () => {
      additionalContainer?.classList.add("hidden");

      viewAllWrapper?.classList.remove("hidden");

      viewAllBtn?.setAttribute(
        "aria-expanded",
        "false"
      );

      viewAllBtn?.focus({ preventScroll: true });
    });

    /* =====================================
       LOTTIE ANIMATION
    ===================================== */

    const animationContainer =
      section.querySelector<HTMLElement>(
        "#speakersAnimation"
      );

    if (
      animationContainer &&
      !animationContainer.querySelector("lottie-player")
    ) {
      const player =
        document.createElement("lottie-player");

      player.setAttribute(
        "src",
        "/animations/Marketing.json"
      );

      player.setAttribute(
        "background",
        "transparent"
      );

      player.setAttribute("speed", "1");
      player.setAttribute("loop", "");

      if (
        !window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches
      ) {
        player.setAttribute("autoplay", "");
      }

      player.style.width = "100%";
      player.style.height = "100%";

      animationContainer.appendChild(player);
    }
  }

  initializeSpeakers();

  document.addEventListener(
    "astro:page-load",
    initializeSpeakers
  );
</script>

<script
  is:inline
  src="https://unpkg.com/@lottiefiles/lottie-player@latest"
></script>
