---
import { t } from "@lib/i18n";
import { FEATURED_SPEAKERS } from "@config/speakers.config";

interface Props {
  speakers: typeof FEATURED_SPEAKERS;
  viewAllHref?: string;
}

const { speakers: featuredSpeakers, viewAllHref = "#" } = Astro.props;

const accentStyles: Record<string, { blob: string; badge: string; ring: string }> = {
  blue: {
    blob: "bg-blue-600",
    badge: "bg-blue-600",
    ring: "group-hover:ring-blue-600/40",
  },
  green: {
    blob: "bg-green-600",
    badge: "bg-green-600",
    ring: "group-hover:ring-green-600/40",
  },
  red: {
    blob: "bg-red-600",
    badge: "bg-red-600",
    ring: "group-hover:ring-red-600/40",
  },
  gold: {
    blob: "bg-amber-500",
    badge: "bg-amber-500",
    ring: "group-hover:ring-amber-500/40",
  },
};
---

<section
  id="speakers"
  class="relative py-20 sm:py-24 bg-white overflow-hidden"
  aria-label="Featured speakers"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div
      class="animate-fade-in-up flex flex-col gap-6 mb-16"
    >
      <div class="max-w-xl">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">
          SPEAKERS
        </span>
        <div class="flex items-center gap-6 flex-wrap sm:flex-nowrap">
          <h2 class="mt-2 text-4xl sm:text-5xl font-bold text-slate-900 whitespace-nowrap" data-i18n="speakers.title">
            {t('en', 'speakers.title')}
          </h2>
          <div id="speakersAnimation" class="w-24 h-24 sm:w-40 sm:h-40 flex-shrink-0"></div>
        </div>
        <p class="text-slate-600 leading-relaxed" data-i18n="speakers.subtitle">
          {t('en', 'speakers.subtitle')}
        </p>
      </div>
    </div>

    <!-- Speaker grid -->
    <div id="speakersGrid" class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-14 animate-stagger">
      {
        featuredSpeakers.map((speaker, index) => {
          const accent = accentStyles[speaker.accentColor];
          return (
            <div
              class="group flex flex-col items-center text-center animate-fade-in-up"
              style={`animation-delay: ${index * 0.1}s;`}
              data-speaker-name={speaker.name}
              data-speaker-role={speaker.role}
              data-speaker-company={speaker.company}
              data-speaker-bio={speaker.bio || ''}
              data-speaker-linkedin={speaker.linkedinUrl || ''}
              data-speaker-image={speaker.imageUrl}
              data-speaker-alt={speaker.imageAlt}
            >
              <!-- Avatar with decorative color blob -->
              <div class="relative w-32 h-32 sm:w-40 sm:h-40 mb-5">
                <div
                  class:list={[
                    "blob-shape absolute inset-0 scale-105 transition-transform duration-300 group-hover:scale-110",
                    accent.blob,
                  ]}
                  style={`animation-delay: ${index * 700}ms;`}
                  aria-hidden="true"
                />
                <img
                  src={speaker.imageUrl}
                  alt={speaker.imageAlt}
                  class:list={[
                    "relative w-full h-full rounded-full object-cover ring-4 ring-white shadow-lg hover:shadow-xl transition-all duration-300 group-hover:scale-110",
                    accent.ring,
                  ]}
                  loading="lazy"
                />
              </div>

              <!-- Speaker Info -->
              <h3
                class="text-base sm:text-lg font-semibold text-slate-900"
                data-i18n="speakers.speakerName"
              >
                {speaker.name}
              </h3>
              <p class="text-sm text-slate-600 mt-1">
                {speaker.company}
              </p>
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">
                {speaker.role}
              </p>
              
              <!-- BIO and LinkedIn Buttons -->
              <div class="flex gap-2 mt-3">
                <button
                  class="speaker-bio-btn inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors"
                  data-speaker-name={speaker.name}
                  data-speaker-role={speaker.role}
                  data-speaker-company={speaker.company}
                  data-speaker-bio={speaker.bio || ''}
                  data-speaker-linkedin={speaker.linkedinUrl || ''}
                  data-speaker-image={speaker.imageUrl}
                  data-speaker-alt={speaker.imageAlt}
                >
                  BIO
                </button>
                {speaker.linkedinUrl && (
                  <a
                    href={speaker.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-full transition-colors"
                  >
                    LinkedIn →
                  </a>
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- View All Speakers Button - Below Grid -->
    <div class="flex justify-center mt-12 mb-12">
      <button
        id="viewAllSpeakersBtn"
        class="group/link inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors whitespace-nowrap"
        data-i18n="speakers.viewAll"
      >
        {t('en', 'speakers.viewAll')}
        <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:translate-x-1.5">→</span>
      </button>
    </div>

    <!-- Custom circles divider animation -->
    <div class="flex justify-center my-12">
      <div id="speakersDivider" class="w-full max-w-sm h-20"></div>
    </div>

    <!-- Show more button (appears after View All is clicked) -->
    <div id="showMoreContainer" class="hidden text-center mt-12">
      <button
        id="collapseBtn"
        class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
      >
        Show Less ↑
      </button>
    </div>
  </div>
</section>

<!-- Speaker Bio Modal -->
<div id="speakerModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-lg max-w-2xl w-full max-h-96 overflow-y-auto">
    <div class="p-6">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h2 id="modalSpeakerName" class="text-2xl font-bold text-slate-900"></h2>
          <p id="modalSpeakerRole" class="text-sm text-slate-600"></p>
          <p id="modalSpeakerCompany" class="text-sm text-slate-600"></p>
        </div>
        <button
          id="closeModalBtn"
          class="text-slate-500 hover:text-slate-700 text-2xl leading-none"
        >
          ×
        </button>
      </div>
      <img id="modalSpeakerImage" src="" alt="" class="w-24 h-24 rounded-full mb-4 object-cover" />
      <p id="modalSpeakerBio" class="text-slate-600 mb-4"></p>
      <a id="modalLinkedinLink" href="" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-semibold">
        LinkedIn →
      </a>
    </div>
  </div>
</div>

<style>
  .blob-shape {
    border-radius: 30% 70% 70% 30%;
  }

  @keyframes blob {
    0%, 100% {
      border-radius: 30% 70% 70% 30%;
    }
    25% {
      border-radius: 40% 60% 60% 40%;
    }
    50% {
      border-radius: 50% 50% 50% 50%;
    }
    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }

  .blob-shape {
    animation: blob 8s ease-in-out infinite;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes stagger {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  .animate-stagger > * {
    animation: stagger 0.6s ease-out forwards;
  }
</style>

<script>
  const modal = document.getElementById("speakerModal");
  const closeModalBtn = document.getElementById("closeModalBtn");
  const bioBtns = document.querySelectorAll(".speaker-bio-btn");
  const viewAllBtn = document.getElementById("viewAllSpeakersBtn");
  const collapseBtn = document.getElementById("collapseBtn");
  const speakersGrid = document.getElementById("speakersGrid");
  const showMoreContainer = document.getElementById("showMoreContainer");

  bioBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const speakerName = btn.getAttribute("data-speaker-name");
      const speakerRole = btn.getAttribute("data-speaker-role");
      const speakerCompany = btn.getAttribute("data-speaker-company");
      const speakerBio = btn.getAttribute("data-speaker-bio");
      const speakerLinkedin = btn.getAttribute("data-speaker-linkedin");
      const speakerImage = btn.getAttribute("data-speaker-image");

      document.getElementById("modalSpeakerName")!.textContent = speakerName;
      document.getElementById("modalSpeakerRole")!.textContent = speakerRole;
      document.getElementById("modalSpeakerCompany")!.textContent = speakerCompany;
      document.getElementById("modalSpeakerBio")!.textContent = speakerBio;
      document.getElementById("modalSpeakerImage")!.src = speakerImage;

      const linkedinLink = document.getElementById("modalLinkedinLink");
      if (speakerLinkedin) {
        linkedinLink!.href = speakerLinkedin;
        linkedinLink!.style.display = "inline-flex";
      } else {
        linkedinLink!.style.display = "none";
      }

      modal!.classList.remove("hidden");
    });
  });

  closeModalBtn?.addEventListener("click", () => {
    modal!.classList.add("hidden");
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.classList.add("hidden");
    }
  });

  viewAllBtn?.addEventListener("click", () => {
    // Load more speakers (if implemented)
    showMoreContainer?.classList.remove("hidden");
  });

  collapseBtn?.addEventListener("click", () => {
    showMoreContainer?.classList.add("hidden");
  });

  // Draw circles animation
  const drawCircles = () => {
    const canvas = document.getElementById("speakersDivider") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    canvas.width = width;
    canvas.height = height;

    const colors = ["#3b82f6", "#ef4444", "#f59e0b", "#10b981"];
    let circleIndex = 0;

    setInterval(() => {
      ctx.clearRect(0, 0, width, height);
      const x = width / 2;
      const y = height / 2;
      const radius = 15 + (circleIndex % 3) * 5;
      ctx.fillStyle = colors[circleIndex % colors.length];
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fill();
      circleIndex++;
    }, 300);
  };

  drawCircles();
</script>
