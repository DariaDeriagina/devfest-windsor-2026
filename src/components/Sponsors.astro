---
import { t } from "@lib/i18n";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description,
} = Astro.props;

const defaultTitle = t('en', 'sponsors.title');
const defaultDescription = t('en', 'sponsors.description');

const finalTitle = title || defaultTitle;
const finalDescription = description || defaultDescription;

const sponsors = [
  { 
    name: "Google", 
    logo: "/googleLogo.png",
    url: "https://google.com",
    color: "blue"
  },
  { 
    name: "School of Business", 
    logo: "/schoolOfBusiness.png",
    url: "https://www.uwindsor.ca/business/",
    color: "amber"
  },
];

const colorStyles: Record<string, { ring: string; blob: string }> = {
  blue: {
    ring: "group-hover:ring-blue-600/40",
    blob: "bg-blue-600",
  },
  amber: {
    ring: "group-hover:ring-amber-500/40",
    blob: "bg-amber-500",
  },
};
---

<section id="sponsors" class="py-20 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 animate-fade-in-up">
      <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">
        Sponsors & Partners
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-slate-900 mb-4 mt-6" data-i18n="sponsors.title">
        {finalTitle}
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed max-w-3xl mt-1" data-i18n="sponsors.description">
        {finalDescription}
      </p>
    </div>

    <!-- Sponsors Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      {sponsors.map((sponsor) => {
        const styles = colorStyles[sponsor.color];
        return (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`group relative flex items-center justify-center aspect-square bg-white rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg ${styles.ring}`}
          >
            <!-- Blob animation background -->
            <div
              class={`absolute inset-0 ${styles.blob} opacity-0 group-hover:opacity-10 blur-3xl transition-opacity duration-300 rounded-full`}
              style="border-radius: 30% 70% 70% 30%; animation: blob 8s ease-in-out infinite;"
            />
            
            <!-- Logo -->
            <img
              src={sponsor.logo}
              alt={sponsor.name}
              class="relative z-10 h-16 w-auto group-hover:scale-110 transition-transform duration-300"
            />
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  @keyframes blob {
    0%, 100% {
      border-radius: 30% 70% 70% 30%;
    }
    25% {
      border-radius: 40% 60% 60% 40%;
    }
    50% {
      border-radius: 50% 50% 50% 50%;
    }
    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }
</style>
