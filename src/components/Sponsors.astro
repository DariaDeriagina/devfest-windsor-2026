---
const sponsors = [
  {
    name: "Google",
    logo: "/googleLogo.png",
    url: "https://google.com",
    color: "blue",
  },
  {
    name: "School of Business",
    logo: "/schoolOfBusiness.png",
    url: "https://www.uwindsor.ca/business/",
    color: "amber",
  },
  {
    name: "wetech",
    logo: "/sponsors/WEtech-logo-main.webp",
    url: "https://www.wetech-alliance.com/",
    color: "green",
  },
  {
    name: "DataRealm",
    logo: "/sponsors/datarealm.webp",
    url: "https://www.datarealminc.com/",
    color: "cyan",
  },
  {
    name: "EF Hult Prize",
    logo: "/sponsors/HultPrizelogo2.png",
    url: "http://hultprizeuwindsor.ca/",
    color: "purple",
  },
];

const colorStyles: Record<string, { ring: string; blob: string }> = {
  blue: {
    ring: "group-hover:ring-blue-600/40",
    blob: "bg-blue-600",
  },
  amber: {
    ring: "group-hover:ring-amber-500/40",
    blob: "bg-amber-500",
  },
  green: {
    ring: "group-hover:ring-green-600/40",
    blob: "bg-green-600",
  },
  cyan: {
    ring: "group-hover:ring-cyan-500/40",
    blob: "bg-cyan-500",
  },
  purple: {
    ring: "group-hover:ring-purple-600/40",
    blob: "bg-purple-600",
  },
};
---

<section id="sponsors" class="py-12 sm:py-20 bg-white>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16">
      <span
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
        data-i18n="sponsors.label">Sponsors & Partners</span
      >

      <!-- Colored underline -->
      <div class="flex gap-1 mt-3 h-1 w-24 sm:w-32">
        <div class="flex-1 bg-blue-600 rounded"></div>
        <div class="flex-1 bg-red-600 rounded"></div>
        <div class="flex-1 bg-yellow-500 rounded"></div>
        <div class="flex-1 bg-green-600 rounded"></div>
      </div>
    </div>

    <!-- Sponsors grid - all in one line -->
    <div class="flex flex-wrap justify-center gap-8 lg:gap-12">
      {
        sponsors.map((sponsor) => {
          const style = colorStyles[sponsor.color];
          return (
            <a
              href={sponsor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative w-full sm:w-48 p-6 rounded-lg bg-gray-50 border border-gray-200 transition-all duration-300 hover:shadow-lg hover:border-gray-300 cursor-pointer"
              title={sponsor.name}
            >
              <!-- Decorative blob background -->
              <div
                class:list={[
                  "blob-shape absolute inset-0 scale-0 transition-transform duration-300 group-hover:scale-100 rounded-lg",
                  style.blob,
                ]}
                style="opacity: 0.08;"
                aria-hidden="true"
              />

              <!-- Logo -->
              <div
                class:list={[
                  "relative z-10 ring-4 ring-transparent transition-all duration-300 rounded-lg overflow-hidden",
                  style.ring,
                ]}
              >
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  class="h-20 w-full object-contain group-hover:scale-110 transition-transform duration-300"
                />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .blob-shape {
    border-radius: 30% 70% 70% 30%;
  }

  @keyframes blob {
    0%,
    100% {
      border-radius: 30% 70% 70% 30%;
    }
    25% {
      border-radius: 40% 60% 60% 40%;
    }
    50% {
      border-radius: 50% 50% 50% 50%;
    }
    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }
</style>