---
import { t } from "@lib/i18n";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description,
} = Astro.props;

const defaultTitle = t('en', 'sponsors.title');
const defaultDescription = t('en', 'sponsors.description');

const finalTitle = title || defaultTitle;
const finalDescription = description || defaultDescription;

const sponsors = [
  { 
    name: "Google", 
    logo: "/googleLogo.png",
    url: "https://google.com",
    color: "blue"
  },
  { 
    name: "School of Business", 
    logo: "/schoolOfBusiness.png",
    url: "https://www.uwindsor.ca/business/", // REPLACE WITH ACTUAL URL
    color: "amber"
  },
];

const colorStyles: Record<string, { ring: string; blob: string }> = {
  blue: {
    ring: "group-hover:ring-blue-600/40",
    blob: "bg-blue-600",
  },
  amber: {
    ring: "group-hover:ring-amber-500/40",
    blob: "bg-amber-500",
  },
};
---

<section id="sponsors" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex items-center gap-2 mb-8">
      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zM18 20a6 6 0 00-12 0v2h12v-2z"></path>
      </svg>
      <span class="text-blue-600 font-semibold text-sm uppercase tracking-wide">Sponsors & Partners</span>
    </div>

    <!-- Title and Description -->
    <div class="mb-16">
      <h2 class="text-5xl font-bold mb-6" data-i18n="sponsors.title">
        <span class="text-gray-900">Thank you to our</span><br />
        <span class="bg-gradient-to-r from-blue-600 via-red-600 to-yellow-500 bg-clip-text text-transparent">sponsors and partners</span>
      </h2>

      <!-- Colored underline -->
      <div class="flex gap-1 mb-8 h-1 w-48">
        <div class="flex-1 bg-blue-600 rounded"></div>
        <div class="flex-1 bg-red-600 rounded"></div>
        <div class="flex-1 bg-yellow-500 rounded"></div>
        <div class="flex-1 bg-green-600 rounded"></div>
      </div>

      <p class="text-gray-700 text-lg leading-relaxed max-w-3xl" data-i18n="sponsors.description">
        {finalDescription}
      </p>
    </div>

    <!-- Sponsors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-2xl">
      {sponsors.map((sponsor) => {
        const style = colorStyles[sponsor.color];
        return (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative p-8 rounded-lg bg-gray-50 border border-gray-200 transition-all duration-300 hover:shadow-lg hover:border-gray-300 cursor-pointer"
            title={sponsor.name}
          >
            <!-- Decorative blob background -->
            <div
              class:list={[
                "blob-shape absolute inset-0 scale-0 transition-transform duration-300 group-hover:scale-100 rounded-lg",
                style.blob,
              ]}
              style="opacity: 0.08;"
              aria-hidden="true"
            />
            
            <!-- Logo Only -->
            <div
              class:list={[
                "relative z-10 ring-4 ring-transparent transition-all duration-300 rounded-lg overflow-hidden",
                style.ring,
              ]}
            >
              <img
                src={sponsor.logo}
                alt={sponsor.name}
                class="h-24 w-full object-contain group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .blob-shape {
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    filter: blur(40px);
  }
</style>
