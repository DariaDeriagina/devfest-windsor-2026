---
import { t } from "@lib/i18n";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description,
} = Astro.props;

const defaultTitle = t('en', 'sponsors.title');
const defaultDescription = t('en', 'sponsors.description');

const finalTitle = title || defaultTitle;
const finalDescription = description || defaultDescription;

const sponsors = [
  { name: "Google", logo: "/googleLogo.png" },
  { name: "School of Business", logo: "/schoolOfBusiness.png" },
  { name: "Sponsor 3", logo: "/googleSponsor.png" },
  { name: "Sponsor 4", logo: "/googleSponsor.png" },
  { name: "Sponsor 5", logo: "/googleSponsor.png" },
  { name: "Sponsor 6", logo: "/googleSponsor.png" },
  { name: "Sponsor 7", logo: "/googleSponsor.png" },
  { name: "Sponsor 8", logo: "/googleSponsor.png" },
  { name: "Sponsor 9", logo: "/googleSponsor.png" },
  { name: "Sponsor 10", logo: "/googleSponsor.png" },
  { name: "Sponsor 11", logo: "/googleSponsor.png" },
  { name: "Sponsor 12", logo: "/googleSponsor.png" },
];
---

<section id="sponsors" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex items-center gap-2 mb-8">
      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zM18 20a6 6 0 00-12 0v2h12v-2z"></path>
      </svg>
      <span class="text-blue-600 font-semibold text-sm uppercase tracking-wide">Sponsors & Partners</span>
    </div>

    <!-- Title and Description -->
    <div class="mb-16">
      <h2 class="text-5xl font-bold mb-6" data-i18n="sponsors.title">
        <span class="text-gray-900">Thank you to our</span><br />
        <span class="bg-gradient-to-r from-blue-600 via-red-600 to-yellow-500 bg-clip-text text-transparent">sponsors and partners</span>
      </h2>

      <!-- Colored underline -->
      <div class="flex gap-1 mb-8 h-1 w-48">
        <div class="flex-1 bg-blue-600 rounded"></div>
        <div class="flex-1 bg-red-600 rounded"></div>
        <div class="flex-1 bg-yellow-500 rounded"></div>
        <div class="flex-1 bg-green-600 rounded"></div>
      </div>

      <p class="text-gray-700 text-lg leading-relaxed max-w-3xl" data-i18n="sponsors.description">
        {finalDescription}
      </p>
    </div>

    <!-- Sponsors Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {sponsors.map((sponsor) => (
        <div class="group relative p-6 rounded-lg bg-gray-50 border border-gray-200 hover:border-gray-300 transition-all duration-300 hover:shadow-md">
          <img
            src={sponsor.logo}
            alt={sponsor.name}
            class="h-16 w-auto mb-4 group-hover:scale-110 transition-transform duration-300"
          />
          <p class="text-gray-900 font-semibold text-sm">{sponsor.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
