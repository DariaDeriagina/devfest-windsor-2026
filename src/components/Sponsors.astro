---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Thank you to our sponsors and partners",
  description = "DevFest Windsor 2026 is made possible by the support of organizations and community partners who believe in empowering developers and building a stronger tech future."
} = Astro.props;

const sponsors = [
  { name: "Sponsor 1", logo: "/google-logo.svg" },
  { name: "Sponsor 2", logo: "/google-logo.svg" },
  { name: "Sponsor 3", logo: "/google-logo.svg" },
  { name: "Sponsor 4", logo: "/google-logo.svg" },
  { name: "Sponsor 5", logo: "/google-logo.svg" },
  { name: "Sponsor 6", logo: "/google-logo.svg" },
  { name: "Sponsor 7", logo: "/google-logo.svg" },
  { name: "Sponsor 8", logo: "/google-logo.svg" },
  { name: "Sponsor 9", logo: "/google-logo.svg" },
  { name: "Sponsor 10", logo: "/google-logo.svg" },
  { name: "Sponsor 11", logo: "/google-logo.svg" },
  { name: "Sponsor 12", logo: "/google-logo.svg" },
];
---

<section id="sponsors" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Eyebrow Label -->
    <div class="flex items-center gap-2 mb-8">
      <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v2h8v-2zM2 8a2 2 0 11-4 0 2 2 0 014 0zM10 15a4 4 0 00-8 0v2h8v-2z"></path>
      </svg>
      <span class="text-blue-600 font-semibold text-sm uppercase tracking-wide">Sponsors & Partners</span>
    </div>

    <!-- Title with Colored Words -->
    <h2 class="text-5xl font-bold mb-6">
      <span class="text-gray-900">Thank you to our </span>
      <span class="bg-gradient-to-r from-blue-600 via-red-600 to-orange-500 bg-clip-text text-transparent">sponsors and partners</span>
    </h2>
    
    <!-- Colored Stripes -->
    <div class="flex gap-1 h-1 w-48 mb-8">
      <div class="flex-1 bg-blue-600 rounded"></div>
      <div class="flex-1 bg-red-600 rounded"></div>
      <div class="flex-1 bg-yellow-500 rounded"></div>
      <div class="flex-1 bg-green-600 rounded"></div>
    </div>

    <!-- Description -->
    <p class="text-lg text-gray-700 mb-16 max-w-3xl leading-relaxed">
      {description}
    </p>

    <!-- Sponsors Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {sponsors.map((sponsor) => (
        <div class="flex items-center justify-center p-6 bg-gray-50 rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-300">
          <img 
            src={sponsor.logo} 
            alt={sponsor.name}
            class="h-12 w-auto max-w-full"
          />
        </div>
      ))}
    </div>
  </div>
</section>
