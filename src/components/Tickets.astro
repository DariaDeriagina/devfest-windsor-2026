---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Get Your Tickets",
  description = "Join us at Google DevFest Windsor 2026! Choose the perfect ticket tier for your experience.",
} = Astro.props;

const tickets = [
  {
    id: 1,
    name: "Early Bird",
    price: 49,
    color: "blue",
    description: "Limited early bird pricing for the first 100 tickets",
    features: [
      "Full access to all sessions",
      "Lunch & snacks included",
      "Networking sessions",
      "Event t-shirt",
    ],
    buttonText: "Get Early Bird",
    highlighted: false,
  },
  {
    id: 2,
    name: "Standard",
    price: 79,
    color: "red",
    description: "Regular ticket with full conference access",
    features: [
      "Full access to all sessions",
      "Lunch & snacks included",
      "Networking sessions",
      "Event t-shirt",
      "Exclusive swag bag",
      "Workshop materials",
    ],
    buttonText: "Get Standard",
    highlighted: true,
  },
  {
    id: 3,
    name: "VIP",
    price: 199,
    color: "purple",
    description: "Premium experience with exclusive perks",
    features: [
      "Full access to all sessions",
      "Premium lunch & snacks",
      "VIP networking lounge",
      "Event t-shirt & hoodie",
      "Exclusive swag bag",
      "Workshop materials",
      "Meet & greet with speakers",
      "Priority seating",
    ],
    buttonText: "Get VIP",
    highlighted: false,
  },
];

const colorMap: Record<string, string> = {
  blue: "from-blue-400 to-blue-600",
  red: "from-red-400 to-red-600",
  purple: "from-purple-400 to-purple-600",
};

const buttonColorMap: Record<string, string> = {
  blue: "bg-blue-600 hover:bg-blue-700",
  red: "bg-red-600 hover:bg-red-700",
  purple: "bg-purple-600 hover:bg-purple-700",
};
---

<section id="tickets" class="py-20 bg-gradient-to-b from-white to-gray-50 animate-fade-in-up">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">{title}</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">{description}</p>
    </div>

    <!-- Tickets Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 animate-stagger">
      {tickets.map((ticket, index) => (
        <div
          class={`rounded-2xl overflow-hidden transition-all duration-300 cursor-pointer hover:shadow-2xl animate-fade-in-up ${
            ticket.highlighted ? "md:scale-105 shadow-xl" : "shadow-lg hover:shadow-xl"
          }`}
          style={`animation-delay: ${index * 0.1}s;`}
          onclick={`alert('Ticket: ${ticket.name} - $${ticket.price}\\n\\nClick to proceed to checkout')`}
        >
          <!-- Header with gradient -->
          <div class={`bg-gradient-to-r ${colorMap[ticket.color]} p-6 text-white`}>
            <h3 class="text-2xl font-bold mb-2">{ticket.name}</h3>
            <p class="text-sm opacity-90">{ticket.description}</p>
          </div>

          <!-- Price Section -->
          <div class="bg-white px-6 py-8 border-b border-gray-200">
            <div class="text-center">
              <span class="text-4xl font-bold text-gray-900">${ticket.price}</span>
              <p class="text-gray-600 text-sm mt-2">per ticket</p>
            </div>
          </div>

          <!-- Features List -->
          <div class="px-6 py-8 space-y-4 animate-stagger">
            {ticket.features.map((feature) => (
              <div class="flex items-start animate-fade-in-up">
                <svg
                  class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="text-gray-700 text-sm">{feature}</span>
              </div>
            ))}
          </div>

          <!-- CTA Button -->
          <div class="px-6 pb-8">
            <button
              class={`w-full py-3 px-4 rounded-lg font-semibold text-white transition-all duration-300 hover:shadow-lg transform hover:scale-105 ${
                buttonColorMap[ticket.color]
              }`}
              onclick={`event.stopPropagation(); alert('Added ${ticket.name} ticket ($${ticket.price}) to cart')`}
            >
              {ticket.buttonText}
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Additional Info -->
    <div class="bg-blue-50 rounded-lg p-8 border border-blue-200 animate-fade-in-up">
      <div class="text-center">
        <h3 class="text-xl font-bold text-gray-900 mb-3">Questions about tickets?</h3>
        <p class="text-gray-700 mb-4">
          We offer group discounts for teams of 5 or more. Contact us for more information.
        </p>
        <button
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition-all duration-300 cursor-pointer hover:shadow-lg transform hover:scale-105"
          onclick={`alert('Email: devfest@windsor.com\\nPhone: (519) 555-0100')`}
        >
          Contact Support
        </button>
      </div>
    </div>
  </div>
</section>
