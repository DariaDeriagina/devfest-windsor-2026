---
import type { EventConfig } from "@types/event";

interface Props {
  event: EventConfig;
}

const { event } = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center pt-20 bg-gradient-to-br from-blue-50 via-white to-purple-50 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Main content -->
    <div class="animate-fade-in-up">
      <!-- Date and location badge -->
      <div class="mb-6 inline-block">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm border border-blue-200 rounded-full text-sm font-semibold text-blue-600">
          📍 {event.location.city}, {event.location.province}
          <span class="mx-1">•</span>
          📅 November 21, 2026
        </span>
      </div>

      <!-- Main title -->
      <h1 class="mt-6 text-5xl sm:text-6xl lg:text-7xl font-bold text-slate-900 tracking-tight">
        {event.hero.title}
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-xl sm:text-2xl text-slate-600 max-w-3xl mx-auto font-semibold">
        {event.hero.subtitle}
      </p>

      <!-- Description -->
      <p class="mt-6 text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {event.hero.description}
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a
          href={event.hero.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 transform hover:scale-105"
        >
          {event.hero.cta.text}
        </a>
        <a
          href={event.hero.secondaryCta.href}
          class="px-8 py-4 bg-white text-blue-600 font-semibold rounded-lg border-2 border-blue-600 hover:bg-blue-50 transition-all duration-300"
        >
          {event.hero.secondaryCta.text}
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-16 grid grid-cols-3 gap-6 max-w-2xl mx-auto">
        <div class="animate-fade-in-up" style="animation-delay: 0.1s;">
          <p class="text-3xl sm:text-4xl font-bold text-blue-600">100+</p>
          <p class="text-sm text-slate-600 mt-2">Speakers</p>
        </div>
        <div class="animate-fade-in-up" style="animation-delay: 0.2s;">
          <p class="text-3xl sm:text-4xl font-bold text-purple-600">500+</p>
          <p class="text-sm text-slate-600 mt-2">Attendees</p>
        </div>
        <div class="animate-fade-in-up" style="animation-delay: 0.3s;">
          <p class="text-3xl sm:text-4xl font-bold text-emerald-600">5</p>
          <p class="text-sm text-slate-600 mt-2">Tracks</p>
        </div>
      </div>
    </div>
  </div>
</section>
