---
import type { EventConfig } from "@types/event";
import Button from "@components/Button.astro";

interface Props {
  event: EventConfig;
}

const { event } = Astro.props;
const { hero, date, location } = event;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-white pt-20 pb-20"
  style="background-image: url('/group_0f_lines_bg.svg'); background-size: cover; background-position: center; background-attachment: fixed;"
  aria-label="Hero section"
>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Left Column -->
      <div class="space-y-8 animate-fade-in">
        <!-- Date Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-300 rounded-full">
          <span class="relative flex w-2 h-2">
            <span class="absolute inline-flex w-full h-full rounded-full bg-yellow-500 opacity-75 animate-ping"></span>
            <span class="relative inline-flex w-2 h-2 rounded-full bg-yellow-500"></span>
          </span>
          <span class="text-sm font-semibold text-slate-800"
            >{formattedDate} • {location.city}, {location.province}</span
          >
        </div>

        <!-- Title with gradient colors -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight">
          <span class="gradient-shimmer" style="background: linear-gradient(90deg, #005AC1 0%, #005AC1 25%, #8B4789 35%, #EA4335 50%, #FBBC05 75%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">GDG Windsor</span>
          <br />
          <span class="gradient-shimmer" style="background: linear-gradient(90deg, #005AC1 0%, #EA4335 40%, #FBBC05 70%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">DevFest 2026</span>
        </h1>

        <!-- Decorative accent lines -->
        <div class="flex gap-2 h-1">
          <div class="w-12 bg-blue-600"></div>
          <div class="w-12 bg-red-600"></div>
          <div class="w-12 bg-yellow-400"></div>
          <div class="w-12 bg-green-600"></div>
        </div>

        <!-- Description -->
        <p class="text-lg text-slate-700 leading-relaxed max-w-md animate-fade-in-up">
          {hero.description}
        </p>

        <!-- CTA Button -->
        <div class="animate-fade-in-up">
          <a
            href={hero.cta.href}
            class="w-72 h-16 relative bg-blue-500 rounded-[32px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] overflow-hidden flex items-center justify-center hover:shadow-lg transition-all duration-300 group inline-flex"
          >
            <!-- Decorative circles -->
            <div class="w-12 h-12 left-[-7.78px] top-[32px] absolute bg-green-600 rounded-full animate-bounce-slow" style="animation-delay: 0s;" />
            <div class="w-14 h-14 left-[261.05px] top-[-18.50px] absolute opacity-80 bg-yellow-500 rounded-full animate-bounce-slow" style="animation-delay: 0.6s;" />
            <div class="w-14 h-14 left-[250.61px] top-[36.50px] absolute bg-red-500 rounded-full animate-bounce-slow" style="animation-delay: 1.2s;" />

            <!-- Icon -->
            <img
              src="/icon-ticket.svg"
              alt="Ticket icon"
              class="w-11 h-11 left-[55.44px] top-[10.18px] absolute"
            />

            <!-- Text -->
            <span class="text-white text-base font-semibold font-inter ml-12">{hero.cta.text}</span>

            <!-- Arrow -->
            <span class="text-white text-base font-semibold ml-2 group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column - Hero Image -->
      <div class="hidden md:block animate-slide-in-right">
        <div class="float-slow">
          <div
            class="relative rounded-3xl overflow-hidden shadow-2xl transform hover:scale-105 transition-transform duration-300"
          >
            <img
              src={hero.imageUrl}
              alt={hero.imageAlt}
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  :global(.animate-fade-in) {
    animation: fadeIn 0.8s ease-in-out forwards;
  }

  :global(.animate-fade-in-up) {
    opacity: 0;
    animation: fadeInUp 0.8s ease-in-out forwards;
  }

  :global(.animate-fade-in-up:nth-child(1)) {
    animation-delay: 0.2s;
  }

  :global(.animate-fade-in-up:nth-child(2)) {
    animation-delay: 0.4s;
  }

  :global(.animate-fade-in-up:nth-child(3)) {
    animation-delay: 0.6s;
  }

  :global(.animate-slide-in-right) {
    animation: slideInRight 0.8s ease-in-out 0.2s both;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  :global(.gradient-shimmer) {
    background-size: 200% auto;
    animation: gradientShift 6s ease-in-out infinite;
  }

  @keyframes floatSlow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  :global(.float-slow) {
    animation: floatSlow 5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-fade-in),
    :global(.animate-fade-in-up),
    :global(.animate-slide-in-right),
    :global(.gradient-shimmer),
    :global(.float-slow),
    :global(.animate-bounce-slow),
    :global(.animate-ping) {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
