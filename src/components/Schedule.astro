                            />
                          )}
                        </div>
                      </div>

                      <div class="flex-grow">
                        <h4 class="font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
                          {session.title}
                        </h4>

                        <p class="text-sm text-gray-600 mb-2">
                          {session.speaker}
                        </p>

                        <div class="flex flex-wrap gap-2">
