---

<section id="schedule" class="animate-fade-in-up" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl font-bold text-gray-900 mb-4" data-i18n="schedule.title">{finalTitle}</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto" data-i18n="schedule.description">{finalDescription}</p>
    </div>
<!-- Track Filter Buttons -->
<div class="flex flex-wrap justify-center gap-2 mb-12">
  {tracks.map((track) => (
    <button
      class={`track-filter-btn px-4 py-2 rounded-full font-semibold text-white bg-gradient-to-r ${track.bgGradient} hover:shadow-lg hover:shadow-blue-500/40 transition-all duration-300 cursor-pointer transform hover:scale-105 flex items-center gap-1`}
      data-track={track.name}
    >
      <span set:html={iconSvgs[track.icon]} />
      <span data-track-name={`track.${track.name.toLowerCase().replace(/ /g, "")}`}>{track.name}</span>
    </button>
  ))}
</div>

    <!-- Sessions Table -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b-2 border-gray-200">
            <th class="text-left py-4 px-4 font-semibold text-gray-900" data-schedule-header="time">TIME</th>
            <th class="text-left py-4 px-4 font-semibold text-gray-900" data-schedule-header="session">SESSION</th>
            <th class="text-left py-4 px-4 font-semibold text-gray-900 hidden md:table-cell" data-schedule-header="location">LOCATION</th>
            <th class="text-center py-4 px-4 font-semibold text-gray-900">ADD</th>
          </tr>
        </thead>
        <tbody>
          {sessions.map((session, idx) => (
            <tr class="session-row border-b border-gray-100 hover:bg-gray-50 transition-colors cursor-pointer"
                data-track={session.track}
                onclick={`window.openSessionModal({title: '${session.title}', speaker: '${session.speaker}', description: '${session.description.replace(/'/g, "\\'")}', duration: '${session.duration}', track: '${session.track}', type: '${session.type}'})`}>
              <!-- Time -->
              <td class="py-6 px-4 font-semibold text-gray-900 whitespace-nowrap">{session.time}</td>

              <!-- Session Details -->
              <td class="py-6 px-4">
                <div class="flex items-start gap-4">
                  <!-- Avatar with blob background -->
                  <div class="relative flex-shrink-0">
                    <div class={`w-12 h-12 ${session.bgColor} rounded-full absolute opacity-20 blur-sm`}></div>
                    <img
                      src={session.avatar}
                      alt={session.speaker}
                      class="w-12 h-12 rounded-full relative cursor-pointer hover:opacity-80 transition-opacity"
                      onclick="event.stopPropagation();"
                    />
                  </div>

                  <!-- Session info -->
                  <div class="flex-grow">
                    <h4 class="font-semibold text-gray-900 mb-2 cursor-pointer hover:text-blue-600 transition-colors">{session.title}</h4>
                    <p class="text-sm text-gray-600 mb-2">{session.speaker}</p>
                    <div class="flex flex-wrap gap-2">
                      <!-- Track badge -->
                      <span
                        class={`px-3 py-1.5 rounded-full text-xs font-semibold text-white bg-gradient-to-r ${tracks.find(t => t.name === session.track)?.bgGradient} cursor-pointer hover:shadow-md transition-all flex items-center gap-1.5`}
                        onclick="event.stopPropagation();"
                      >
                        <span set:html={iconSvgs[tracks.find(t => t.name === session.track)?.icon || "sparkles"]} />
                        {session.track}
                      </span>

                      <!-- Type badge -->
                      <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 bg-gray-200 cursor-pointer hover:bg-gray-300 transition-colors" onclick="event.stopPropagation();">
                        {session.type}
                      </span>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Location -->
              <td class="py-6 px-4 text-gray-600 hidden md:table-cell">
                <button class="text-blue-600 hover:text-blue-800 font-semibold cursor-pointer transition-colors" onclick="event.stopPropagation();">
                  {session.location}
                </button>
              </td>

              <!-- Add to Calendar -->
              <td class="py-6 px-4 text-center">
                <button
                  class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors cursor-pointer"
                  onclick="event.stopPropagation(); window.addToCalendar(event, this, {title: '${session.title}', speaker: '${session.speaker}', time: '${session.time}', location: '${session.location}', description: '${session.description.replace(/'/g, "\\'")}'});"
                  data-session-title={session.title}
                  data-session-speaker={session.speaker}
                  data-session-time={session.time}
                  data-session-location={session.location}
                >
                  <span data-schedule-add>Add</span>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Session Modal -->
  <SessionModal sessions={sessions} />
</section>

<script>
  // Parse time string to 24-hour format
  function parseTime(timeStr) {
    const match = timeStr.match(/(\d+):(\d+)\s(AM|PM)/);
    if (!match) return null;

    let hours = parseInt(match[1]);
    const minutes = parseInt(match[2]);
    const meridiem = match[3];

    if (meridiem === 'PM' && hours !== 12) hours += 12;
    if (meridiem === 'AM' && hours === 12) hours = 0;

    return { hours, minutes };
  }

  // Add to Calendar function with Google Calendar and Apple Calendar support
  window.addToCalendar = function(event, button, sessionData) {
    event.preventDefault();
    event.stopPropagation();

    const { title, speaker, time, location, description } = sessionData;
    const parsedTime = parseTime(time);

    if (!parsedTime) {
      alert('Unable to parse session time');
      return;
    }

    // Create menu for calendar selection
    const menuId = 'calendar-menu-' + Date.now();
    const menu = document.createElement('div');
    menu.id = menuId;
    menu.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    `;

    const menuContent = document.createElement('div');
    menuContent.style.cssText = `
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      max-width: 400px;
      width: 90%;
    `;

    menuContent.innerHTML = `
      <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #111;">Add to Calendar</h3>
      <p style="margin: 0 0 20px 0; color: #666; font-size: 14px;">${title}</p>
      <button id="google-calendar-btn" style="
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 8px;
        background: #4285F4;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#3367D6'" onmouseout="this.style.background='#4285F4'">
        📅 Add to Google Calendar
      </button>
      <button id="apple-calendar-btn" style="
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 8px;
        background: #555;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#333'" onmouseout="this.style.background='#555'">
        🍎 Add to Apple Calendar
      </button>
      <button id="close-menu-btn" style="
        width: 100%;
        padding: 12px 16px;
        background: #e5e7eb;
        color: #333;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#d1d5db'" onmouseout="this.style.background='#e5e7eb'">
        Cancel
      </button>
    `;

    menu.appendChild(menuContent);
    document.body.appendChild(menu);

    // Event date: November 21, 2026
    const eventDate = new Date(2026, 10, 21); // Month is 0-indexed
    eventDate.setHours(parsedTime.hours, parsedTime.minutes, 0);

    const endDate = new Date(eventDate);
    endDate.setHours(endDate.getHours() + 1); // Default 1 hour duration

    // Google Calendar handler
    document.getElementById('google-calendar-btn').addEventListener('click', function() {
      const startTime = eventDate.toISOString();
      const endTime = endDate.toISOString();

      const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${startTime.replace(/[-:]/g, '').split('.')[0]}Z/${endTime.replace(/[-:]/g, '').split('.')[0]}Z&location=${encodeURIComponent(location)}&details=${encodeURIComponent(`Speaker: ${speaker}\n\n${description}`)}`;

      window.open(googleCalendarUrl, '_blank', 'width=800,height=600');
      document.body.removeChild(menu);
    });

    // Apple Calendar handler
    document.getElementById('apple-calendar-btn').addEventListener('click', function() {
      // Create ICS file content for Apple Calendar
      const startTime = eventDate.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      const endTime = endDate.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';

      const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Google DevFest Windsor//NONSGML v1.0//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VEVENT
UID:devfest-${Date.now()}@googledevfest.local
DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z
DTSTART:${startTime}
DTEND:${endTime}
SUMMARY:${title}
DESCRIPTION:Speaker: ${speaker}\\n\\n${description}
LOCATION:${location}
STATUS:CONFIRMED
END:VEVENT
END:VCALENDAR`;

      // Create blob and download ICS file
      const blob = new Blob([icsContent], { type: 'text/calendar' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${title.replace(/\s+/g, '-')}.ics`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);

      document.body.removeChild(menu);
    });

    // Close menu handler
    document.getElementById('close-menu-btn').addEventListener('click', function() {
      document.body.removeChild(menu);
    });

    // Close on background click
    menu.addEventListener('click', function(e) {
      if (e.target === menu) {
        document.body.removeChild(menu);
      }
    });
  };

  // Track filtering functionality
  const trackFilterBtns = document.querySelectorAll('.track-filter-btn');
  const sessionRows = document.querySelectorAll('.session-row');
  let selectedTrack = null;

  trackFilterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const track = e.target.closest('.track-filter-btn')?.getAttribute('data-track');
      if (!track) return;

      // Handle "ALL" button
      if (track === "ALL") {
        selectedTrack = null;
        trackFilterBtns.forEach(b => b.classList.remove('active'));
        sessionRows.forEach(row => {
          row.classList.remove('hidden');
          row.classList.add('fade-in');
        });
      } else if (selectedTrack === track) {
        // Toggle off: show all sessions
        selectedTrack = null;
        trackFilterBtns.forEach(b => b.classList.remove('active'));
        sessionRows.forEach(row => {
          row.classList.remove('hidden');
          row.classList.add('fade-in');
        });
      } else {
        // Show only this track
        selectedTrack = track;
        trackFilterBtns.forEach(b => {
          if (b.getAttribute('data-track') === track) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
        sessionRows.forEach(row => {
          const rowTrack = row.getAttribute('data-track');
          if (rowTrack === track) {
            row.classList.remove('hidden');
            row.classList.add('fade-in');
          } else {
            row.classList.add('hidden');
          }
        });
      }

      // Smooth scroll to table
      document.querySelector('table')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  .track-filter-btn.active {
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
    transform: scale(1.05);
  }

  .session-row.hidden {
    display: none;
  }

  .session-row.fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      animation: none !important;
    }
  }
</style>