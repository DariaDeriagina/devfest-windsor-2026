---
import { t } from "@lib/i18n";
import SessionModal from "@components/SessionModal.astro";
import { FEATURED_SPEAKERS } from "@config/speakers.config";
import { SUBMITTED_SESSIONS } from "@config/sessions.config";

interface Props {
  title?: string;
  description?: string;
}

const { title } = Astro.props;
const finalTitle = title || t("en", "schedule.title");

const DEFAULT_TRACK = "Google Cloud";
const PLACEHOLDER_IMAGE = "/google-person.png";
const LEADERSHIP_TRACK = "Leadership and Entrepreneurship";
const FIRESIDE_TITLE = "Lunch & Fireside Chat";

const normalizeSpeakerName = (name: string) =>
  name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, " ");

const getSpeakerData = (speakerName: string) => {
  if (
    !speakerName ||
    ["TBD", "Community", "Google DevFest Team"].includes(speakerName)
  ) {
    return null;
  }

  const primaryName = speakerName.split(" / ")[0].trim();

  return (
    FEATURED_SPEAKERS.find(
      (speaker) =>
        normalizeSpeakerName(speaker.name) ===
        normalizeSpeakerName(primaryName),
    ) || null
  );
};

const accentStyles: Record<string, { blob: string; ring: string }> = {
  blue: {
    blob: "bg-blue-600",
    ring: "group-hover:ring-blue-600/40",
  },
  green: {
    blob: "bg-green-600",
    ring: "group-hover:ring-green-600/40",
  },
  red: {
    blob: "bg-red-600",
    ring: "group-hover:ring-red-600/40",
  },
  gold: {
    blob: "bg-amber-500",
    ring: "group-hover:ring-amber-500/40",
  },
};

const tracks = [
  {
    name: "ALL",
    icon: "sparkles",
    gradient: "from-slate-600 to-slate-700",
    text: "text-white",
  },
  {
    name: "Google Cloud",
    icon: "cloud",
    gradient: "from-blue-500 to-blue-700",
    text: "text-white",
  },
  {
    name: "Build with AI",
    icon: "sparkles",
    gradient: "from-red-500 to-red-700",
    text: "text-white",
  },
  {
    name: "Full Stack",
    icon: "code",
    gradient: "from-green-500 to-green-700",
    text: "text-white",
  },
  {
    name: LEADERSHIP_TRACK,
    icon: "rocket",
    gradient: "from-yellow-400 to-amber-500",
    text: "text-slate-900",
  },
];

const trackRooms: Record<string, string> = {
  "Google Cloud": "104",
  "Build with AI": "112",
  "Full Stack": "B14",
  [LEADERSHIP_TRACK]: "B02",
};

const roomLinks: Record<string, string> = {
  "104": "https://ctl2.uwindsor.ca/classrooms/OB/104/",
  "112": "https://ctl2.uwindsor.ca/classrooms/OB/112/",
  "B14": "https://ctl2.uwindsor.ca/classrooms/OB/B14/",
  "110": "https://ctl2.uwindsor.ca/classrooms/OB/110/",
  "B02": "https://ctl2.uwindsor.ca/classrooms/OB/B02/",
};

const firesideParticipants = [
  { name: "Don Ward" },
  { name: "Naresh Jasotani" },
  { name: "Mina Girges" },
  { name: "James Lannigan" },
  { name: "Yvonne Pilon" },
].map((participant) => {
  const profile = getSpeakerData(participant.name);

  return {
    name: participant.name,
    imageUrl:
      participant.name === "Yvonne Pilon"
        ? "/speakers/yvonne_pilon.webp"
        : profile?.imageUrl || PLACEHOLDER_IMAGE,
    role: profile?.role || "",
    company: profile?.company || "",
    bio: profile?.bio || "",
    linkedinUrl: profile?.linkedinUrl || "",
  };
});

function createScheduledSession(
  time: string,
  speaker: string,
  track: string,
) {
  const room = trackRooms[track];

  return {
    time,
    duration: "45 min",
    title: `Session with ${speaker.replace(/ \/ /g, " & ")}`,
    speaker,
    track,
    type: "Technical Session",
    location: room,
    description: `${track} track session in Room ${room}.`,
  };
}

const scheduledSessions = [
  {
    time: "8:45 AM",
    duration: "60 min",
    title: "Welcoming and Keynote",
    speaker: "Serg Masís",
    track: "ALL",
    type: "Keynote",
    location: "Main Hall",
    description:
      "Welcome to Google DevFest Windsor 2026! Join Serg Masís for the welcoming and keynote session.",
  },

  // 10:00–10:45 AM
  createScheduledSession("10:00 AM", "Nilesh Patel", "Google Cloud"),
  createScheduledSession("10:00 AM", "Andrea Irina Yzeiri", "Build with AI"),
  createScheduledSession("10:00 AM", "Arunesh Choudhary", "Full Stack"),
  createScheduledSession("10:00 AM", "Mahnoz Akhtari", LEADERSHIP_TRACK),

  // 11:00–11:45 AM
  createScheduledSession("11:00 AM", "Bryan Kelly", "Google Cloud"),
  createScheduledSession("11:00 AM", "Diaa ElKott", "Build with AI"),
  createScheduledSession("11:00 AM", "Keval Patel", "Full Stack"),
  createScheduledSession("11:00 AM", "Frank Abbruzzese", LEADERSHIP_TRACK),

  // Shared lunch and fireside chat
  {
    time: "12:00 PM - 1:00 PM",
    duration: "60 min",
    title: FIRESIDE_TITLE,
    speaker:
      "Don Ward / Naresh Jasotani / Mina Girges / James Lannigan / Yvonne Pilon",
    track: "ALL",
    type: "Break",
    location: "104",
    description: `The State of AI and Where the Industry is Going

Panelists:
• Don Ward
• Naresh Jasotani
• Mina Girges
• James Lannigan

Moderator:
• Yvonne Pilon`,
  },

  // 1:00–1:45 PM
  // No Google Cloud session is listed for this slot.
  createScheduledSession("1:00 PM", "Joe Youssouf", "Build with AI"),
  createScheduledSession("1:00 PM", "Elvis Akhalu", "Full Stack"),
  createScheduledSession("1:00 PM", "Sean Bridgeman", LEADERSHIP_TRACK),

  // 2:00–2:45 PM
  createScheduledSession("2:00 PM", "Don Ward", "Google Cloud"),
  createScheduledSession("2:00 PM", "Atif Khan", "Build with AI"),
  createScheduledSession("2:00 PM", "Kylie Kiser", "Full Stack"),
  createScheduledSession("2:00 PM", "Mina Girges", LEADERSHIP_TRACK),

  // 3:00–3:45 PM
  createScheduledSession("3:00 PM", "Vimal K.", "Google Cloud"),
  createScheduledSession("3:00 PM", "Veronica Reingold", "Build with AI"),
  createScheduledSession("3:00 PM", "Nav Singh", "Full Stack"),
  createScheduledSession(
    "3:00 PM",
    "Chukwuka (Eddie) Asamaka",
    LEADERSHIP_TRACK,
  ),

  // 4:00–4:45 PM
  createScheduledSession("4:00 PM", "Florid Maclean", "Google Cloud"),
  createScheduledSession("4:00 PM", "Steven Rice", "Build with AI"),
  createScheduledSession(
    "4:00 PM",
    "Camila Gaitan / Kevin Serrano Mojica",
    "Full Stack",
  ),
  createScheduledSession("4:00 PM", "Wen Teoh", LEADERSHIP_TRACK),

  {
    time: "5:00 PM",
    duration: "30 min",
    title: "Closing Remarks and Event Wrap Up",
    speaker: "Google DevFest Team",
    track: "ALL",
    type: "Closing Session",
    location: "Main Hall",
    description:
      "Join us for closing remarks, raffle drawings, and final networking opportunities.",
  },
];

// Apply submitted titles and abstracts to the scheduled sessions.
const abstractsBySpeaker = new Map(
  SUBMITTED_SESSIONS.map((session) => [
    normalizeSpeakerName(session.speaker),
    session,
  ]),
);

const sessions = scheduledSessions.map((session) => {
  if (session.track === "ALL") return session;

  const abstract = abstractsBySpeaker.get(
    normalizeSpeakerName(session.speaker),
  );

  if (!abstract) return session;

  return {
    ...session,
    title: abstract.title,
    description: abstract.description,
  };
});

const icons: Record<string, string> = {
  sparkles:
    '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.1 6.9L19 10l-6.9 2.1L10 19l-2.1-6.9L1 10l6.9-2.1L10 1z"/></svg>',
  cloud:
    '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 16a4 4 0 0 1-.5-8 5.5 5.5 0 0 1 10.8-1A4.5 4.5 0 1 1 15 16H5z"/></svg>',
  code:
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5L2 10l5 5M13 5l5 5-5 5"/></svg>',
  rocket:
    '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M17 2c-5 0-8 2-10 6L4 9l-2 3 4 1 1 4 3-2 1-3c4-2 6-5 6-10zM5 15l-2 2 2-1 1-2z"/></svg>',
};
---

<section
  id="schedule"
  class="py-20 bg-white"
  data-default-track={DEFAULT_TRACK}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
   <div class="text-left mb-12">
      <span
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
      >
        SCHEDULE
      </span>

      <div class="schedule-color-lines" aria-hidden="true">
        <span class="bg-blue-600"></span>
        <span class="bg-red-600"></span>
        <span class="bg-yellow-400"></span>
        <span class="bg-green-600"></span>
      </div>

      <h2
        class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight"
        data-i18n={title ? undefined : "schedule.title"}
      >
        {finalTitle}
      </h2>
    </div>

    <p class="md:hidden text-center text-sm text-slate-500 mb-3">
      Swipe to explore all tracks
      <span aria-hidden="true"> →</span>
    </p>

    <!-- Track Filters -->
    <div
      class="track-filters flex flex-wrap justify-center gap-3 mb-10"
      role="group"
      aria-label="Filter sessions by track"
    >
      {
        tracks.map((track) => (
          <button
            type="button"
            class={`track-filter-btn px-6 py-3 rounded-full font-semibold ${track.text} bg-gradient-to-r ${track.gradient} hover:shadow-lg transition-all duration-300 flex items-center gap-2 ${
              track.name === DEFAULT_TRACK ? "active" : ""
            }`}
            data-track={track.name}
            aria-pressed={track.name === DEFAULT_TRACK}
          >
            <span class="flex-shrink-0" set:html={icons[track.icon]} />
            {track.name}
          </button>
        ))
      }
    </div>

    <!-- Schedule -->
    <div class="schedule-table-wrapper overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b-2 border-gray-200">
            <th
              scope="col"
              class="text-left py-4 px-4 font-semibold text-gray-900"
            >
              TIME
            </th>

            <th
              scope="col"
              class="text-left py-4 px-4 font-semibold text-gray-900"
            >
              SESSION
            </th>

            <th
              scope="col"
              class="text-left py-4 px-4 font-semibold text-gray-900 hidden md:table-cell"
            >
              LOCATION
            </th>

            <th
              scope="col"
              class="text-center py-4 px-4 font-semibold text-gray-900"
            >
              ADD
            </th>
          </tr>
        </thead>

        <tbody>
          {
            sessions.map((session) => {
              const isFiresideChat = session.title === FIRESIDE_TITLE;

              const speakerData = isFiresideChat
                ? null
                : getSpeakerData(session.speaker);

              const accent =
                accentStyles[speakerData?.accentColor || "blue"] ||
                accentStyles.blue;

              const track = tracks.find(
                (item) => item.name === session.track,
              );

              const speakerImage =
                speakerData?.imageUrl || PLACEHOLDER_IMAGE;

              const roomLink = roomLinks[session.location];

              const isVisibleOnLoad =
                session.track === DEFAULT_TRACK ||
                session.track === "ALL";

              return (
                <tr
                  class={`session-row border-b border-gray-100 hover:bg-gray-50 transition-colors cursor-pointer ${
                    isVisibleOnLoad ? "" : "hidden"
                  }`}
                  data-track={session.track}
                  data-title={session.title}
                  data-speaker={session.speaker}
                  data-description={session.description}
                  data-duration={session.duration}
                  data-type={session.type}
                  data-time={session.time}
                  data-location={session.location}
                >
                  <td class="py-6 px-4 font-semibold text-gray-900 whitespace-nowrap">
                    {session.time}
                  </td>

                  <td class="py-6 px-4">
                    <div class="flex items-start gap-4">
                      {!isFiresideChat && (
                        <div class="flex-shrink-0">
                          {speakerData ? (
                            <button
                              type="button"
                              class="speaker-schedule-trigger group relative block w-12 h-12 rounded-full"
                              aria-label={`About ${speakerData.name}`}
                              data-speaker-name={speakerData.name}
                              data-speaker-role={speakerData.role}
                              data-speaker-company={speakerData.company}
                              data-speaker-bio={speakerData.bio || ""}
                              data-speaker-linkedin={speakerData.linkedinUrl || ""}
                              data-speaker-image={speakerImage}
                            >
                              <span
                                class={`blob-shape absolute inset-0 scale-105 ${accent.blob}`}
                                aria-hidden="true"
                              />

                              <img
                                src={speakerImage}
                                alt={speakerData.imageAlt || speakerData.name}
                                width="48"
                                height="48"
                                loading="lazy"
                                class={`relative w-full h-full rounded-full object-cover ring-2 ring-white shadow-md ${accent.ring}`}
                              />
                            </button>
                          ) : (
                            <img
                              src={PLACEHOLDER_IMAGE}
                              alt=""
                              width="48"
                              height="48"
                              loading="lazy"
                              class="w-12 h-12 rounded-full object-cover ring-2 ring-white shadow-md"
                            />
                          )}
                        </div>
                      )}

                      <div class="session-content flex-grow min-w-0">
                        <h4 class="font-semibold text-gray-900 mb-2">
                          <button
                            type="button"
                            class="session-title-btn text-left hover:text-blue-600 transition-colors"
                          >
                            {session.title}
                          </button>
                        </h4>

                        {isFiresideChat ? (
                          <>
                            <p class="text-sm text-gray-600 leading-relaxed">
                              The State of AI and Where the Industry is Going
                            </p>

                            <div class="fireside-people">
                              {firesideParticipants.map((participant) => (
                                <button
                                  type="button"
                                  class="speaker-schedule-trigger fireside-person"
                                  aria-label={`About ${participant.name}`}
                                  data-speaker-name={participant.name}
                                  data-speaker-role={participant.role}
                                  data-speaker-company={participant.company}
                                  data-speaker-bio={participant.bio}
                                  data-speaker-linkedin={participant.linkedinUrl}
                                  data-speaker-image={participant.imageUrl}
                                >
                                  <img
                                    src={participant.imageUrl}
                                    alt={participant.name}
                                    width="64"
                                    height="64"
                                    loading="lazy"
                                    class="fireside-person-photo"
                                  />

                                  <span class="fireside-person-name">
                                    {participant.name}
                                  </span>
                                </button>
                              ))}
                            </div>
                          </>
                        ) : (
                          <p class="text-sm text-gray-600 mb-2">
                            {session.speaker}
                          </p>
                        )}

                        <div class="flex flex-wrap gap-2">
                          <span
                            class={`px-3 py-1.5 rounded-full text-xs font-semibold ${
                              track?.text || "text-white"
                            } bg-gradient-to-r ${
                              track?.gradient || "from-slate-600 to-slate-700"
                            } inline-flex items-center gap-1.5`}
                          >
                            <span
                              class="flex-shrink-0"
                              set:html={icons[track?.icon || "sparkles"]}
                            />
                            {session.track}
                          </span>

                          {session.type !== "Technical Session" && (
                            <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 bg-gray-200">
                              {session.type}
                            </span>
                          )}

                          {speakerData?.bio && (
                            <button
                              type="button"
                              class="speaker-schedule-trigger inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors"
                              aria-label={`Read biography of ${speakerData.name}`}
                              data-speaker-name={speakerData.name}
                              data-speaker-role={speakerData.role}
                              data-speaker-company={speakerData.company}
                              data-speaker-bio={speakerData.bio}
                              data-speaker-linkedin={speakerData.linkedinUrl || ""}
                              data-speaker-image={speakerImage}
                            >
                              BIO
                            </button>
                          )}
                        </div>
                      </div>
                    </div>
                  </td>

                  <td class="py-6 px-4 text-gray-600 hidden md:table-cell">
                    {roomLink ? (
                      <a
                        href={roomLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="room-link inline-flex items-center gap-1 text-blue-600 font-semibold underline underline-offset-4 hover:text-blue-800"
                        aria-label={`View Room ${session.location} — opens in a new tab`}
                      >
                        {session.location}
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span class="text-blue-600 font-semibold">
                        {session.location}
                      </span>
                    )}
                  </td>

                  <td class="py-6 px-4 text-center">
                    <button
                      type="button"
                      class="add-to-calendar-btn inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
                      aria-label={`Add ${session.title} to calendar`}
                    >
                      Add
                    </button>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>

  <SessionModal sessions={sessions} />

  <!-- Speaker Biography Modal -->
  <dialog
    id="schedulespeakerModal"
    class="schedule-bio-dialog rounded-2xl bg-white p-0 text-slate-900"
    aria-labelledby="scheduleModalSpeakerName"
  >
    <div class="p-6">
      <div class="flex justify-between items-start gap-4 mb-4">
        <div>
          <h2
            id="scheduleModalSpeakerName"
            class="text-2xl font-bold"
          ></h2>

          <p
            id="scheduleModalSpeakerRole"
            class="text-sm text-slate-600 mt-1"
          ></p>

          <p
            id="scheduleModalSpeakerCompany"
            class="text-sm text-slate-600"
          ></p>
        </div>

        <button
          type="button"
          id="scheduleCloseModalBtn"
          class="flex-shrink-0 text-slate-500 hover:text-slate-900 text-3xl leading-none p-1"
          aria-label="Close speaker bio"
        >
          ×
        </button>
      </div>

      <img
        id="scheduleModalSpeakerImage"
        src={PLACEHOLDER_IMAGE}
        alt=""
        width="96"
        height="96"
        class="w-24 h-24 rounded-full mb-4 object-cover"
      />

      <p
        id="scheduleModalSpeakerBio"
        class="text-slate-600 mb-4 whitespace-pre-line leading-relaxed"
      ></p>

      <a
        id="scheduleModalLinkedinLink"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-600 hover:text-blue-800 font-semibold underline underline-offset-4"
        hidden
      >
        LinkedIn ↗
      </a>
    </div>
  </dialog>
</section>

<script>
  type SessionDetails = {
    title: string;
    speaker: string;
    description: string;
    duration: string;
    track: string;
    type: string;
  };

  function parseTime(time: string) {
    const match = time.match(/(\d+):(\d+)\s*(AM|PM)/i);
    if (!match) return null;

    let hours = Number(match[1]);
    const minutes = Number(match[2]);
    const period = match[3].toUpperCase();

    if (period === "PM" && hours !== 12) hours += 12;
    if (period === "AM" && hours === 12) hours = 0;

    return { hours, minutes };
  }

  function formatUtcDate(date: Date) {
    return date.toISOString().replace(/[-:]/g, "").split(".")[0] + "Z";
  }

  function escapeIcsText(value: string) {
    return value
      .replace(/\\/g, "\\\\")
      .replace(/\r?\n/g, "\\n")
      .replace(/,/g, "\\,")
      .replace(/;/g, "\\;");
  }

  function addToCalendar(row: HTMLTableRowElement) {
    const {
      title = "",
      speaker = "",
      time = "",
      duration = "60",
      location = "",
      description = "",
    } = row.dataset;

    const parsedTime = parseTime(time);

    if (!parsedTime) {
      alert("Unable to parse session time.");
      return;
    }

    const durationMinutes = Number.parseInt(duration, 10) || 60;

    // November 21, 2026, Windsor (EST, UTC−5).
    const startDate = new Date(
      Date.UTC(2026, 10, 21, parsedTime.hours + 5, parsedTime.minutes),
    );

    const endDate = new Date(
      startDate.getTime() + durationMinutes * 60_000,
    );

    const details = `Speaker: ${speaker}\n\n${description}`;
    const previousFocus = document.activeElement as HTMLElement | null;

    const dialog = document.createElement("dialog");
    dialog.className = "schedule-calendar-dialog";
    dialog.setAttribute("aria-label", "Add to Calendar");

    const heading = document.createElement("h3");
    heading.className = "text-lg font-semibold text-gray-900 mb-2";
    heading.textContent = "Add to Calendar";

    const titleText = document.createElement("p");
    titleText.className = "text-sm text-gray-600 mb-5";
    titleText.textContent = title;

    const googleButton = document.createElement("button");
    googleButton.type = "button";
    googleButton.className =
      "w-full px-4 py-3 mb-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium";
    googleButton.textContent = "Add to Google Calendar";

    const appleButton = document.createElement("button");
    appleButton.type = "button";
    appleButton.className =
      "w-full px-4 py-3 mb-2 bg-gray-700 hover:bg-gray-800 text-white rounded-md font-medium";
    appleButton.textContent = "Add to Apple Calendar";

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.className =
      "w-full px-4 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md font-medium";
    cancelButton.textContent = "Cancel";

    dialog.append(
      heading,
      titleText,
      googleButton,
      appleButton,
      cancelButton,
    );

    document.body.append(dialog);

    dialog.addEventListener("close", () => {
      dialog.remove();
      previousFocus?.focus();
    });

    googleButton.addEventListener("click", () => {
      const url =
        "https://calendar.google.com/calendar/render?action=TEMPLATE" +
        `&text=${encodeURIComponent(title)}` +
        `&dates=${formatUtcDate(startDate)}/${formatUtcDate(endDate)}` +
        `&location=${encodeURIComponent(location)}` +
        `&details=${encodeURIComponent(details)}`;

      window.open(url, "_blank", "noopener,noreferrer");
      dialog.close();
    });

    appleButton.addEventListener("click", () => {
      const icsContent = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Google DevFest Windsor//NONSGML v1.0//EN",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "BEGIN:VEVENT",
        `UID:devfest-${Date.now()}@googledevfest.local`,
        `DTSTAMP:${formatUtcDate(new Date())}`,
        `DTSTART:${formatUtcDate(startDate)}`,
        `DTEND:${formatUtcDate(endDate)}`,
        `SUMMARY:${escapeIcsText(title)}`,
        `DESCRIPTION:${escapeIcsText(details)}`,
        `LOCATION:${escapeIcsText(location)}`,
        "STATUS:CONFIRMED",
        "END:VEVENT",
        "END:VCALENDAR",
        "",
      ].join("\r\n");

      const blob = new Blob([icsContent], {
        type: "text/calendar;charset=utf-8",
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = `${title.replace(/[^a-z0-9]+/gi, "-")}.ics`;

      document.body.append(link);
      link.click();
      link.remove();

      setTimeout(() => URL.revokeObjectURL(url), 1000);
      dialog.close();
    });

    cancelButton.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;

      const rect = dialog.getBoundingClientRect();

      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      ) {
        dialog.close();
      }
    });

    dialog.showModal();
  }

  function initializeSchedule() {
    const root = document.querySelector<HTMLElement>("#schedule");

    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const speakerModal =
      root.querySelector<HTMLDialogElement>("#schedulespeakerModal");

    function openSpeakerModal(element: HTMLElement) {
      if (!speakerModal) return;

      const {
        speakerName = "",
        speakerRole = "",
        speakerCompany = "",
        speakerBio = "",
        speakerLinkedin = "",
        speakerImage = "/google-person.png",
      } = element.dataset;

      const setText = (selector: string, value: string) => {
        const target = speakerModal.querySelector<HTMLElement>(selector);
        if (target) target.textContent = value;
      };

      setText("#scheduleModalSpeakerName", speakerName);
      setText("#scheduleModalSpeakerRole", speakerRole);
      setText("#scheduleModalSpeakerCompany", speakerCompany);
      setText("#scheduleModalSpeakerBio", speakerBio);

      const image = speakerModal.querySelector<HTMLImageElement>(
        "#scheduleModalSpeakerImage",
      );

      if (image) {
        image.src = speakerImage;
        image.alt = speakerName;
      }

      const linkedin = speakerModal.querySelector<HTMLAnchorElement>(
        "#scheduleModalLinkedinLink",
      );

      if (linkedin) {
        linkedin.hidden = !speakerLinkedin;

        if (speakerLinkedin) {
          linkedin.href = speakerLinkedin;
        } else {
          linkedin.removeAttribute("href");
        }
      }

      if (!speakerModal.open) speakerModal.showModal();
    }

    root
      .querySelectorAll<HTMLElement>(".speaker-schedule-trigger")
      .forEach((element) => {
        element.addEventListener("click", (event) => {
          event.stopPropagation();
          openSpeakerModal(element);
        });
      });

    root
      .querySelector("#scheduleCloseModalBtn")
      ?.addEventListener("click", () => speakerModal?.close());

    speakerModal?.addEventListener("click", (event) => {
      if (event.target !== speakerModal) return;

      const rect = speakerModal.getBoundingClientRect();

      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      ) {
        speakerModal.close();
      }
    });

    const sessionRows =
      root.querySelectorAll<HTMLTableRowElement>(".session-row");

    sessionRows.forEach((row) => {
      row.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (
          target.closest(
            ".add-to-calendar-btn, .speaker-schedule-trigger, .room-link",
          )
        ) {
          return;
        }

        const openSessionModal = (
          window as Window & {
            openSessionModal?: (details: SessionDetails) => void;
          }
        ).openSessionModal;

        openSessionModal?.({
          title: row.dataset.title || "",
          speaker: row.dataset.speaker || "",
          description: row.dataset.description || "",
          duration: row.dataset.duration || "",
          track: row.dataset.track || "",
          type: row.dataset.type || "",
        });
      });

      row
        .querySelector<HTMLButtonElement>(".add-to-calendar-btn")
        ?.addEventListener("click", (event) => {
          event.stopPropagation();
          addToCalendar(row);
        });
    });

    const filterButtons =
      root.querySelectorAll<HTMLButtonElement>(".track-filter-btn");

    function applyFilter(selectedTrack: string) {
      filterButtons.forEach((button) => {
        const active = button.dataset.track === selectedTrack;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      sessionRows.forEach((row) => {
        const visible =
          selectedTrack === "ALL" ||
          row.dataset.track === selectedTrack ||
          row.dataset.track === "ALL";

        row.classList.toggle("hidden", !visible);
      });
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedTrack = button.dataset.track;
        if (selectedTrack) applyFilter(selectedTrack);
      });
    });

    applyFilter(root.dataset.defaultTrack || "Google Cloud");
  }

  initializeSchedule();
  document.addEventListener("astro:page-load", initializeSchedule);
</script>

