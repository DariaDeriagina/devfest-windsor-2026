            data-track={track.name}
            aria-pressed={track.name === DEFAULT_TRACK}
          >
            <span set:html={icons[track.icon]} />
            {track.name}
          </button>
        ))
      }
    </div>

    <!-- Schedule table -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b-2 border-gray-200">
            <th class="text-left py-4 px-4 font-semibold text-gray-900">
              TIME
            </th>
            <th class="text-left py-4 px-4 font-semibold text-gray-900">
              SESSION
            </th>
            <th
              class="text-left py-4 px-4 font-semibold text-gray-900 hidden md:table-cell"
            >
              LOCATION
            </th>
            <th class="text-center py-4 px-4 font-semibold text-gray-900">
              ADD
            </th>
          </tr>
        </thead>

        <tbody>
          {
            sessions.map((session) => {
              const speakerData = getSpeakerData(session.speaker);

              const accent =
                accentStyles[speakerData?.accentColor || "blue"] ||
                accentStyles.blue;

              const track = tracks.find(
