              );

              const speakerImage =
                speakerData?.imageUrl || PLACEHOLDER_IMAGE;

              return (
                <tr
                  class={`session-row border-b border-gray-100 hover:bg-gray-50 transition-colors cursor-pointer ${session.track === DEFAULT_TRACK ? "" : "hidden"}`}
                  data-track={session.track}
                  data-title={session.title}
                  data-speaker={session.speaker}
                  data-description={session.description}
                  data-duration={session.duration}
                  data-type={session.type}
                  data-time={session.time}
                  data-location={session.location}
