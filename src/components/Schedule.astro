import { t } from "@lib/i18n";
import SessionModal from "./SessionModal.astro";
import { FEATURED_SPEAKERS } from "@config/speakers.config";
import { SUBMITTED_SESSIONS } from "@config/sessions.config";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const finalTitle = title || t("en", "schedule.title");
const finalDescription =
  description || t("en", "schedule.description");

const DEFAULT_TRACK = "Google Cloud";
const PLACEHOLDER_IMAGE = "/google-person.png";

const normalizeSpeakerName = (name: string) =>
  name.trim().toLowerCase();

const getSpeakerData = (speakerName: string) => {
  if (
    !speakerName ||
    ["TBD", "Community", "Google DevFest Team"].includes(speakerName)
  ) {
    return null;
  }

  // For joint sessions, use the first speaker's image and bio.
  const primaryName = speakerName.split(" / ")[0].trim();

  return (
    FEATURED_SPEAKERS.find(
      (speaker) =>
        normalizeSpeakerName(speaker.name) ===
        normalizeSpeakerName(primaryName),
    ) || null
  );
};

