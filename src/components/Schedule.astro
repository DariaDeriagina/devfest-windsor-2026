                                data-speaker-company={speakerData.company}
                                data-speaker-bio={speakerData.bio || ""}
                                data-speaker-linkedin={
                                  speakerData.linkedinUrl || ""
                                }
                                data-speaker-image={speakerImage}
                              />
                            </>
                          ) : (
