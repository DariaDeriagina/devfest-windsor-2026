// Load submitted titles and abstracts into the scheduled slots.
// Times, rooms, tracks, types, and slot durations come from the schedule.
const abstractsBySpeaker = new Map(
  SUBMITTED_SESSIONS.map((session) => [
    normalizeSpeakerName(session.speaker),
    session,
  ]),
);

const sessions = scheduledSessions.map((session) => {
  const abstract = abstractsBySpeaker.get(
    normalizeSpeakerName(session.speaker),
  );

  if (!abstract) return session;

  return {
    ...session,
    title: abstract.title,
    speaker: abstract.speaker,
    description: abstract.description,
  };
});

