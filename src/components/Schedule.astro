</section>

<script>
  type SessionRow = HTMLTableRowElement;

  type SessionDetails = {
    title: string;
    speaker: string;
    description: string;
    duration: string;
    track: string;
    type: string;
  };

  function parseTime(timeStr: string) {
    const match = timeStr.match(/(\d+):(\d+)\s(AM|PM)/);

    if (!match) return null;

    let hours = Number(match[1]);
    const minutes = Number(match[2]);

    if (match[3] === "PM" && hours !== 12) hours += 12;
    if (match[3] === "AM" && hours === 12) hours = 0;

    return { hours, minutes };
  }

  function formatUtcDate(date: Date) {
    return date.toISOString().replace(/[-:]/g, "").split(".")[0] + "Z";
  }

  function escapeIcsText(value: string) {
    return value
      .replace(/\\/g, "\\\\")
      .replace(/\r?\n/g, "\\n")
      .replace(/,/g, "\\,")
      .replace(/;/g, "\\;");
  }

  function addToCalendar(row: SessionRow) {
    const { title, speaker, time, duration, location, description } =
      row.dataset;

    const parsedTime = parseTime(time || "");

    if (!parsedTime) {
      alert("Unable to parse session time");
      return;
    }

    const sessionTitle = title || "";
    const sessionSpeaker = speaker || "";
    const sessionLocation = location || "";
    const sessionDescription = description || "";
    const durationMinutes = Number.parseInt(duration || "60", 10) || 60;

    // November 21, 2026 in Windsor: EST, UTC−5.
    const startDate = new Date(
      Date.UTC(
        2026,
        10,
        21,
        parsedTime.hours + 5,
        parsedTime.minutes,
      ),
    );

    const endDate = new Date(
      startDate.getTime() + durationMinutes * 60_000,
    );

    const overlay = document.createElement("div");
    overlay.className =
      "fixed inset-0 z-[1000] bg-black/50 flex items-center justify-center p-4";

    const panel = document.createElement("div");
    panel.className =
      "bg-white rounded-xl p-6 shadow-xl max-w-sm w-full";

    const heading = document.createElement("h3");
    heading.className = "text-lg font-semibold text-gray-900 mb-2";
    heading.textContent = "Add to Calendar";

    const titleText = document.createElement("p");
    titleText.className = "text-sm text-gray-600 mb-5";
    titleText.textContent = sessionTitle;

    const googleButton = document.createElement("button");
    googleButton.type = "button";
    googleButton.className =
      "w-full px-4 py-3 mb-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium";
    googleButton.textContent = "Add to Google Calendar";

    const appleButton = document.createElement("button");
    appleButton.type = "button";
    appleButton.className =
      "w-full px-4 py-3 mb-2 bg-gray-700 hover:bg-gray-800 text-white rounded-md font-medium";
    appleButton.textContent = "Add to Apple Calendar";

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.className =
      "w-full px-4 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md font-medium";
    cancelButton.textContent = "Cancel";

    panel.append(
      heading,
      titleText,
      googleButton,
      appleButton,
      cancelButton,
    );

    overlay.append(panel);
    document.body.append(overlay);

    googleButton.addEventListener("click", () => {
      const details =
        `Speaker: ${sessionSpeaker}\n\n${sessionDescription}`;

      const url =
        "https://calendar.google.com/calendar/render?action=TEMPLATE" +
        `&text=${encodeURIComponent(sessionTitle)}` +
        `&dates=${formatUtcDate(startDate)}/${formatUtcDate(endDate)}` +
        `&location=${encodeURIComponent(sessionLocation)}` +
        `&details=${encodeURIComponent(details)}`;

      window.open(url, "_blank", "noopener,noreferrer");
      overlay.remove();
    });

    appleButton.addEventListener("click", () => {
      const icsContent = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Google DevFest Windsor//NONSGML v1.0//EN",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "BEGIN:VEVENT",
        `UID:devfest-${Date.now()}@googledevfest.local`,
        `DTSTAMP:${formatUtcDate(new Date())}`,
        `DTSTART:${formatUtcDate(startDate)}`,
        `DTEND:${formatUtcDate(endDate)}`,
        `SUMMARY:${escapeIcsText(sessionTitle)}`,
        `DESCRIPTION:${escapeIcsText(
          `Speaker: ${sessionSpeaker}\n\n${sessionDescription}`,
        )}`,
        `LOCATION:${escapeIcsText(sessionLocation)}`,
        "STATUS:CONFIRMED",
        "END:VEVENT",
        "END:VCALENDAR",
        "",
      ].join("\r\n");

      const blob = new Blob([icsContent], {
        type: "text/calendar;charset=utf-8",
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download =
        `${sessionTitle.replace(/[^a-z0-9]+/gi, "-")}.ics`;

      document.body.append(link);
      link.click();
      link.remove();

      setTimeout(() => URL.revokeObjectURL(url), 1000);
      overlay.remove();
    });

    cancelButton.addEventListener("click", () => overlay.remove());

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) overlay.remove();
    });
  }

  const speakerModal = document.getElementById(
    "schedulespeakerModal",
  );

  function openSpeakerModal(element: HTMLElement) {
    const {
      speakerName = "",
      speakerRole = "",
      speakerCompany = "",
      speakerBio = "",
      speakerLinkedin = "",
      speakerImage = "",
    } = element.dataset;

    const nameElement = document.getElementById(
      "scheduleModalSpeakerName",
    );

    const roleElement = document.getElementById(
      "scheduleModalSpeakerRole",
    );

    const companyElement = document.getElementById(
      "scheduleModalSpeakerCompany",
    );

    const bioElement = document.getElementById(
      "scheduleModalSpeakerBio",
    );

    const imageElement = document.getElementById(
      "scheduleModalSpeakerImage",
    ) as HTMLImageElement | null;

    const linkedinElement = document.getElementById(
      "scheduleModalLinkedinLink",
    ) as HTMLAnchorElement | null;

    if (nameElement) nameElement.textContent = speakerName;
    if (roleElement) roleElement.textContent = speakerRole;
    if (companyElement) companyElement.textContent = speakerCompany;
    if (bioElement) bioElement.textContent = speakerBio;

    if (imageElement) {
      imageElement.src = speakerImage;
      imageElement.alt = speakerName;
    }

    if (linkedinElement) {
      linkedinElement.href = speakerLinkedin;
      linkedinElement.style.display = speakerLinkedin
        ? "inline-flex"
        : "none";
    }

    speakerModal?.classList.remove("hidden");
  }

  document
    .querySelectorAll<HTMLElement>(
      ".speaker-schedule-image, .speaker-schedule-bio-btn",
    )
    .forEach((element) => {
      element.addEventListener("click", (event) => {
        event.stopPropagation();
        openSpeakerModal(element);
      });
    });

  document
    .getElementById("scheduleCloseModalBtn")
    ?.addEventListener("click", () => {
      speakerModal?.classList.add("hidden");
    });

  speakerModal?.addEventListener("click", (event) => {
    if (event.target === speakerModal) {
      speakerModal.classList.add("hidden");
    }
  });

  const sessionRows = document.querySelectorAll<SessionRow>(
    "#schedule .session-row",
  );

  sessionRows.forEach((row) => {
    row.addEventListener("click", (event) => {
      if (
        (event.target as HTMLElement).closest(
          ".add-to-calendar-btn, .speaker-schedule-image, .speaker-schedule-bio-btn",
        )
      ) {
        return;
      }

      const openSessionModal = (
        window as Window & {
          openSessionModal?: (details: SessionDetails) => void;
        }
      ).openSessionModal;

      openSessionModal?.({
        title: row.dataset.title || "",
        speaker: row.dataset.speaker || "",
        description: row.dataset.description || "",
        duration: row.dataset.duration || "",
        track: row.dataset.track || "",
        type: row.dataset.type || "",
      });
    });

    row
      .querySelector<HTMLButtonElement>(".add-to-calendar-btn")
      ?.addEventListener("click", (event) => {
        event.stopPropagation();
        addToCalendar(row);
      });
  });

  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    "#schedule .track-filter-btn",
  );

  // Matches the initially visible rows and highlighted button.
  let selectedTrack: string | null = "Google Cloud";

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const clickedTrack = button.dataset.track;

      if (!clickedTrack) return;

      selectedTrack =
        clickedTrack === "ALL" || selectedTrack === clickedTrack
          ? null
          : clickedTrack;

      filterButtons.forEach((filterButton) => {
        const isActive =
          filterButton.dataset.track === selectedTrack;

        filterButton.classList.toggle("active", isActive);
        filterButton.setAttribute(
          "aria-pressed",
          String(isActive),
        );
      });

      sessionRows.forEach((row) => {
        const visible =
          selectedTrack === null ||
          row.dataset.track === selectedTrack;

        row.classList.toggle("hidden", !visible);
      });

      document
        .querySelector("#schedule table")
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
    });
  });
</script>

