                                class={`speaker-schedule-image relative w-full h-full rounded-full object-cover ring-2 ring-white shadow-md transition-all duration-300 group-hover:scale-110 cursor-pointer ${accent.ring}`}
                                data-speaker-name={speakerData.name}
