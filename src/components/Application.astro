---
import { t } from "@lib/i18n";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Download Our DevFest App",
  description = "Get the official DevFest Windsor 2026 mobile application for the best conference experience. Access schedules, speaker bios, networking features, and real-time updates all in one place.",
} = Astro.props;
---

<section id="application" class="py-20 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 animate-fade-in-up">
      <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">
        Our Application
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-slate-900 mb-4 mt-6">
        {title}
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed max-w-3xl mt-1">
        {description}
      </p>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left side: App Illustration -->
      <div class="flex justify-center">
        <img 
          src="/MobileApp.png" 
          alt="DevFest App on Mobile" 
          class="w-full max-w-sm h-auto drop-shadow-lg"
        />
      </div>

      <!-- Right side: Coming Soon Message -->
      <div class="flex flex-col justify-center">
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 border border-blue-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-3 h-3 rounded-full bg-blue-600 animate-pulse"></div>
            <span class="text-sm font-semibold text-blue-600 uppercase tracking-wide">
              Coming Soon
            </span>
          </div>
          
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
            Something Exciting is Coming
          </h3>
          
          <p class="text-slate-600 leading-relaxed mb-6">
            We're building an amazing mobile experience for DevFest Windsor 2026. The official app will give you instant access to the schedule, speaker information, interactive networking features, and live updates throughout the event.
          </p>
          
          <div class="space-y-3 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-slate-600" data-i18n="application.features.schedule">Full event schedule with track filtering</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-slate-600" data-i18n="application.features.speakers">Speaker profiles and abstracts</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-slate-600" data-i18n="application.features.networking">Networking and attendee directory</span>
            </div>
          </div>
          
          <p class="text-sm text-slate-500">
            Check back soon for the app link and QR code. We'll announce the launch on our social channels!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
