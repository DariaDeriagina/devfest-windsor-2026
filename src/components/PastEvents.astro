---
const pastEvents = [
  {
    year: "2025",
    url: "https://dariaderiagina.github.io/GDGWindsor-Dev-Fest-2025/",
    accentColor: "#EA4335",
  },
  {
    year: "2024",
    url: "https://dariaderiagina.github.io/DevFestWindsor2024/",
    accentColor: "#FBBC04",
  },
];
---

<section class="bg-white py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-12 text-center">
      Past Events
    </h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
      {pastEvents.map((event) => (
        <a
          href={event.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-lg p-6 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
          style={{
            backgroundColor: event.accentColor + "15",
            borderLeft: `4px solid ${event.accentColor}`,
          }}
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-5 transition-opacity duration-300"
            style={{ backgroundColor: event.accentColor }}
          ></div>

          <div class="relative z-10 flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600 font-medium">Google Dev Fest</p>
              <p class="text-2xl font-bold text-gray-900">{event.year}</p>
            </div>

            <div
              class="transform transition-transform group-hover:translate-x-2 duration-300"
              style={{ color: event.accentColor }}
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                ></path>
              </svg>
            </div>
          </div>

          <div
            class="absolute bottom-0 left-0 h-1 w-0 transition-all duration-300 group-hover:w-full"
            style={{ backgroundColor: event.accentColor }}
          ></div>
        </a>
      ))}
    </div>
  </div>
</section>