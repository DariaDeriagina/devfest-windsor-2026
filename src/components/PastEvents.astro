---
const pastEvents = [
  {
    year: "2024",
    url: "https://dariaderiagina.github.io/DevFestWindsor2024/",
    accentColor: "#FBBC04",
    backgroundColor: "#FFFBEB",
  },
  {
    year: "2025",
    url: "https://dariaderiagina.github.io/GDGWindsor-Dev-Fest-2025/",
    accentColor: "#EA4335",
    backgroundColor: "#FFF5F3",
  },
];
---

<section
  id="past-events"
  class="bg-white py-16 sm:py-20"
  aria-labelledby="past-events-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Left-aligned section header -->
    <div class="mb-10 text-left">
      <span
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
      >
        Our Journey
      </span>

      <div class="section-color-lines" aria-hidden="true">
        <span class="bg-blue-600"></span>
        <span class="bg-red-600"></span>
        <span class="bg-yellow-400"></span>
        <span class="bg-green-600"></span>
      </div>

      <h2
        id="past-events-title"
        class="text-4xl sm:text-5xl font-bold text-slate-900"
      >
        Past Events
      </h2>
    </div>

    <!-- Man / 2024 / 2025 / Woman -->
    <div class="past-events-composition">
      <div class="character character-left" aria-hidden="true">
        <img
          src="/personLookBack2024.png"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="event-links">
        {
          pastEvents.map((event) => (
            <a
              href={event.url}
              target="_blank"
              rel="noopener noreferrer"
              class="event-card"
              style={{
                "--event-accent": event.accentColor,
                "--event-background": event.backgroundColor,
              }}
            >
              <div class="event-copy">
                <span class="event-organizer">GDG Windsor</span>

                <h3 class="event-title">
                  DevFest
                  <span class="event-year">{event.year}</span>
                </h3>

                <span class="event-label">
                  Explore the event
                  <span class="sr-only"> (opens in a new tab)</span>
                </span>
              </div>

              <span class="event-arrow" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <div class="character character-right" aria-hidden="true">
        <img
          src="/personLookBack2025.png"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  #past-events {
    scroll-margin-top: 6rem;
  }

  .section-color-lines {
    display: flex;
    gap: 0.5rem;
    width: min(100%, 24rem);
    margin: 1.5rem 0;
  }

  .section-color-lines span {
    flex: 1;
    height: 0.375rem;
    border-radius: 9999px;
  }

  .past-events-composition {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 2.4fr)
      minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    width: 100%;
  }

  .character {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .character img {
    display: block;
    width: 100%;
    height: clamp(180px, 22vw, 290px);
    object-fit: contain;
  }

  .event-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    min-width: 0;
  }

  .event-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--event-accent);
    border-radius: 1rem;
    background: var(--event-background);
    color: #0f172a;
    text-decoration: none;
    transition:
      transform 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .event-copy {
    min-width: 0;
  }

  .event-organizer {
    display: block;
    margin-bottom: 0.625rem;
    color: #64748b;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .event-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .event-year {
    display: block;
    margin-top: 0.25rem;
    font-size: 2.25rem;
    letter-spacing: -0.04em;
  }

  .event-label {
    display: block;
    margin-top: 1rem;
    color: #475569;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .event-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: #fff;
    color: #334155;
    transition: transform 250ms ease;
  }

  .event-card:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 5px;
  }

  @media (hover: hover) {
    .event-card:hover {
      transform: translateY(-4px);
      border-color: var(--event-accent);
      box-shadow: 0 12px 28px -18px rgb(15 23 42 / 30%);
    }

    .event-card:hover .event-arrow {
      transform: translate(2px, -2px);
    }

    .event-card:hover .event-label {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 1023px) {
    .event-links {
      gap: 0.75rem;
    }

    .event-card {
      padding: 1.25rem 1rem;
    }

    .event-arrow {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  @media (max-width: 767px) {
    .past-events-composition {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 2.2fr)
        minmax(0, 1fr);
      gap: 0.5rem;
    }

    .event-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .character img {
      height: 190px;
    }

    .event-card {
      padding: 1rem 0.75rem;
      gap: 0.375rem;
      border-radius: 0.875rem;
    }

    .event-organizer {
      font-size: 0.6875rem;
      margin-bottom: 0.375rem;
    }

    .event-title {
      font-size: 1rem;
    }

    .event-year {
      font-size: 1.75rem;
    }

    .event-label {
      margin-top: 0.625rem;
      font-size: 0.6875rem;
    }

    .event-arrow svg {
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    .event-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>