---
const pastEvents = [
  {
    year: "2025",
    url: "https://dariaderiagina.github.io/GDGWindsor-Dev-Fest-2025/",
    image: "/personLookBack2025.png",
    accentColor: "#EA4335",
    backgroundColor: "#FFF5F3",
  },
  {
    year: "2024",
    url: "https://dariaderiagina.github.io/DevFestWindsor2024/",
    image: "/personLookBack2024.png",
    accentColor: "#FBBC04",
    backgroundColor: "#FFFBEB",
  },
];
---

<section
  id="past-events"
  class="bg-white py-16 sm:py-20"
  aria-labelledby="past-events-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-10 text-left">
      <span
        class="text-sm font-bold tracking-widest text-blue-600 uppercase"
      >
        Our Journey
      </span>

      <div class="section-color-lines" aria-hidden="true">
        <span class="bg-blue-600"></span>
        <span class="bg-red-600"></span>
        <span class="bg-yellow-400"></span>
        <span class="bg-green-600"></span>
      </div>

      <h2
        id="past-events-title"
        class="text-4xl sm:text-5xl font-bold text-slate-900"
      >
        Past Events
      </h2>
    </div>

    <!-- Compact Event Cards -->
    <div class="events-grid">
      {
        pastEvents.map((event) => (
          <a
            href={event.url}
            target="_blank"
            rel="noopener noreferrer"
            class="event-card"
            style={{
              "--event-accent": event.accentColor,
              "--event-background": event.backgroundColor,
            }}
          >
            <div class="event-artwork">
              <img
                src={event.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="event-image"
              />
            </div>

            <div class="event-details">
              <div>
                <p class="event-organizer">GDG Windsor</p>

                <h3 class="event-title">
                  DevFest {event.year}
                </h3>

                <p class="event-link-label">
                  Explore the event
                  <span class="sr-only"> (opens in a new tab)</span>
                </p>
              </div>

              <span class="event-arrow" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #past-events {
    scroll-margin-top: 6rem;
  }

  .section-color-lines {
    display: flex;
    gap: 0.5rem;
    width: min(100%, 24rem);
    margin: 1.5rem 0;
  }

  .section-color-lines span {
    flex: 1;
    height: 0.375rem;
    border-radius: 9999px;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 48rem;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    background: var(--event-background);
    text-decoration: none;
    transition:
      transform 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .event-card:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 5px;
  }

  .event-artwork {
    height: 230px;
    padding: 1rem;
  }

  .event-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 250ms ease;
  }

  .event-details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 1.25rem;
    border-bottom: 4px solid var(--event-accent);
    background: #fff;
  }

  .event-organizer {
    margin: 0 0 0.375rem;
    color: #64748b;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .event-title {
    margin: 0;
    color: #0f172a;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .event-link-label {
    margin: 0.75rem 0 0;
    color: #475569;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .event-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
    background: var(--event-background);
    color: #0f172a;
    transition:
      transform 250ms ease,
      border-color 250ms ease;
  }

  @media (hover: hover) {
    .event-card:hover {
      transform: translateY(-4px);
      border-color: var(--event-accent);
      box-shadow: 0 12px 28px -16px rgb(15 23 42 / 25%);
    }

    .event-card:hover .event-image {
      transform: translateY(-3px);
    }

    .event-card:hover .event-arrow {
      transform: translate(2px, -2px);
      border-color: var(--event-accent);
    }

    .event-card:hover .event-link-label {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 639px) {
    .events-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 24rem;
      gap: 1.25rem;
    }

    .event-artwork {
      height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    .event-image,
    .event-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>