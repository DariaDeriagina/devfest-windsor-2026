---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: "What is DevFest Windsor?",
    answer: "DevFest Windsor is a community-led developer conference hosted by GDG Windsor. It brings together developers, designers, students, and tech enthusiasts to learn, share, and build the future together.",
  },
  {
    question: "Who can attend DevFest Windsor?",
    answer: "Everyone is welcome! Whether you're a beginner or experienced developer, student, designer, or tech enthusiast, DevFest Windsor is for you. No prior experience is required.",
  },
  {
    question: "Is DevFest Windsor free to attend?",
    answer: "DevFest Windsor offers both free and paid ticket options. Standard tickets are priced affordably to ensure accessibility. Check our Tickets section for current pricing and available options.",
  },
  {
    question: "Where and when is it happening?",
    answer: "DevFest Windsor 2026 is happening on November 21, 2026 at the University of Windsor, Ontario. Visit our Venue page for more details on location, parking, and public transit options.",
  },
  {
    question: "What should I bring?",
    answer: "Bring a valid ID for registration, comfortable clothing, a notebook, and an open mind! We'll provide lunch, snacks, and refreshments throughout the day.",
  },
  {
    question: "Will the sessions be recorded?",
    answer: "Yes! Most sessions will be recorded and made available to attendees after the event. You'll receive links to all recordings in your post-event email.",
  },
  {
    question: "How can I get involved as a sponsor or partner?",
    answer: "We'd love to have your organization as a sponsor! Please reach out to our team at devfest@windsor.com with your sponsorship inquiry.",
  },
];
---

<section class="relative min-h-screen bg-white pt-32 pb-20 overflow-hidden animate-fade-in">
  <!-- Decorative background shapes -->
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -ml-40 -mt-40 animate-float"></div>
  <div class="absolute top-20 right-0 w-96 h-96 bg-yellow-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -mr-48 -mt-48 animate-float" style="animation-delay: 2s;"></div>
  <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-green-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -mb-40 animate-float" style="animation-delay: 4s;"></div>

  <!-- Decorative dot patterns -->
  <div class="absolute top-20 left-10 grid grid-cols-4 gap-2 animate-fade-in-up">
    {[...Array(16)].map(() => (
      <div class="w-1 h-1 bg-blue-400 rounded-full opacity-40"></div>
    ))}
  </div>

  <!-- Decorative red square -->
  <div class="absolute bottom-20 right-10 w-16 h-16 bg-red-500 rounded-lg opacity-10 transform -rotate-12"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Left Sidebar -->
      <div class="animate-slide-in-left sticky top-32">
        <div class="mb-8">
          <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">FAQ</span>
          <h2 class="text-5xl font-bold text-slate-900 leading-tight mb-4">
            Frequently<br />Asked<br />Questions
          </h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-8">
            Find answers to common questions about DevFest Windsor 2026.
          </p>
        </div>

        <!-- Decorative Lines -->
        <div class="flex gap-2 mb-8">
          <div class="w-12 h-1 bg-blue-600 rounded-full"></div>
          <div class="w-12 h-1 bg-red-600 rounded-full"></div>
          <div class="w-12 h-1 bg-yellow-400 rounded-full"></div>
        </div>

        <!-- Contact Card -->
        <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl p-6 text-white animate-scale-in">
          <div class="flex items-start gap-3 mb-4">
            <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <div>
              <h4 class="font-bold text-lg mb-1">Can't find your answer?</h4>
              <p class="text-blue-100 text-sm mb-4">Contact our support team for help</p>
              <button
                class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-blue-50 transition-colors cursor-pointer"
                onclick={`alert('Contact us at:\\n\\nEmail: devfest@windsor.com\\nPhone: (519) 555-0100')`}
              >
                Contact us
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Accordion -->
      <div class="animate-slide-in-right space-y-4">
        {faqs.map((item, index) => (
          <details
            class="group border-2 border-slate-200 rounded-xl overflow-hidden hover:border-blue-400 transition-colors cursor-pointer animate-fade-in-up"
            style={`animation-delay: ${index * 0.1}s;`}
            open={index === 0}
          >
            <summary class="flex items-center justify-between p-6 bg-white hover:bg-slate-50 transition-colors">
              <h3 class="text-lg font-bold text-slate-900">{item.question}</h3>
              <svg class="w-5 h-5 text-blue-600 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 bg-slate-50 border-t-2 border-slate-200 animate-fade-in-up">
              <p class="text-slate-600 leading-relaxed">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
