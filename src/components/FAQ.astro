
---
import { t } from "@lib/i18n";
import en from "../locales/en.json";
import fr from "../locales/fr.json";

interface FAQItem {
  question: string;
  answer: string;
}

const lang = "en";

const faqItems = en.faq.items as FAQItem[];
const frenchFaqItems = fr.faq.items as FAQItem[];
---

<section
  id="faq"
  class="relative min-h-screen bg-white pt-32 pb-20 overflow-hidden animate-fade-in"
  aria-labelledby="faq-title"
>
  <!-- DECORATIVE BACKGROUND SHAPES -->
  <div
    class="absolute top-0 left-0 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -ml-40 -mt-40 animate-float pointer-events-none"
    aria-hidden="true"
  ></div>

  <div
    class="absolute top-20 right-0 w-96 h-96 bg-yellow-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -mr-48 -mt-48 animate-float pointer-events-none"
    style="animation-delay: 2s;"
    aria-hidden="true"
  ></div>

  <div
    class="absolute bottom-0 left-1/3 w-80 h-80 bg-green-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -z-10 -mb-40 animate-float pointer-events-none"
    style="animation-delay: 4s;"
    aria-hidden="true"
  ></div>

  <!-- DECORATIVE DOT PATTERN -->
  <div
    class="absolute top-20 left-10 grid grid-cols-4 gap-2 animate-fade-in-up pointer-events-none"
    aria-hidden="true"
  >
    {
      Array.from({ length: 16 }, () => (
        <div class="w-1 h-1 bg-blue-400 rounded-full opacity-40"></div>
      ))
    }
  </div>

  <!-- DECORATIVE RED SQUARE -->
  <div
    class="absolute bottom-20 right-10 w-16 h-16 bg-red-500 rounded-lg opacity-10 transform -rotate-12 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- MAIN CONTENT -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12 items-start">

      <!-- LEFT SIDEBAR -->
      <div class="animate-slide-in-left md:sticky md:top-32">
        <div class="mb-8">

          <span
            class="text-blue-600 font-semibold text-sm uppercase tracking-wider"
          >
            FAQ
          </span>

          <h2
            id="faq-title"
            class="text-4xl sm:text-5xl font-bold text-slate-900 leading-tight mb-4"
            data-i18n="faq.title"
          >
            {t(lang, "faq.title")}
          </h2>

          <p
            class="text-slate-600 text-lg leading-relaxed mb-8"
            data-i18n="faq.description"
          >
            {t(lang, "faq.description")}
          </p>
        </div>

        <!-- GOOGLE COLOR LINES -->
        <div
          class="flex gap-2 mb-8"
          aria-hidden="true"
        >
          <div class="w-12 h-1 bg-blue-600 rounded-full"></div>
          <div class="w-12 h-1 bg-red-600 rounded-full"></div>
          <div class="w-12 h-1 bg-yellow-400 rounded-full"></div>
        </div>

        <!-- CONTACT CARD -->
        <div
          class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl p-6 text-white animate-scale-in"
        >
          <div class="flex items-start gap-3 mb-4">

            <!-- EMAIL ICON -->
            <svg
              class="w-6 h-6 flex-shrink-0 mt-1"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              ></path>
            </svg>

            <div>
              <h3
                class="font-bold text-lg mb-1"
                data-i18n="faq.cantFind"
              >
                {t(lang, "faq.cantFind")}
              </h3>

              <p
                id="faq-community-text"
                class="text-blue-100 text-sm mb-4"
              >
                Join our GDG Windsor community
              </p>

              <a
                href="https://gdg.community.dev/gdg-windsor/"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-blue-50 transition-colors cursor-pointer inline-block"
                data-i18n="faq.contactUs"
              >
                {t(lang, "faq.contactUs")}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT ACCORDION -->
      <div class="animate-slide-in-right space-y-4">

        {
          faqItems.map((item, index) => {
            const isSponsorQuestion =
              index === faqItems.length - 1;

            return (
              <details
                class="faq-item group border-2 border-slate-200 rounded-xl overflow-hidden hover:border-blue-400 transition-colors animate-fade-in-up"
                style={`animation-delay: ${index * 0.1}s;`}
                open={index === 0}
                data-faq-index={index}
              >
                <summary
                  class="flex items-center justify-between gap-4 p-6 bg-white hover:bg-slate-50 transition-colors cursor-pointer"
                >
                  <h3
                    class="faq-question text-lg font-bold text-slate-900"
                    data-i18n={`faq.items.${index}.question`}
                  >
                    {item.question}
                  </h3>

                  <svg
                    class="w-5 h-5 shrink-0 text-blue-600 transition-transform duration-300 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 14l-7 7m0 0l-7-7m7 7V3"
                    ></path>
                  </svg>
                </summary>

                <div
                  class="px-6 pb-6 pt-5 bg-slate-50 border-t-2 border-slate-200"
                >
                  <div class="space-y-4">

                    <p
                      class="faq-answer text-slate-600 leading-relaxed"
                      data-i18n={`faq.items.${index}.answer`}
                    >
                      {item.answer}
                    </p>

                    {
                      isSponsorQuestion && (
                        <a
                          href="https://gdg.community.dev/gdg-windsor/"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
                          data-i18n="faq.contactUs"
                        >
                          {t(lang, "faq.contactUs")}
                        </a>
                      )
                    }
                  </div>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import enTranslations from "../locales/en.json";
  import frTranslations from "../locales/fr.json";

  type Language = "en" | "fr";

  type FAQItem = {
    question: string;
    answer: string;
  };

  const translations: Record<
    Language,
    {
      faq: {
        title: string;
        description: string;
        cantFind: string;
        contactUs: string;
        items: FAQItem[];
      };
    }
  > = {
    en: enTranslations,
    fr: frTranslations,
  };

  let currentLanguage: Language | null = null;

  function readStoredLanguage(): Language | null {
    try {
      const stored = localStorage.getItem("language");

      if (stored === "en" || stored === "fr") {
        return stored;
      }
    } catch {
      // localStorage may be unavailable.
    }

    return null;
  }

  function getCurrentLanguage(): Language {
    const stored = readStoredLanguage();

    if (stored) {
      return stored;
    }

    const documentLanguage =
      document.documentElement.lang.toLowerCase();

    return documentLanguage.startsWith("fr")
      ? "fr"
      : "en";
  }

  function updateFAQ(language: Language): void {
    const faqSection =
      document.querySelector<HTMLElement>("#faq");

    if (!faqSection) return;

    const translation = translations[language].faq;

    // Update all translated text, including FAQ questions.
    faqSection
      .querySelectorAll<HTMLElement>("[data-i18n]")
      .forEach((element) => {
        const key = element.dataset.i18n;

        if (!key) return;

        const keys = key.split(".");

        let value: unknown = translations[language];

        for (const part of keys) {
          if (
            value !== null &&
            typeof value === "object" &&
            part in value
          ) {
            value = (
              value as Record<string, unknown>
            )[part];
          } else {
            value = undefined;
            break;
          }
        }

        if (typeof value === "string") {
          element.textContent = value;
        }
      });

    // Additional text not stored in JSON.
    const communityText =
      faqSection.querySelector<HTMLElement>(
        "#faq-community-text"
      );

    if (communityText) {
      communityText.textContent =
        language === "fr"
          ? "Rejoignez notre communauté GDG Windsor"
          : "Join our GDG Windsor community";
    }

    // Keep the existing open/closed accordion states.
    currentLanguage = language;
  }

  function refreshFAQ(): void {
    const language = getCurrentLanguage();

    if (language !== currentLanguage) {
      updateFAQ(language);
    }
  }

  function initializeFAQ(): void {
    currentLanguage = null;

    refreshFAQ();
  }

  // Apply saved language when the page loads.
  initializeFAQ();

  // Listen for language switcher events.
  window.addEventListener(
    "languageChanged",
    () => {
      currentLanguage = null;
      refreshFAQ();
    }
  );

  window.addEventListener(
    "languagechange",
    () => {
      currentLanguage = null;
      refreshFAQ();
    }
  );

  // Listen for updates from another browser tab.
  window.addEventListener("storage", (event) => {
    if (event.key === "language") {
      currentLanguage = null;
      refreshFAQ();
    }
  });

  // Listen for changes to <html lang="...">.
  const languageObserver = new MutationObserver(() => {
    currentLanguage = null;
    refreshFAQ();
  });

  languageObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["lang"],
  });

  // Astro client-side navigation support.
  document.addEventListener(
    "astro:page-load",
    initializeFAQ
  );
</script>

<style>
  /* REMOVE DEFAULT ACCORDION MARKERS */

  details summary {
    list-style: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details summary::marker {
    content: "";
  }

  /* ACCORDION */

  .faq-item summary svg {
    flex-shrink: 0;
  }

  .faq-item[open] summary {
    background-color: #f8fafc;
  }

  .faq-item:focus-within {
    border-color: #3b82f6;
  }

  /* SMOOTH SCROLL TO FAQ */

  #faq {
    scroll-margin-top: 5rem;
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-item summary,
    .faq-item summary svg {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
