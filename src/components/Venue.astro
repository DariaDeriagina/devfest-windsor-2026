---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Event Venue",
  description = "Join us at the beautiful University of Windsor campus.",
} = Astro.props;
---

<section id="venue" class="py-20 bg-gradient-to-b from-white to-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 text-center">
      <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-4">
        📍 Location
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        {title}
      </h2>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Main Grid: Map + Info -->
    <div class="grid md:grid-cols-2 gap-12 items-start mb-12">
      <!-- Left: Map & Location Info -->
      <div class="animate-fadeInLeft bg-white rounded-2xl overflow-hidden shadow-lg border-4 border-blue-600">
        <!-- Map Container -->
        <div class="relative bg-slate-200 h-96 flex items-center justify-center overflow-hidden">
          <img 
            src="/univercityOfWindsorOntario.png" 
            alt="University of Windsor Campus Map"
            class="w-full h-full object-cover"
          />
          <!-- Location Badge Overlay -->
          <div class="absolute top-8 left-8 bg-white rounded-lg shadow-lg p-4 max-w-xs">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6z"></path>
              </svg>
              <div>
                <h3 class="font-bold text-slate-900">Main Event Hub</h3>
                <p class="text-sm text-slate-600 mt-1">University of Windsor</p>
                <p class="text-sm text-slate-600">401 Sunset Ave, Windsor, ON N9B 3P4</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Campus Photo -->
        <div class="p-6 bg-gradient-to-r from-blue-50 to-slate-50">
          <img 
            src="https://images.unsplash.com/photo-1553531088-be3be8a56ffb?w=400&h=250&fit=crop" 
            alt="University of Windsor Campus"
            class="w-full rounded-lg shadow-md"
          />
        </div>
      </div>

      <!-- Right: Info Cards -->
      <div class="animate-fadeInRight space-y-6">
        <!-- Getting Here -->
        <div class="bg-white rounded-xl p-8 shadow-md border-l-4 border-blue-600 hover:shadow-lg transition-shadow">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Getting Here</h3>
            </div>
          </div>
          <p class="text-slate-600 leading-relaxed">
            The University of Windsor is easily accessible by car and public transit. Located on Sunset Avenue, just minutes from downtown Windsor and the Detroit River.
          </p>
        </div>

        <!-- Parking Info -->
        <div class="bg-white rounded-xl p-8 shadow-md border-l-4 border-yellow-400 hover:shadow-lg transition-shadow">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Parking Info</h3>
            </div>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Visitor parking is available in Lot H and the Assumption Parking Garage. Rates are $10/day. Campus maps available at information booths.
          </p>
        </div>

        <!-- Public Transit -->
        <div class="bg-white rounded-xl p-8 shadow-md border-l-4 border-green-600 hover:shadow-lg transition-shadow">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Public Transit</h3>
            </div>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Transit Windsor routes 1C, 2, and 11 stop directly at the campus. Check transit.windsor.ca for schedules and real-time updates.
          </p>
        </div>
      </div>
    </div>

    <!-- Address Card (Full Width) -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 rounded-2xl p-8 text-white text-center">
      <h3 class="text-2xl font-bold mb-2">University of Windsor</h3>
      <p class="text-lg opacity-90 mb-4">401 Sunset Avenue, Windsor, ON N9B 3P4</p>
      <a 
        href="https://goo.gl/maps/windsoruni" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block bg-white text-blue-600 px-6 py-2 rounded-full font-semibold hover:bg-blue-50 transition-colors"
      >
        Open in Maps
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fadeInLeft {
    animation: fadeInLeft 0.6s ease-out;
  }

  .animate-fadeInRight {
    animation: fadeInRight 0.6s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fadeInLeft,
    .animate-fadeInRight {
      animation: none;
    }
  }
</style>
