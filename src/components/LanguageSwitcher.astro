---
// Language Switcher Component
---

<div class="flex items-center gap-2">
  <button
    id="lang-en"
    class="lang-switcher-btn px-3 py-1.5 rounded text-sm font-medium transition-all duration-200 bg-blue-600 text-white"
    data-lang="en"
  >
    EN
  </button>
  <button
    id="lang-fr"
    class="lang-switcher-btn px-3 py-1.5 rounded text-sm font-medium transition-all duration-200 text-slate-700 hover:bg-slate-100"
    data-lang="fr"
  >
    FR
  </button>
</div>

<script>
  const translations = {
    en: {
      'nav.home': 'Home',
      'nav.about': 'About',
      'nav.venue': 'Venue',
      'nav.faq': 'FAQ',
      'nav.getTickets': 'Get Tickets',
      'schedule.title': 'Schedule',
      'schedule.description': 'Browse the full event schedule',
      'schedule.time': 'TIME',
      'schedule.session': 'SESSION',
      'schedule.location': 'LOCATION',
      'schedule.add': 'ADD',
      'track.all': 'ALL',
      'track.googleCloud': 'Google Cloud',
      'track.buildWithAI': 'Build with AI',
      'track.fullStack': 'Full Stack',
      'track.entrepreneurship': 'Entrepreneurship',
      'track.cybersecurity': 'Cybersecurity',
      'track.highSchool': 'High School Track',
    },
    fr: {
      'nav.home': 'Accueil',
      'nav.about': 'À propos',
      'nav.venue': 'Lieu',
      'nav.faq': 'FAQ',
      'nav.getTickets': 'Obtenir des billets',
      'schedule.title': 'Horaire',
      'schedule.description': 'Parcourez l\'horaire complet de l\'événement',
      'schedule.time': 'HEURE',
      'schedule.session': 'SESSION',
      'schedule.location': 'LIEU',
      'schedule.add': 'AJOUTER',
      'track.all': 'TOUS',
      'track.googleCloud': 'Google Cloud',
      'track.buildWithAI': 'Build with AI',
      'track.fullStack': 'Full Stack',
      'track.entrepreneurship': 'Entrepreneurship',
      'track.cybersecurity': 'Cybersecurity',
      'track.highSchool': 'High School Track',
    },
  };

  function setLanguage(lang) {
    localStorage.setItem('language', lang);
    document.documentElement.lang = lang;
    
    // Update all elements with data-i18n attribute
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (translations[lang] && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });

    // Update track names in schedule
    const trackNameElements = document.querySelectorAll('[data-track-name]');
    trackNameElements.forEach((el) => {
      const key = el.getAttribute('data-track-name');
      if (translations[lang] && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });

    // Update table headers
    const timeHeader = document.querySelector('[data-schedule-header="time"]');
    const sessionHeader = document.querySelector('[data-schedule-header="session"]');
    const locationHeader = document.querySelector('[data-schedule-header="location"]');
    
    if (timeHeader) timeHeader.textContent = translations[lang]['schedule.time'];
    if (sessionHeader) sessionHeader.textContent = translations[lang]['schedule.session'];
    if (locationHeader) locationHeader.textContent = translations[lang]['schedule.location'];

    // Update ADD buttons
    const addButtons = document.querySelectorAll('[data-schedule-add]');
    addButtons.forEach((btn) => {
      btn.textContent = translations[lang]['schedule.add'];
    });

    // Update language switcher buttons
    const langButtons = document.querySelectorAll('.lang-switcher-btn');
    langButtons.forEach((btn) => {
      btn.classList.remove('bg-blue-600', 'text-white');
      btn.classList.add('text-slate-700', 'hover:bg-slate-100');
    });
    document.getElementById(`lang-${lang}`).classList.remove('text-slate-700', 'hover:bg-slate-100');
    document.getElementById(`lang-${lang}`).classList.add('bg-blue-600', 'text-white');
  }

  // Initialize language from localStorage or default to English
  const savedLanguage = localStorage.getItem('language') || 'en';
  setLanguage(savedLanguage);

  // Add click handlers to language switcher buttons
  const langButtons = document.querySelectorAll('.lang-switcher-btn');
  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      setLanguage(lang);
    });
  });
</script>
