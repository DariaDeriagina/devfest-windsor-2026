---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import SessionModal from "@components/SessionModal.astro";
import { EVENT_2026 } from "@config/event.config";
import { SUBMITTED_SESSIONS } from "@config/sessions.config";
import { FEATURED_SPEAKERS } from "@config/speakers.config";

const title = `Sessions | ${EVENT_2026.name}`;
const description = "Browse submitted sessions for DevFest Windsor 2026. Talks from amazing speakers on AI, entrepreneurship, data engineering, and more.";

// Find speaker info for each session
const sessionsWithSpeakers = SUBMITTED_SESSIONS.map(session => {
  const speaker = FEATURED_SPEAKERS.find(s => s.name === session.speaker);
  return {
    ...session,
    speakerPhoto: speaker?.imageUrl,
    speakerBio: speaker?.bio,
    speakerLinkedin: speaker?.linkedinUrl,
    accentColor: speaker?.accentColor || "blue",
  };
});
---

<BaseLayout title={title} description={description} ogImage={EVENT_2026.seo.ogImage}>
  <Header logoSrc="/web-app-manifest-512x512.png" />
  
  <main class="pt-20">
    <!-- Sessions Section -->
    <section id="sessions" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="mb-16">
          <span class="inline-block text-blue-600 font-semibold text-sm uppercase tracking-wider mb-4">
            🎤 Submitted Sessions
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
            Browse Our Speaker Sessions
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl leading-relaxed">
            Discover talks from our amazing speakers covering entrepreneurship, data engineering, AI development, and more. Click on any session title to see the full description.
          </p>
        </div>

        <!-- Sessions Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sessionsWithSpeakers.map((session) => (
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 group">
              <!-- Speaker Photo Header -->
              <div class={`h-40 bg-gradient-to-br ${
                session.accentColor === "blue" ? "from-blue-100 to-blue-50" :
                session.accentColor === "green" ? "from-green-100 to-green-50" :
                session.accentColor === "red" ? "from-red-100 to-red-50" :
                "from-yellow-100 to-yellow-50"
              } flex items-center justify-center relative overflow-hidden`}>
                {session.speakerPhoto && (
                  <img 
                    src={session.speakerPhoto} 
                    alt={session.speaker}
                    class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md cursor-pointer hover:scale-110 transition-transform duration-300"
                    data-speaker={session.speaker}
                    data-bio={session.speakerBio}
                    data-linkedin={session.speakerLinkedin}
                  />
                )}
              </div>

              <!-- Session Content -->
              <div class="p-6">
                <!-- Speaker Name -->
                <h3 class="text-sm font-semibold text-slate-600 uppercase tracking-wide mb-2">
                  {session.speaker}
                </h3>
                
                <!-- Session Title (Clickable) -->
                <h4 
                  class="text-xl font-bold text-slate-900 mb-4 cursor-pointer hover:text-blue-600 transition-colors line-clamp-2"
                  onclick={`window.openSessionModal(${JSON.stringify(session).replace(/"/g, '&quot;')})`}
                  role="button"
                  tabindex="0"
                >
                  {session.title}
                </h4>

                <!-- Description Preview -->
                <p class="text-slate-600 text-sm mb-4 line-clamp-3">
                  {session.description}
                </p>

                <!-- Session Meta -->
                <div class="flex flex-wrap gap-2 mb-4">
                  {session.duration && (
                    <span class="inline-block px-2 py-1 bg-slate-100 text-slate-700 rounded text-xs font-semibold">
                      ⏱️ {session.duration}
                    </span>
                  )}
                  {session.track && (
                    <span class="inline-block px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-semibold">
                      {session.track}
                    </span>
                  )}
                  {session.type && (
                    <span class="inline-block px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">
                      {session.type}
                    </span>
                  )}
                </div>

                <!-- View Button -->
                <button 
                  onclick={`window.openSessionModal(${JSON.stringify(session).replace(/"/g, '&quot;')})`}
                  class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300"
                >
                  View Full Description
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Session Modal -->
  <SessionModal />

  <script>
    // Add click handlers to speaker photos
    document.querySelectorAll('img[data-speaker]').forEach(img => {
      img.addEventListener('click', (e) => {
        e.stopPropagation();
        const speaker = img.dataset.speaker;
        const bio = img.dataset.bio;
        const linkedin = img.dataset.linkedin;
        
        // Show speaker modal
        const modal = document.createElement('div');
        modal.className = 'fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4';
        modal.innerHTML = `
          <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-white border-b border-slate-200 p-6 flex items-center justify-between">
              <h2 class="text-2xl font-bold text-slate-900">${speaker}</h2>
              <button class="text-slate-500 hover:text-slate-700 text-2xl font-light">×</button>
            </div>
            <div class="p-6 space-y-4">
              <div>
                <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-2">Bio</h3>
                <p class="text-slate-700 leading-relaxed whitespace-pre-wrap">${bio || 'No bio available'}</p>
              </div>
              ${linkedin && linkedin !== 'https://www.linkedin.com/' ? `
              <div class="pt-4 border-t border-slate-200">
                <a href="${linkedin}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                  🔗 View LinkedIn Profile
                </a>
              </div>
              ` : ''}
            </div>
          </div>
        `;
        
        const closeBtn = modal.querySelector('button');
        closeBtn?.addEventListener('click', () => modal.remove());
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.remove();
        });
        
        document.body.appendChild(modal);
      });
    });
  </script>
</BaseLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section {
    animation: fadeInUp 0.6s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    section {
      animation: none;
    }
  }
</style>
