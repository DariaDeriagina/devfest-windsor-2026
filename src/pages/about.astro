const colors: Record<Person["color"], string> = {
  blue: "bg-blue-600",
  red: "bg-red-600",
  yellow: "bg-amber-500",
  green: "bg-green-600",
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={EVENT_2026.seo.ogImage}
>
  <Header logoSrc="/web-app-manifest-512x512.png" />

  <main class="pt-20">

    <!-- ABOUT HERO -->
    <section class="bg-white py-12 md:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-12">

          <div class="animate-fadeInLeft">
            <div class="overflow-hidden rounded-3xl border-8 border-yellow-400 shadow-2xl">
              <img
                src="/AboutSectionImage.png"
                alt="DevFest Windsor Conference"
                class="h-auto w-full object-cover"
              />
            </div>
          </div>

          <div class="animate-fadeInRight">
            <span
              class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-red-600"
              data-about-i18n="heroEyebrow"
            >
              🔥 What is DevFest?
            </span>

            <h1
              class="mb-6 text-4xl font-bold leading-tight text-slate-900 md:text-5xl"
              data-about-i18n="heroTitle"
            >
              Join the Community-Led Tech Conference
            </h1>

            <p
              class="mb-6 text-lg leading-relaxed text-slate-600"
              data-about-i18n="heroSubtitle"
            >
              DevFest Windsor is a community-led technical conference hosted by Google Developer Group Windsor. It's a premier local event designed to bring developers together to learn, connect, and build the future.
            </p>

            <p
              class="text-lg leading-relaxed text-slate-600"
              data-about-i18n="heroDescription"
            >
              Whether you're a seasoned developer or just starting your tech journey, DevFest offers something for everyone. Experience inspiring talks, hands-on workshops, meaningful networking, and exclusive swag.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- PEOPLE SECTIONS -->
    {
      sections.map((section) => (
        <section
          id={section.id}
          class={`py-16 md:py-24 ${section.background}`}
          aria-labelledby={`${section.id}-heading`}
        >
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <!-- HEADING -->
            <div class="mb-12 sm:mb-16">
              <span
                class="text-sm font-bold uppercase tracking-widest text-blue-600"
                data-about-i18n={`${section.id}Eyebrow`}
              >
                {section.eyebrow}
              </span>

              <div
                class="mb-6 mt-6 flex w-full max-w-sm gap-2"
                aria-hidden="true"
              >
                <span class="h-1.5 flex-1 rounded-full bg-blue-600"></span>
                <span class="h-1.5 flex-1 rounded-full bg-red-600"></span>
                <span class="h-1.5 flex-1 rounded-full bg-yellow-400"></span>
                <span class="h-1.5 flex-1 rounded-full bg-green-600"></span>
              </div>

              <h2
                id={`${section.id}-heading`}
                class="text-3xl font-bold text-slate-900 sm:text-4xl"
                data-about-i18n={`${section.id}Title`}
              >
                {section.title}
              </h2>
            </div>

            <!-- RESPONSIVE PEOPLE GRID -->
            <div
              class:list={[
                "people-grid",
                section.id === "moderator" && "people-grid--moderator",
              ]}
            >
              {section.people.map((person, index) => (
                <article
                  class="person-card group animate-fade-in-up"
                  style={`animation-delay: ${(index % 4) * 0.1}s;`}
                  data-name={person.name}
                  data-company={person.company}
                  data-role={person.role}
                  data-image={person.image}
                  data-bio={person.bio}
                  data-profile={person.profile || ""}
                  data-website={person.website || ""}
                >

                  <!-- CLICKABLE PHOTO -->
                  <button
                    type="button"
                    class="person-trigger person-avatar-button"
                    aria-label={`View biography of ${person.name}`}
                    aria-haspopup="dialog"
                    aria-controls="personBioModal"
                  >
                    <span
                      class={`blob-shape person-avatar-blob ${colors[person.color]}`}
                      aria-hidden="true"
                    ></span>

                    <img
                      src={person.image}
                      alt={person.name}
                      class="person-avatar-image"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>

                  <!-- CONTENT -->
                  <div class="person-content">

                    <h3 class="person-name">
                      {person.name}
                    </h3>

                    <p class="person-company">
                      {person.company || "\u00A0"}
                    </p>

                    <p class="person-role">
                      {person.role}
                    </p>

                  </div>

                  <!-- ALWAYS SHOW BIO BUTTON -->
                  <button
                    type="button"
                    class="person-trigger person-bio-button"
                    aria-haspopup="dialog"
                    aria-controls="personBioModal"
                    aria-label={`View biography of ${person.name}`}
                  >
                    <span data-about-i18n="bio">Bio</span>
                  </button>

                </article>
              ))}
            </div>

          </div>
        </section>
      ))
    }

    <!-- STATS -->
    <section class="bg-gradient-to-r from-blue-600 via-green-500 to-yellow-400 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 text-center text-white md:grid-cols-4">

          <div>
            <div class="mb-2 text-4xl font-bold sm:text-5xl md:text-6xl">
              500+
            </div>
            <p
              class="text-sm opacity-90 sm:text-lg"
              data-about-i18n="attendees"
            >
              Expected Attendees
            </p>
          </div>

          <div>
            <div class="mb-2 text-4xl font-bold sm:text-5xl md:text-6xl">
              20+
            </div>
            <p
              class="text-sm opacity-90 sm:text-lg"
              data-about-i18n="speakers"
            >
              Amazing Speakers
            </p>
          </div>

          <div>
            <div class="mb-2 text-4xl font-bold sm:text-5xl md:text-6xl">
              8
            </div>
            <p
              class="text-sm opacity-90 sm:text-lg"
              data-about-i18n="hours"
            >
              Hours of Content
            </p>
          </div>

          <div>
            <div class="mb-2 text-4xl font-bold sm:text-5xl md:text-6xl">
              ∞
            </div>
            <p
              class="text-sm opacity-90 sm:text-lg"
              data-about-i18n="networking"
            >
              Networking Value
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">

        <h2
          class="mb-6 text-3xl font-bold text-slate-900 md:text-4xl"
          data-about-i18n="readyTitle"
        >
          Ready to Join Us?
        </h2>

        <p
          class="mb-8 text-lg text-slate-600"
          data-about-i18n="readyDescription"
        >
          Secure your spot at DevFest Windsor 2026 and be part of the tech community's biggest event of the year.
        </p>

        <a
          href="https://gdg.community.dev/events/details/google-gdg-windsor-presents-gdg-windsor-essex-devfest-2026/cohost-gdg-windsor/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full bg-gradient-to-r from-blue-600 to-green-500 px-8 py-3 text-lg font-semibold text-white transition-all duration-300 hover:shadow-lg"
          data-about-i18n="tickets"
        >
          Get Tickets
        </a>

      </div>
    </section>

  </main>

  <!-- SHARED BIO MODAL -->
  <dialog
    id="personBioModal"
    class="person-modal rounded-2xl bg-white text-slate-900"
    aria-labelledby="personModalName"
  >
    <div class="person-modal-inner">

      <div class="mb-5 flex items-start justify-between gap-4">

        <div class="min-w-0">
          <h2
            id="personModalName"
            class="break-words text-xl font-bold text-slate-900 sm:text-2xl"
          ></h2>

          <p
            id="personModalRole"
            class="mt-2 break-words text-sm text-slate-600"
          ></p>

          <p
            id="personModalCompany"
            class="mt-1 break-words text-sm text-slate-500"
          ></p>
        </div>

        <button
          id="closePersonModal"
          type="button"
          class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full text-2xl leading-none text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
          aria-label="Close biography"
        >
          ×
        </button>

      </div>

      <img
        id="personModalImage"
        alt=""
        class="mb-5 h-24 w-24 rounded-full object-cover"
      />

      <p
        id="personModalBio"
        class="whitespace-pre-line break-words text-sm leading-relaxed text-slate-600 sm:text-base"
      ></p>

      <div class="mt-6 flex flex-wrap gap-4">

        <a
          id="personModalProfile"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden text-sm font-semibold text-blue-600 hover:underline"
          data-about-i18n="gdgProfile"
        >
          GDG Profile ↗
        </a>

        <a
          id="personModalWebsite"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden text-sm font-semibold text-blue-600 hover:underline"
          data-about-i18n="website"
        >
          Website ↗
        </a>

      </div>

    </div>
  </dialog>

</BaseLayout>

<style>
  /* --------------------------------
     PEOPLE GRID
  -------------------------------- */

  .people-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 40px;
    align-items: stretch;
  }

  .people-grid--moderator {
    display: flex;
    justify-content: center;
  }

  .people-grid--moderator .person-card {
    width: 100%;
    max-width: 280px;
  }

  /* --------------------------------
     PERSON CARD
  -------------------------------- */

  .person-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    width: 100%;
    height: 100%;
    text-align: center;
    padding: 0 2px;
  }

  /* --------------------------------
     PROFILE PHOTO
  -------------------------------- */

  .person-avatar-button {
    position: relative;
    display: block;
    width: clamp(96px, 28vw, 160px);
    height: clamp(96px, 28vw, 160px);
    flex-shrink: 0;
    border-radius: 50%;
    margin-bottom: 20px;
    cursor: pointer;
    border: 0;
    padding: 0;
    background: transparent;
  }

  .person-avatar-blob {
    position: absolute;
    inset: 0;
    transform: scale(1.05);
    transition: transform 300ms ease;
  }

  .person-avatar-image {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid white;
    box-shadow: 0 6px 20px rgb(0 0 0 / 12%);
    transition: transform 300ms ease;
  }

  .person-card:hover .person-avatar-blob {
    transform: scale(1.1);
  }

  .person-card:hover .person-avatar-image {
    transform: scale(1.05);
  }

  .blob-shape {
    border-radius: 30% 70% 70% 30%;
    animation: morphBlob 8s ease-in-out infinite;
  }

  @keyframes morphBlob {
    0%, 100% {
      border-radius: 30% 70% 70% 30%;
    }

    25% {
      border-radius: 40% 60% 60% 40%;
    }

    50% {
      border-radius: 50%;
    }

    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }

  /* --------------------------------
     CONTENT AREA
     Keeps all buttons aligned
  -------------------------------- */

  .person-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    flex: 1 1 auto;
  }

  .person-name {
    width: 100%;
    margin: 0;
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .person-company {
    width: 100%;
    margin-top: 8px;
    color: #475569;
    font-size: 13px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .person-role {
    width: 100%;
    margin-top: 6px;
    color: #64748b;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  /* --------------------------------
     BIO BUTTON
     Always at bottom of card
  -------------------------------- */

  .person-bio-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    min-width: 88px;
    min-height: 40px;
    margin-top: 18px;
    padding: 8px 20px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
    color: #2563eb;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .person-bio-button:hover {
    border-color: #2563eb;
    background: #eff6ff;
    transform: translateY(-2px);
  }

  /* --------------------------------
     TABLET AND DESKTOP
  -------------------------------- */

  @media (min-width: 640px) {
    .people-grid {
      column-gap: 24px;
      row-gap: 56px;
    }

    .person-name {
      font-size: 18px;
    }

    .person-company {
      font-size: 14px;
    }

    .person-role {
      font-size: 13px;
    }

    .person-card {
      padding: 0 8px;
    }
  }

  @media (min-width: 768px) {
    .people-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .person-avatar-button {
      width: 160px;
      height: 160px;
    }

    .person-card {
      padding: 0 12px;
    }
  }

  /* --------------------------------
     MOBILE
  -------------------------------- */

  @media (max-width: 639px) {
    .people-grid {
      column-gap: 14px;
      row-gap: 38px;
    }

    .person-card {
      padding: 0 2px;
    }

    .person-avatar-button {
      width: clamp(96px, 28vw, 136px);
      height: clamp(96px, 28vw, 136px);
      margin-bottom: 16px;
    }

    .person-name {
      font-size: 15px;
      line-height: 1.4;
    }

    .person-company {
      font-size: 12px;
      line-height: 1.45;
    }

    .person-role {
      font-size: 11px;
      line-height: 1.5;
    }

    .person-bio-button {
      min-width: 82px;
      min-height: 38px;
      margin-top: 16px;
      font-size: 13px;
    }
  }

  /* Very narrow screens */
  @media (max-width: 319px) {
    .people-grid {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .person-card {
      max-width: 250px;
    }

    .person-avatar-button {
      width: 132px;
      height: 132px;
    }

    .person-name {
      font-size: 17px;
    }

    .person-role {
      font-size: 13px;
    }
  }

  /* --------------------------------
     MODAL
  -------------------------------- */

  .person-modal {
    width: min(42rem, calc(100% - 24px));
    max-width: 42rem;
    max-height: min(85dvh, 850px);
    margin: auto;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 24px 64px rgb(0 0 0 / 20%);
  }

  .person-modal-inner {
    padding: 24px;
  }

  .person-modal::backdrop {
    background: rgb(0 0 0 / 55%);
  }

  @media (max-width: 639px) {
    .person-modal {
      width: calc(100% - 24px);
      max-height: 88dvh;
      border-radius: 16px;
    }

    .person-modal-inner {
      padding: 20px 16px;
    }
  }

  /* --------------------------------
     ANIMATIONS
  -------------------------------- */

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInLeft {
    animation: fadeInLeft 0.6s ease-out;
  }

  .animate-fadeInRight {
    animation: fadeInRight 0.6s ease-out;
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out both;
  }

  /* --------------------------------
     ACCESSIBILITY
  -------------------------------- */

  .person-trigger:focus-visible,
  .person-modal button:focus-visible,
  .person-modal a:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fadeInLeft,
    .animate-fadeInRight,
    .animate-fade-in-up,
    .blob-shape {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .person-avatar-image,
    .person-avatar-blob,
    .person-bio-button {
      transition: none;
    }
  }
</style>

<script>
  const translations: Record<string, Record<string, string>> = {
    en: {
      heroEyebrow: "🔥 What is DevFest?",
      heroTitle: "Join the Community-Led Tech Conference",
      heroSubtitle:
        "DevFest Windsor is a community-led technical conference hosted by Google Developer Group Windsor. It's a premier local event designed to bring developers together to learn, connect, and build the future.",
      heroDescription:
        "Whether you're a seasoned developer or just starting your tech journey, DevFest offers something for everyone. Experience inspiring talks, hands-on workshops, meaningful networking, and exclusive swag.",

      organizersEyebrow: "MEET THE TEAM",
      organizersTitle: "Meet Our Organizers",

      moderatorEyebrow: "FIRESIDE CHAT",
      moderatorTitle: "Meet Our Moderator",

      panelistsEyebrow: "FIRESIDE CHAT",
      panelistsTitle: "Meet Our Panelists",

      bio: "Bio",
      bioComingSoon:
        "Biography coming soon. More information about this team member will be added shortly.",

      gdgProfile: "GDG Profile ↗",
      website: "Website ↗",

      attendees: "Expected Attendees",
      speakers: "Amazing Speakers",
      hours: "Hours of Content",
      networking: "Networking Value",

      readyTitle: "Ready to Join Us?",
      readyDescription:
        "Secure your spot at DevFest Windsor 2026 and be part of the tech community's biggest event of the year.",
      tickets: "Get Tickets",
    },

    fr: {
      heroEyebrow: "🔥 Qu'est-ce que DevFest?",
      heroTitle: "Rejoignez la conférence technologique communautaire",
      heroSubtitle:
        "DevFest Windsor est une conférence technologique communautaire organisée par Google Developer Group Windsor. Cet événement local rassemble les développeurs pour apprendre, échanger et construire l'avenir.",
      heroDescription:
        "Que vous soyez un développeur expérimenté ou que vous commenciez votre parcours technologique, DevFest offre quelque chose pour tout le monde. Découvrez des conférences inspirantes, des ateliers pratiques, des occasions de réseautage et des cadeaux exclusifs.",

      organizersEyebrow: "RENCONTREZ L'ÉQUIPE",
      organizersTitle: "Rencontrez nos organisateurs",

      moderatorEyebrow: "DISCUSSION INFORMELLE",
      moderatorTitle: "Rencontrez notre modératrice",

      panelistsEyebrow: "DISCUSSION INFORMELLE",
      panelistsTitle: "Rencontrez nos panélistes",

      bio: "Bio",
      bioComingSoon:
        "Biographie à venir. Plus d'informations sur ce membre de l'équipe seront ajoutées prochainement.",

      gdgProfile: "Profil GDG ↗",
      website: "Site web ↗",

      attendees: "Participants attendus",
      speakers: "Conférenciers extraordinaires",
      hours: "Heures de contenu",
      networking: "Valeur du réseautage",

      readyTitle: "Prêt à nous rejoindre?",
      readyDescription:
        "Réservez votre place à DevFest Windsor 2026 et participez à l'un des plus grands événements technologiques de notre communauté.",
      tickets: "Obtenez votre billet",
    },
  };

  function getLanguage(): "en" | "fr" {
    try {
      return localStorage.getItem("language") === "fr"
        ? "fr"
        : "en";
    } catch {
      return "en";
    }
  }

  function updateTranslations() {
    const dictionary = translations[getLanguage()];

    document
      .querySelectorAll<HTMLElement>("[data-about-i18n]")
      .forEach((element) => {
        const key = element.dataset.aboutI18n;

        if (key && dictionary[key]) {
          element.textContent = dictionary[key];
        }
      });

    const modal =
      document.querySelector<HTMLDialogElement>(
        "#personBioModal"
      );

    const bioElement =
      document.querySelector<HTMLElement>(
        "#personModalBio"
      );

    if (
      modal?.open &&
      bioElement &&
      modal.dataset.bioMissing === "true"
    ) {
      bioElement.textContent =
        dictionary.bioComingSoon;
    }
  }

  function initializeAboutPage() {
    const modal =
      document.querySelector<HTMLDialogElement>(
        "#personBioModal"
      );

    if (!modal) return;

    if (modal.dataset.initialized === "true") {
      updateTranslations();
      return;
    }

    modal.dataset.initialized = "true";

    const nameElement =
      modal.querySelector<HTMLElement>(
        "#personModalName"
      );

    const roleElement =
      modal.querySelector<HTMLElement>(
        "#personModalRole"
      );

    const companyElement =
      modal.querySelector<HTMLElement>(
        "#personModalCompany"
      );

    const bioElement =
      modal.querySelector<HTMLElement>(
        "#personModalBio"
      );

    const imageElement =
      modal.querySelector<HTMLImageElement>(
        "#personModalImage"
      );

    const profileLink =
      modal.querySelector<HTMLAnchorElement>(
        "#personModalProfile"
      );

    const websiteLink =
      modal.querySelector<HTMLAnchorElement>(
        "#personModalWebsite"
      );

    const closeButton =
      modal.querySelector<HTMLButtonElement>(
        "#closePersonModal"
      );

    function openBio(card: HTMLElement) {
      if (
        !nameElement ||
        !roleElement ||
        !companyElement ||
        !bioElement ||
        !imageElement
      ) {
        return;
      }

      const name = card.dataset.name || "";
      const company = card.dataset.company || "";
      const role = card.dataset.role || "";
      const bio = card.dataset.bio?.trim() || "";
      const image = card.dataset.image || "";
      const profile = card.dataset.profile || "";
      const website = card.dataset.website || "";

      nameElement.textContent = name;
      companyElement.textContent = company;
      roleElement.textContent = role;

      modal.dataset.bioMissing = bio
        ? "false"
        : "true";

      bioElement.textContent =
        bio ||
        translations[getLanguage()].bioComingSoon;

      imageElement.src = image;
      imageElement.alt = name;

      if (profileLink) {
        profileLink.href = profile || "#";
        profileLink.classList.toggle(
          "hidden",
          !profile
        );
      }

      if (websiteLink) {
        websiteLink.href = website || "#";
        websiteLink.classList.toggle(
          "hidden",
          !website
        );
      }

      updateTranslations();

      if (!modal.open) {
        modal.showModal();
      }
    }

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const trigger = target.closest(
        ".person-trigger"
      );

      if (!trigger) {
        return;
      }

      const card = trigger.closest<HTMLElement>(
        ".person-card"
      );

      if (card) {
        openBio(card);
      }
    });

    closeButton?.addEventListener("click", () => {
      modal.close();
    });

    modal.addEventListener("click", (event) => {
      if (event.target !== modal) {
        return;
      }

      const rect = modal.getBoundingClientRect();

      const outside =
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom;

      if (outside) {
        modal.close();
      }
    });

    updateTranslations();

    const observer = new MutationObserver(
      updateTranslations
    );

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["lang"],
    });

    window.addEventListener("storage", (event) => {
      if (event.key === "language") {
        updateTranslations();
      }
    });

    let lastLanguage = getLanguage();

    const interval = window.setInterval(() => {
      if (!modal.isConnected) {
        window.clearInterval(interval);
        observer.disconnect();
        return;
      }

      const language = getLanguage();

      if (language !== lastLanguage) {
        lastLanguage = language;
        updateTranslations();
      }
    }, 300);
  }

  initializeAboutPage();

  document.addEventListener(
    "astro:page-load",
    initializeAboutPage
  );
</script>
