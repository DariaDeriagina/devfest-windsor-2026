  },
  {
    name: "Godfrey Nolan",
    company: "RIIS LLC",
    role: "President",
    image: "/panelists/GodfreyNolan.webp",
    color: "blue",
    bio: `Godfrey Nolan is the President of RIIS LLC, a mobile development company based in Troy, Michigan, and Windsor specializing in mobile apps for drones. With over 26 years of experience, he has built a team of experts capable of defining, developing, testing, and deploying mobile and web applications for our clients. Godfrey is also a prolific author, having written six books on mobile development and security, including "Decompiling Java" and "Bulletproof Android."

In addition to his role at RIIS LLC, he serves as an Adjunct Professor at multiple universities, teaching various subjects related to programming and development, including Java, LLMs, Blockchain technologies, and Android programming. His extensive experience in both the industry and academia highlights his expertise in mobile technology, requirements analysis, architecture, and continuous integration. Godfrey Nolan's contributions span the worlds of education, mobile app development, and published authorship in the field of technology.`,
  },
];

const sections = [
  {
    id: "organizers",
    eyebrow: "MEET THE TEAM",
    title: "Meet Our Organizers",
    people: organizers,
    background: "bg-gradient-to-b from-slate-50 to-white",
  },
  {
    id: "moderator",
    eyebrow: "FIRESIDE CHAT",
    title: "Meet Our Moderator",
    people: [moderator],
    background: "bg-white",
  },
  {
    id: "panelists",
    eyebrow: "FIRESIDE CHAT",
    title: "Meet Our Panelists",
    people: panelists,
    background: "bg-gradient-to-b from-slate-50 to-white",
  },
