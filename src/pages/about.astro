
---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import { EVENT_2026 } from "@config/event.config";

const title = `About | ${EVENT_2026.name}`;
const description =
  "Learn more about Google DevFest Windsor 2026 and the people behind the event.";

