const panelists: Person[] = [
  {
    name: "Don Ward",
    company: "Google",
    role: "Customer Engineer",
    image: "/panelists/don-ward.webp",
    color: "blue",
    bio: `Don Ward is a cloud enthusiast and Customer Engineer at Google Cloud, bringing deep practical experience to the table. In the last 5 years alone, he's earned an impressive 17 cloud certifications across Google and AWS, fueled by a passion for continuous learning and a drive to master the Google Cloud ecosystem. Don's commitment extends to the local tech scene, where he's spent 12 years fostering growth by leading Google Developer Groups in Windsor and Detroit. While transitioning leadership, he remains a dedicated volunteer, empowering others to lead.`,
  },
  {
    name: "Naresh Jasotani",
    company: "Google",
    role: "Technology Leader / AI & ML",
    image: "/panelists/NareshJasotani.webp",
    color: "red",
    bio: `Naresh has over 17 years of experience in helping customers to get benefits of data, analytics and artificial intelligence advancements. With Machine Learning picking up in the last few years, he believes that it has brought endless possibilities for businesses to make data-based decisions, and be more predictive in their thought process. Naresh currently works at Google in the AI & ML domain and in the past, he gained consulting experience working for companies like Infosys, TCS, Accenture and Miracle Software Systems.

He is passionate about building solutions with customers, published author (Book: Adopting TensorFlow for real-world AI), and avid YouTuber. He enjoys taking up new challenges, analysing customers’ business problems and coming up with innovative solutions that can be solved by collecting, understanding, designing data, analytics and Machine learning solutions. He loves flying planes and has a Pilot’s License as well.`,
