---

<section id="schedule" class="animate-fade-in-up" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl font-bold text-gray-900 mb-4" data-i18n="schedule.title">{finalTitle}</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto" data-i18n="schedule.description">{finalDescription}</p>
    </div>

    <!-- Track Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {tracks.map((track) => (
        <button
          class={`track-filter-btn px-6 py-3 rounded-full font-semibold text-white bg-gradient-to-r ${track.bgGradient} hover:shadow-lg hover:shadow-blue-500/40 transition-all duration-300 cursor-pointer transform hover:scale-105 flex items-center gap-2`}
          data-track={track.name}
        >
          <span set:html={iconSvgs[track.icon]} />
          {track.name}
        </button>
      ))}
    </div>

    <!-- Sessions Table -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b-2 border-gray-200">
            <th class="text-left py-4 px-4 font-semibold text-gray-900">TIME</th>
            <th class="text-left py-4 px-4 font-semibold text-gray-900">SESSION</th>
            <th class="text-left py-4 px-4 font-semibold text-gray-900 hidden md:table-cell">LOCATION</th>
            <th class="text-center py-4 px-4 font-semibold text-gray-900">ADD</th>
          </tr>
        </thead>
        <tbody>
          {sessions.map((session, idx) => (
            <tr class="session-row border-b border-gray-100 hover:bg-gray-50 transition-colors cursor-pointer"
                data-track={session.track}
                onclick={`window.openSessionModal({title: '${session.title}', speaker: '${session.speaker}', description: '${session.description.replace(/'/g, "\\'")}', duration: '${session.duration}', track: '${session.track}', type: '${session.type}'})`}>
              <!-- Time -->
              <td class="py-6 px-4 font-semibold text-gray-900 whitespace-nowrap">{session.time}</td>

              <!-- Session Details -->
              <td class="py-6 px-4">
                <div class="flex items-start gap-4">
                  <!-- Avatar with speaker photo or initials -->
                  <div class="flex-shrink-0">
                    {(() => {
                      const speakerData = getSpeakerData(session.speaker);
                      const accentColor = speakerData?.accentColor || "blue";
                      const accent = accentStyles[accentColor as keyof typeof accentStyles] || accentStyles.blue;

                      return (
                        <div class="group relative w-12 h-12">
                          {speakerData && speakerData.imageUrl && speakerData.imageUrl !== "/speaker-placeholder.png" ? (
                            <>
                              <div
                                class={`blob-shape absolute inset-0 scale-105 transition-transform duration-300 group-hover:scale-110 ${accent.blob}`}
                                aria-hidden="true"
                              />
                              <img
                                src={speakerData.imageUrl}
                                alt={speakerData.imageAlt}
                                class={`speaker-schedule-image relative w-full h-full rounded-full object-cover ring-2 ring-white shadow-md transition-all duration-300 group-hover:scale-110 ${accent.ring}`}
                                data-speaker-name={speakerData.name}
                                data-speaker-role={speakerData.role}
                                data-speaker-company={speakerData.company}
                                data-speaker-bio={speakerData.bio || ''}
                                data-speaker-linkedin={speakerData.linkedinUrl || ''}
                                data-speaker-image={speakerData.imageUrl}
                              />
                            </>
                          ) : (
                            <div class={`w-12 h-12 ${session.bgColor} rounded-full flex items-center justify-center text-white font-bold text-sm`}>
                              {session.speaker === "TBD" || session.speaker === "Community" || session.speaker === "Google DevFest Team" ? "?" : session.speaker.split(" ").map(n => n[0]).join("").substring(0, 2).toUpperCase()}
                            </div>
                          )}
                        </div>
                      );
                    })()}
                  </div>

                  <!-- Session info -->
                  <div class="flex-grow">
                    <h4 class="font-semibold text-gray-900 mb-2 cursor-pointer hover:text-blue-600 transition-colors">{session.title}</h4>
                    <p class="text-sm text-gray-600 mb-2">{session.speaker}</p>
                    <div class="flex flex-wrap gap-2">
                      <!-- Track badge -->
                      <span
                        class={`px-3 py-1.5 rounded-full text-xs font-semibold text-white bg-gradient-to-r ${tracks.find(t => t.name === session.track)?.bgGradient} cursor-pointer hover:shadow-md transition-all flex items-center gap-1.5`}
                        onclick="event.stopPropagation();"
                      >
                        <span set:html={iconSvgs[tracks.find(t => t.name === session.track)?.icon || "sparkles"]} />
                        {session.track}
                      </span>

                      <!-- Type badge -->
                      <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 bg-gray-200 cursor-pointer hover:bg-gray-300 transition-colors" onclick="event.stopPropagation();">
                        {session.type}
                      </span>

                      <!-- BIO Button for sessions with speaker data -->
                      {(() => {
                        const speakerData = getSpeakerData(session.speaker);
                        return speakerData && speakerData.bio ? (
                          <button
                            class="speaker-schedule-bio-btn inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors"
                            data-speaker-name={speakerData.name}
                            data-speaker-role={speakerData.role}
                            data-speaker-company={speakerData.company}
                            data-speaker-bio={speakerData.bio}
                            data-speaker-linkedin={speakerData.linkedinUrl || ''}
                            data-speaker-image={speakerData.imageUrl}
                            onclick="event.stopPropagation();"
                          >
                            BIO
                          </button>
                        ) : null;
                      })()}
                    </div>
                  </div>
                </div>
              </td>

              <!-- Location -->
              <td class="py-6 px-4 text-gray-600 hidden md:table-cell">
                <button class="text-blue-600 hover:text-blue-800 font-semibold cursor-pointer transition-colors" onclick="event.stopPropagation();">
                  {session.location}
                </button>
              </td>

              <!-- Add to Calendar -->
              <td class="py-6 px-4 text-center">
                <button
                  class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors cursor-pointer"
                  onclick="event.stopPropagation(); window.addToCalendar(event, this, {title: '${session.title}', speaker: '${session.speaker}', time: '${session.time}', location: '${session.location}', description: '${session.description.replace(/'/g, "\\'")}'});"
                  data-session-title={session.title}
                  data-session-speaker={session.speaker}
                  data-session-time={session.time}
                  data-session-location={session.location}
                >
                  Add
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Session Modal -->
  <SessionModal sessions={sessions} />

  <!-- Speaker Bio Modal -->
  <div id="schedulespeakerModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-96 overflow-y-auto">
      <div class="p-6">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h2 id="scheduleModalSpeakerName" class="text-2xl font-bold text-slate-900"></h2>
            <p id="scheduleModalSpeakerRole" class="text-sm text-slate-600"></p>
            <p id="scheduleModalSpeakerCompany" class="text-sm text-slate-600"></p>
          </div>
          <button
            id="scheduleCloseModalBtn"
            class="text-slate-500 hover:text-slate-700 text-2xl leading-none"
          >
            ×
          </button>
        </div>
        <img id="scheduleModalSpeakerImage" src="" alt="" class="w-24 h-24 rounded-full mb-4 object-cover" />
        <p id="scheduleModalSpeakerBio" class="text-slate-600 mb-4"></p>
        <a id="scheduleModalLinkedinLink" href="" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-semibold">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.438-.103.249-.129.597-.129.946v5.421h-3.554s.045-8.789 0-9.514h3.554v1.348c.421-.649 1.175-1.573 2.853-1.573 2.08 0 3.641 1.36 3.641 4.28v5.459zM5.337 9.433c-1.144 0-1.915-.759-1.915-1.708 0-.955.77-1.708 1.963-1.708 1.192 0 1.914.753 1.939 1.708 0 .949-.747 1.708-1.987 1.708zm1.582 10.019H3.755V9.938h3.164v9.514zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Parse time string to 24-hour format
  function parseTime(timeStr) {
    const match = timeStr.match(/(\d+):(\d+)\s(AM|PM)/);
    if (!match) return null;

    let hours = parseInt(match[1]);
    const minutes = parseInt(match[2]);
    const meridiem = match[3];

    if (meridiem === 'PM' && hours !== 12) hours += 12;
    if (meridiem === 'AM' && hours === 12) hours = 0;

    return { hours, minutes };
  }

  // Add to Calendar function with Google Calendar and Apple Calendar support
  window.addToCalendar = function(event, button, sessionData) {
    event.preventDefault();
    event.stopPropagation();

    const { title, speaker, time, location, description } = sessionData;
    const parsedTime = parseTime(time);

    if (!parsedTime) {
      alert('Unable to parse session time');
      return;
    }

    // Create menu for calendar selection
    const menuId = 'calendar-menu-' + Date.now();
    const menu = document.createElement('div');
    menu.id = menuId;
    menu.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    `;

    const menuContent = document.createElement('div');
    menuContent.style.cssText = `
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      max-width: 400px;
      width: 90%;
    `;

    menuContent.innerHTML = `
      <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #111;">Add to Calendar</h3>
      <p style="margin: 0 0 20px 0; color: #666; font-size: 14px;">${title}</p>
      <button id="google-calendar-btn" style="
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 8px;
        background: #4285F4;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#3367D6'" onmouseout="this.style.background='#4285F4'">
        Add to Google Calendar
      </button>
      <button id="apple-calendar-btn" style="
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 8px;
        background: #555;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#333'" onmouseout="this.style.background='#555'">
        Add to Apple Calendar
      </button>
      <button id="close-menu-btn" style="
        width: 100%;
        padding: 12px 16px;
        background: #e5e7eb;
        color: #333;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      " onmouseover="this.style.background='#d1d5db'" onmouseout="this.style.background='#e5e7eb'">
        Cancel
      </button>
    `;

    menu.appendChild(menuContent);
    document.body.appendChild(menu);

    // Event date: November 21, 2026
    const eventDate = new Date(2026, 10, 21); // Month is 0-indexed
    eventDate.setHours(parsedTime.hours, parsedTime.minutes, 0);

    const endDate = new Date(eventDate);
    endDate.setHours(endDate.getHours() + 1); // Default 1 hour duration

    // Google Calendar handler
    document.getElementById('google-calendar-btn').addEventListener('click', function() {
      const startTime = eventDate.toISOString();
      const endTime = endDate.toISOString();

      const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${startTime.replace(/[-:]/g, '').split('.')[0]}Z/${endTime.replace(/[-:]/g, '').split('.')[0]}Z&location=${encodeURIComponent(location)}&details=${encodeURIComponent(`Speaker: ${speaker}\n\n${description}`)}`;

      window.open(googleCalendarUrl, '_blank', 'width=800,height=600');
      document.body.removeChild(menu);
    });

    // Apple Calendar handler
    document.getElementById('apple-calendar-btn').addEventListener('click', function() {
      // Create ICS file content for Apple Calendar
      const startTime = eventDate.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      const endTime = endDate.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';

      const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Google DevFest Windsor//NONSGML v1.0//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VEVENT
UID:devfest-${Date.now()}@googledevfest.local
DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z
DTSTART:${startTime}
DTEND:${endTime}
SUMMARY:${title}
DESCRIPTION:Speaker: ${speaker}\\n\\n${description}
LOCATION:${location}
STATUS:CONFIRMED
END:VEVENT
END:VCALENDAR`;

      // Create blob and download ICS file
      const blob = new Blob([icsContent], { type: 'text/calendar' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${title.replace(/\s+/g, '-')}.ics`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);

      document.body.removeChild(menu);
    });

    // Close menu handler
    document.getElementById('close-menu-btn').addEventListener('click', function() {
      document.body.removeChild(menu);
    });

    // Close on background click
    menu.addEventListener('click', function(e) {
      if (e.target === menu) {
        document.body.removeChild(menu);
      }
    });
  };

  // Speaker Bio Modal functionality
  const speakerModal = document.getElementById("schedulespeakerModal");
  const closeModalBtn = document.getElementById("scheduleCloseModalBtn");
  const speakerImages = document.querySelectorAll(".speaker-schedule-image");
  const bioBtns = document.querySelectorAll(".speaker-schedule-bio-btn");

  function openSpeakerModal(speakerName, speakerRole, speakerCompany, speakerBio, speakerLinkedin, speakerImage) {
    document.getElementById("scheduleModalSpeakerName").textContent = speakerName;
    document.getElementById("scheduleModalSpeakerRole").textContent = speakerRole;
    document.getElementById("scheduleModalSpeakerCompany").textContent = speakerCompany;
    document.getElementById("scheduleModalSpeakerBio").textContent = speakerBio;
    document.getElementById("scheduleModalSpeakerImage").src = speakerImage;

    const linkedinLink = document.getElementById("scheduleModalLinkedinLink");
    if (speakerLinkedin) {
      linkedinLink.href = speakerLinkedin;
      linkedinLink.style.display = "inline-flex";
    } else {
      linkedinLink.style.display = "none";
    }

    speakerModal.classList.remove("hidden");
  }

  // Open modal when clicking on speaker image
  speakerImages.forEach((img) => {
    img.addEventListener("click", (e) => {
      e.stopPropagation();
      const speakerName = img.getAttribute("data-speaker-name");
      const speakerRole = img.getAttribute("data-speaker-role");
      const speakerCompany = img.getAttribute("data-speaker-company");
      const speakerBio = img.getAttribute("data-speaker-bio");
      const speakerLinkedin = img.getAttribute("data-speaker-linkedin");
      const speakerImage = img.getAttribute("data-speaker-image");

      openSpeakerModal(speakerName, speakerRole, speakerCompany, speakerBio, speakerLinkedin, speakerImage);
    });
  });

  // Open modal when clicking BIO button
  bioBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const speakerName = btn.getAttribute("data-speaker-name");
      const speakerRole = btn.getAttribute("data-speaker-role");
      const speakerCompany = btn.getAttribute("data-speaker-company");
      const speakerBio = btn.getAttribute("data-speaker-bio");
      const speakerLinkedin = btn.getAttribute("data-speaker-linkedin");
      const speakerImage = btn.getAttribute("data-speaker-image");

      openSpeakerModal(speakerName, speakerRole, speakerCompany, speakerBio, speakerLinkedin, speakerImage);
    });
  });

  // Close modal
  closeModalBtn?.addEventListener("click", () => {
    speakerModal?.classList.add("hidden");
  });

  speakerModal?.addEventListener("click", (e) => {
    if (e.target === speakerModal) {
      speakerModal.classList.add("hidden");
    }
  });

  // Track filtering functionality
  const trackFilterBtns = document.querySelectorAll('.track-filter-btn');
  const sessionRows = document.querySelectorAll('.session-row');
  let selectedTrack = null;

  trackFilterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const track = e.target.closest('.track-filter-btn')?.getAttribute('data-track');
      if (!track) return;

      // Handle "ALL" button
      if (track === "ALL") {
        selectedTrack = null;
        trackFilterBtns.forEach(b => b.classList.remove('active'));
        sessionRows.forEach(row => {
          row.classList.remove('hidden');
          row.classList.add('fade-in');
        });
      } else if (selectedTrack === track) {
        // Toggle off: show all sessions
        selectedTrack = null;
        trackFilterBtns.forEach(b => b.classList.remove('active'));
        sessionRows.forEach(row => {
          row.classList.remove('hidden');
          row.classList.add('fade-in');
        });
      } else {
        // Show only this track
        selectedTrack = track;
        trackFilterBtns.forEach(b => {
          if (b.getAttribute('data-track') === track) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
        sessionRows.forEach(row => {
          const rowTrack = row.getAttribute('data-track');
          if (rowTrack === track) {
            row.classList.remove('hidden');
            row.classList.add('fade-in');
          } else {
            row.classList.add('hidden');
          }
        });
      }

      // Smooth scroll to table
      document.querySelector('table')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  .track-filter-btn.active {
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
    transform: scale(1.05);
  }

  .session-row.hidden {
    display: none;
  }

  .session-row.fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Blob shape styling from Speakers component */
  .blob-shape {
    border-radius: 30% 70% 70% 30%;
    animation: blob 8s ease-in-out infinite;
  }

  @keyframes blob {
    0%, 100% {
      border-radius: 30% 70% 70% 30%;
    }
    25% {
      border-radius: 40% 60% 60% 40%;
    }
    50% {
      border-radius: 50% 50% 50% 50%;
    }
    75% {
      border-radius: 60% 40% 40% 60%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      animation: none !important;
    }

    .blob-shape {
      animation: none !important;
    }
  }
</style>

