import { t } from "@lib/i18n";
import SessionModal from "./SessionModal.astro";
import { FEATURED_SPEAKERS } from "@config/speakers.config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description,
} = Astro.props;

const defaultTitle = t('en', 'schedule.title');
const defaultDescription = t('en', 'schedule.description');

const finalTitle = title || defaultTitle;
const finalDescription = description || defaultDescription;

// Helper function to get speaker data from FEATURED_SPEAKERS
const getSpeakerData = (speakerName: string) => {
  if (!speakerName || speakerName === "TBD" || speakerName === "Community" || speakerName === "Google DevFest Team") {
    return null;
  }

  // Handle multiple speakers (e.g., "Yvonne Pilon / James Lannigan")
  const primaryName = speakerName.split(" / ")[0].trim();
  return FEATURED_SPEAKERS.find(speaker =>
    speaker.name.toLowerCase() === primaryName.toLowerCase()
  );
};

// Google Brand Colors - Accent color styles for avatars
const accentStyles: Record<string, { blob: string; badge: string; ring: string }> = {
  blue: {
    blob: "bg-[#4285F4]",
    badge: "bg-[#4285F4]",
    ring: "group-hover:ring-[#4285F4]/40",
  },
  red: {
    blob: "bg-[#EA4335]",
    badge: "bg-[#EA4335]",
    ring: "group-hover:ring-[#EA4335]/40",
  },
  yellow: {
    blob: "bg-[#FBBC04]",
    badge: "bg-[#FBBC04]",
    ring: "group-hover:ring-[#FBBC04]/40",
  },
  green: {
    blob: "bg-[#34A853]",
    badge: "bg-[#34A853]",
    ring: "group-hover:ring-[#34A853]/40",
  },
};

const tracks = [
  { name: "ALL", color: "gray", icon: "sparkles", bgGradient: "from-gray-600 to-gray-700", textColor: "text-gray-600" },
  { name: "Google Cloud", color: "blue", icon: "cloud", bgGradient: "from-[#4285F4] to-[#1f2937]", textColor: "text-[#4285F4]" },
  { name: "Build with AI", color: "red", icon: "sparkles", bgGradient: "from-[#EA4335] to-[#1f2937]", textColor: "text-[#EA4335]" },
  { name: "Full Stack", color: "yellow", icon: "code", bgGradient: "from-[#FBBC04] to-[#1f2937]", textColor: "text-[#FBBC04]" },
  { name: "Entrepreneurship", color: "green", icon: "rocket", bgGradient: "from-[#34A853] to-[#1f2937]", textColor: "text-[#34A853]" },
  { name: "Cybersecurity", color: "blue", icon: "lock", bgGradient: "from-[#4285F4] to-[#1f2937]", textColor: "text-[#4285F4]" },
